#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "উপলব্ধ মেরামতসমূহ: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "অজানা ফরম্যাট %s। text, json, nagios, অথবা prometheus ব্যবহার করুন।"

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "তথ্য গোপন (রিড্যাকশন) সম্পন্ন করা যায়নি, তাই %s লেখা হয়নি।"

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "%s লেখা হয়েছে। শেয়ার করার আগে এটি পর্যালোচনা করুন; পাসওয়ার্ড, সিক্রেট, টোকেন এবং কমিউনিটি নামের পরের মানগুলো মাস্ক করা হয়েছে।"

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "অজানা মেরামত"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "--yes ছাড়া মেরামত করতে অস্বীকার করা হচ্ছে।"

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "একটি সমর্থিত উপসর্গ এবং টেক্সট বা JSON আউটপুট নির্বাচন করুন।"

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "গৃহীত সতর্কতা"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "ডিভাইসের প্রাপ্যতা"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "ডিভাইসের অনুমতি মূল্যায়ন করা যায়নি।"

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "কনফিগার করা PHP CLI Doctor পরীক্ষাগুলো চালাতে পারে না।"

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Doctor পরীক্ষাগুলো ব্যর্থ হয়েছে অথবা নির্ধারিত সময়সীমা অতিক্রম করেছে। Doctor লগ পর্যালোচনা করুন।"

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "গ্রাফ আপডেট হওয়া বন্ধ হয়ে গেছে"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "পোলিং ধীরগতির"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "ডিভাইসগুলো অনুপস্থিত বা অনুপলব্ধ"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Doctor সতর্কবার্তা অনুপস্থিত"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "poller শিডিউলার এবং সংশ্লিষ্ট poller লগ পরীক্ষা করুন, এরপর একটি নতুন সম্পন্ন হওয়া চক্র যাচাই করুন।"

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "তথ্য সংগ্রহ বন্ধ হয়ে থাকতে পারে।"

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "সংগৃহীত মান ডিস্কে নাও পৌঁছাতে পারে।"

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "আউটপুট কিউ এবং Boost ফ্লাশ ইতিহাস পরীক্ষা করুন; যাচাই করুন যে কিউ খালি হচ্ছে এবং RRD টাইমস্ট্যাম্প অগ্রসর হচ্ছে।"

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "স্টোরেজ সক্ষমতা, রানটাইম-ডিরেক্টরির অনুমতি এবং সর্বশেষ RRD আপডেট পরীক্ষা করুন; বিলম্বিত রাইটগুলো বিবেচনায় রাখুন।"

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "RRD স্টোরেজ তদন্ত করা প্রয়োজন।"

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "তথ্য সংগ্রহের কাজ নির্ধারিত সময়সীমা অতিক্রম করছে হতে পারে।"

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "কনকারেন্সি বাড়ানোর আগে চক্রের সময়কালকে পোলিং ব্যবধানের সাথে তুলনা করুন এবং ডিভাইস টাইমআউট পরীক্ষা করুন।"

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "সার্ভারের সীমা পরিবর্তনের আগে একটি ধীর চক্রের সময় ডাটাবেজ কাউন্টার তুলনা করুন এবং কোয়েরি প্ল্যান পরীক্ষা করুন।"

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "ধীর পোলিংয়ের পেছনে ডাটাবেজের চাপ ভূমিকা রাখছে হতে পারে।"

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "সংগ্রহের পূর্বশর্ত বা পৌঁছানোযোগ্যতা ব্যর্থ হচ্ছে হতে পারে।"

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Cacti ডায়াগনস্টিকস ব্যবহার করে সংশ্লিষ্ট ডিভাইসের অনুমতি, পৌঁছানোযোগ্যতা, ক্রেডেনশিয়াল এবং নির্ধারিত poller যাচাই করুন।"

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "নির্ধারিত পরীক্ষা বা মেইল ডেলিভারিতে মনোযোগ দেওয়া প্রয়োজন।"

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "শিডিউলিং এবং প্রাপকের সেটিংস যাচাই করুন, সংরক্ষিত ডেলিভারি প্রচেষ্টাগুলো পরীক্ষা করুন এবং একটি Cacti পরীক্ষামূলক ইমেইল পাঠান।"

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "সম্ভাব্য কারণগুলো যাচাই করা প্রয়োজন; মিল থাকা পরীক্ষাগুলো মূল কারণ নিশ্চিত করে না।"

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "উপলব্ধ পর্যবেক্ষণ থেকে কোনো কারণ নিশ্চিত করা যায়নি। নতুন ডায়াগনস্টিকস চালান এবং সরাসরি উপসর্গটি তদন্ত করুন।"

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "সার্ভার স্টার্টআপ এবং FLUSH STATUS-এর পর কমপক্ষে ২৪ ঘণ্টা। কাউন্টারগুলো ক্রমসঞ্চিত এবং এদের রিসেট ইতিহাস ভিন্ন হতে পারে; টিউনিংয়ের আগে একটি প্রতিনিধিত্বমূলক ওয়ার্কলোডের সময় প্রবণতা নিশ্চিত করুন।"

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "ক্রমসঞ্চিত টিউনিং পরামর্শ স্থগিত করা হয়েছে: বৈধ আপটাইম এবং স্টার্টআপ ও FLUSH STATUS-এর পর কমপক্ষে ২৪ ঘণ্টা নিশ্চিত করুন। অনুপস্থিত মেট্রিক বা অসামঞ্জস্যপূর্ণ নমুনা ডাটাবেজের অবস্থা নিশ্চিত করতে পারে না।"

#: doctor_functions.php
msgid "Database observation window"
msgstr "ডাটাবেজ পর্যবেক্ষণ সময়সীমা"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "সংযোগের মেট্রিক অনুপলব্ধ বা অবৈধ। SHOW GLOBAL STATUS এবং SHOW GLOBAL VARIABLES-এ অ্যাক্সেস পরীক্ষা করুন; অনুপস্থিত মেট্রিককে নিষ্ক্রিয় সার্ভার হিসেবে গণ্য করবেন না।"

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "বর্তমান সংযোগ: %.0f / %.0f (%s); নথিভুক্ত সর্বোচ্চ: %.0f (বর্তমান সীমার %s)।"

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "সংযোগ পুলিং এবং poller কনকারেন্সি পর্যালোচনা করুন। max_connections বাড়ানোর আগে ডাটাবেজ-হোস্টের অবশিষ্ট মেমোরি পরীক্ষা করুন; পূর্ববর্তী সর্বোচ্চ মান পুরনো কোনো সীমা নির্দেশ করতে পারে।"

#: doctor_functions.php
msgid "Connection capacity"
msgstr "সংযোগ সক্ষমতা"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "InnoDB বাফার পুল রিড"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "কোয়েরি প্ল্যান এবং ওয়ার্কিং সেট পর্যালোচনা করুন। ডাটাবেজ হোস্টে উপলব্ধ মেমোরি পরিমাপ করার পরেই কেবল innodb_buffer_pool_size বিবেচনা করুন; শুধুমাত্র ক্রমসঞ্চিত মিস অনুপাত মেমোরির চাপ প্রমাণ করে না।"

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "ডিস্কে অস্থায়ী টেবিল"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "মেমোরি সীমা পরিবর্তনের আগে কোয়েরি প্ল্যান, সর্টিং, গ্রুপিং এবং অস্থায়ী টেবিলের ডেটা টাইপ পর্যালোচনা করুন। কিছু টেবিলের জন্য ডিস্ক ব্যবহার করা বাধ্যতামূলক; MySQL এবং MariaDB সংস্করণের মধ্যে মেমোরি সীমা এবং হিসাব ভিন্ন হয়।"

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "সংযোগ থ্রেড তৈরি"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "সংযোগ পুনঃব্যবহার এবং thread_cache_size পর্যালোচনা করুন। টিউনিংয়ের আগে সার্ভারের থ্রেড-হ্যান্ডলিং মোড পরীক্ষা করুন; থ্রেড-পুল বাস্তবায়নগুলো প্রতি-সংযোগে-এক-থ্রেড সার্ভারের মতো আচরণ করে না।"

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "সার্ভার বাফার পরিবর্তনের আগে স্লো-কোয়েরি লগিং, long_query_time এবং কোয়েরি প্ল্যান পর্যালোচনা করুন। এই কাউন্টারটি কনফিগার করা স্লো-কোয়েরি থ্রেশহোল্ডের ওপর নির্ভর করে এবং একক স্টেটমেন্ট শনাক্ত করে না।"

#: doctor_functions.php
msgid "Slow statements"
msgstr "ধীর স্টেটমেন্ট"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "পর্যবেক্ষণ সময়সীমা পর্যাপ্ত না হওয়া পর্যন্ত ক্রমসঞ্চিত পরামর্শ স্থগিত করা হয়েছে।"

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "থ্রেড-ক্যাশ পরামর্শ মূল্যায়ন করা হয়নি: thread_handling অনুপলব্ধ অথবা এটি প্রতি-সংযোগে-এক-থ্রেড নয়। এর পরিবর্তে সক্রিয় থ্রেড-পুল বাস্তবায়ন পর্যালোচনা করুন।"

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "প্রয়োজনীয় কাউন্টার অনুপলব্ধ বা অবৈধ: %s, %s। সার্ভার-সংস্করণের সমর্থন এবং মনিটরিং অনুমতি পরীক্ষা করুন।"

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "পূর্ববর্তী নমুনার পর একটি কাউন্টার রিসেট হয়েছে; টিউনিংয়ের আগে আরেকটি প্রতিনিধিত্বমূলক ব্যবধান সংগ্রহ করুন।"

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "অপর্যাপ্ত কার্যক্রম: %.0f %s; এই পরামর্শের জন্য কমপক্ষে %dটি পর্যবেক্ষণ প্রয়োজন।"

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "কাউন্টারগুলো অসামঞ্জস্যপূর্ণ বা স্বাধীনভাবে রিসেট করা হয়েছিল। টিউনিংয়ের আগে একটি নতুন প্রতিনিধিত্বমূলক নমুনা সংগ্রহ করুন।"

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "ব্যবধানের নমুনাটি অত্যন্ত ছোট বা কাউন্টার রিসেট হয়েছে; টিউনিংয়ের আগে আরেকটি প্রতিনিধিত্বমূলক ব্যবধান সংগ্রহ করুন।"

#: doctor_functions.php
#, php-format
