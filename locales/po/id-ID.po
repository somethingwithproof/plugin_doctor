msgstr "Pemeriksaan Terjadwal"

#: setup.php
msgid "Run Checks on a Schedule"
msgstr "Jalankan Pemeriksaan Secara Terjadwal"

#: setup.php
msgid "Run every Doctor check in the background after the poller and record each check's status."
msgstr "Jalankan setiap pemeriksaan Doctor di latar belakang setelah poller dan catat status setiap pemeriksaan."

#: setup.php
msgid "Check Interval"
msgstr "Interval Pemeriksaan"

#: setup.php
msgid "How often the scheduled checks run."
msgstr "Seberapa sering pemeriksaan terjadwal dijalankan."

#: setup.php
msgid "Every 15 Minutes"
msgstr "Setiap 15 Menit"

#: setup.php
msgid "Every Hour"
msgstr "Setiap Jam"

#: setup.php
msgid "Every 6 Hours"
msgstr "Setiap 6 Jam"

#: setup.php
msgid "Every Day"
msgstr "Setiap Hari"

#: setup.php
msgid "Alert Email Addresses"
msgstr "Alamat Email Peringatan"

#: setup.php
msgid "Comma-separated addresses to email when a check starts or stops failing. Leave empty to only log changes to the Cacti log."
msgstr "Alamat email yang dipisahkan koma untuk dikirimi email saat pemeriksaan mulai atau berhenti gagal. Kosongkan untuk hanya mencatat perubahan ke log Cacti."

#: setup.php
msgid "Alert on Warnings"
msgstr "Beri Peringatan pada Status Peringatan"

#: setup.php
msgid "Also alert when a check moves into or out of a warning."
msgstr "Juga beri peringatan saat pemeriksaan masuk ke atau keluar dari status peringatan."

#: setup.php
msgid "Thresholds"
msgstr "Ambang Batas"

#: setup.php
msgid "Poller Run Time Warning (percent)"
msgstr "Peringatan Waktu Jalan Poller (persen)"

#: setup.php
msgid "Warn when the last main-poller run used this share of the polling interval. Runs that take the whole interval always fail."
msgstr "Beri peringatan saat eksekusi poller utama terakhir menggunakan porsi interval polling ini. Eksekusi yang menghabiskan seluruh interval selalu gagal."

#: setup.php
msgid "RRA Disk Free Warning (percent)"
msgstr "Peringatan Ruang Disk Kosong RRA (persen)"

#: setup.php
msgid "Warn when free space on the RRA file system drops below this percentage."
msgstr "Beri peringatan saat ruang kosong pada sistem berkas RRA turun di bawah persentase ini."

#: setup.php
msgid "Fail when free space on the RRA file system drops below this percentage."
msgstr "Nyatakan gagal saat ruang kosong pada sistem berkas RRA turun di bawah persentase ini."

#: setup.php
msgid "RRA Disk Free Failure (percent)"
msgstr "Kegagalan Ruang Disk Kosong RRA (persen)"

#: setup.php
msgid "Clock Drift Warning (seconds)"
msgstr "Peringatan Selisih Jam (detik)"

#: setup.php
msgid "Warn when the database and PHP clocks differ by more than this."
msgstr "Beri peringatan saat jam basis data dan PHP berbeda lebih dari nilai ini."

#: setup.php
msgid "Clock Drift Failure (seconds)"
msgstr "Kegagalan Selisih Jam (detik)"

#: setup.php
msgid "Fail when the database and PHP clocks differ by more than this."
msgstr "Nyatakan gagal saat jam basis data dan PHP berbeda lebih dari nilai ini."

#: setup.php
msgid "RRD Stale Intervals"
msgstr "Interval RRD Kedaluwarsa"

#: setup.php
msgid "Warn after this many collection intervals without a file update (1 to 100)."
msgstr "Beri peringatan setelah sejumlah interval pengumpulan ini tanpa pembaruan berkas (1 hingga 100)."

#: setup.php
msgid "Additional disk-write delay for external caching (0 to 86400). Boost adds its own allowance."
msgstr "Penundaan penulisan disk tambahan untuk caching eksternal (0 hingga 86400). Boost menambahkan toleransinya sendiri."

#: setup.php
msgid "Deferred RRD Write Allowance (seconds)"
msgstr "Toleransi Penulisan RRD Tertunda (detik)"

#: setup.php
msgid "Cacti Log Size Warning (MB)"
msgstr "Peringatan Ukuran Log Cacti (MB)"

#: setup.php
msgid "Warn when the Cacti log grows beyond this size, which usually means log rotation is not running."
msgstr "Beri peringatan saat log Cacti tumbuh melampaui ukuran ini, yang biasanya berarti rotasi log tidak berjalan."
