#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Perbaikan yang tersedia: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Format %s tidak dikenal. Gunakan text, json, nagios, atau prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Redaksi tidak dapat diselesaikan, sehingga %s tidak ditulis."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "Berhasil menulis %s. Tinjau sebelum dibagikan; nilai setelah password, secret, token, dan nama community disamarkan."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Perbaikan tidak dikenal"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Menolak melakukan perbaikan tanpa --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Pilih gejala yang didukung dan keluaran text atau JSON."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Peringatan yang diterima"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Ketersediaan perangkat"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Izin perangkat tidak dapat dievaluasi."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "PHP CLI yang dikonfigurasi tidak dapat menjalankan pemeriksaan Doctor."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Pemeriksaan Doctor gagal atau melebihi batas waktunya. Tinjau log Doctor."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Grafik berhenti diperbarui"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Polling lambat"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Perangkat hilang atau tidak tersedia"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Peringatan Doctor tidak ditemukan"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Periksa penjadwal poller dan log poller yang terdampak, lalu verifikasi siklus baru yang telah selesai."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "Pengumpulan data mungkin telah berhenti."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Nilai yang dikumpulkan mungkin tidak mencapai disk."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Periksa antrean keluaran dan riwayat flush Boost; pastikan antrean terkuras dan stempel waktu RRD maju."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Periksa kapasitas penyimpanan, izin direktori runtime, dan pembaruan RRD terakhir; perhitungkan penulisan yang tertunda."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "Penyimpanan RRD memerlukan investigasi."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Pekerjaan pengumpulan data mungkin melebihi batas waktunya."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Bandingkan durasi siklus dengan interval polling dan periksa timeout perangkat sebelum meningkatkan konkurensi."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Bandingkan penghitung basis data selama siklus lambat dan periksa rencana kueri sebelum mengubah batas server."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Tekanan basis data mungkin berkontribusi pada polling yang lambat."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Prasyarat pengumpulan data atau keterjangkauan mungkin mengalami kegagalan."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Verifikasi izin, keterjangkauan, kredensial perangkat yang terdampak, serta poller yang ditetapkan menggunakan diagnostik Cacti."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Pemeriksaan terjadwal atau pengiriman email memerlukan perhatian."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Verifikasi pengaturan penjadwalan dan penerima, periksa percobaan pengiriman yang tersimpan, lalu kirim email uji coba Cacti."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Kemungkinan penyebab memerlukan verifikasi; pemeriksaan yang cocok tidak menentukan akar penyebab."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Tidak ada penyebab yang dapat dipastikan dari pengamatan yang tersedia. Jalankan diagnostik baru dan selidiki gejalanya secara langsung."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Setidaknya 24 jam sejak server dinyalakan dan FLUSH STATUS. Penghitung bersifat kumulatif dan mungkin memiliki riwayat pengaturan ulang yang berbeda; konfirmasikan tren selama beban kerja yang representatif sebelum melakukan penyetelan."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "Saran penyetelan kumulatif ditunda: dapatkan waktu aktif yang valid dan setidaknya 24 jam sejak server dinyalakan dan FLUSH STATUS. Metrik yang hilang atau sampel yang tidak konsisten tidak dapat menentukan kesehatan basis data."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Jendela pengamatan basis data"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Metrik koneksi tidak tersedia atau tidak valid. Periksa akses ke SHOW GLOBAL STATUS dan SHOW GLOBAL VARIABLES; jangan anggap metrik yang hilang sebagai server yang menganggur."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Koneksi saat ini: %.0f / %.0f (%s); puncak tercatat: %.0f (%s dari batas saat ini)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Tinjau connection pooling dan konkurensi poller. Periksa ruang memori host basis data sebelum menaikkan max_connections; puncak historis mungkin mencerminkan batas sebelumnya."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Kapasitas koneksi"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Pembacaan buffer pool InnoDB"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Tinjau rencana kueri dan working set. Pertimbangkan innodb_buffer_pool_size hanya setelah mengukur memori yang tersedia di host basis data; rasio miss kumulatif saja tidak membuktikan tekanan memori."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Tabel sementara pada disk"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Tinjau rencana kueri, pengurutan, pengelompokan, dan tipe data tabel sementara sebelum mengubah batas memori. Sebagian tabel harus menggunakan disk; batas memori dan penghitungannya berbeda antara versi MySQL dan MariaDB."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Pembuatan thread koneksi"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Tinjau penggunaan ulang koneksi dan thread_cache_size. Periksa mode penanganan thread server sebelum menyetel; implementasi thread-pool tidak berperilaku seperti server one-thread-per-connection."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Tinjau pencatatan log kueri lambat, long_query_time, dan rencana kueri sebelum mengubah buffer server. Penghitung ini bergantung pada ambang batas kueri lambat yang dikonfigurasi dan tidak mengidentifikasi pernyataan individual."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Pernyataan lambat"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Saran kumulatif ditunda hingga jendela pengamatan mencukupi."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "Saran thread-cache tidak dinilai: thread_handling tidak tersedia atau bukan one-thread-per-connection. Sebagai gantinya, tinjau implementasi thread-pool yang aktif."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Penghitung yang diperlukan tidak ada atau tidak valid: %s, %s. Periksa dukungan versi server dan izin pemantauan."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "Sebuah penghitung telah diatur ulang sejak sampel sebelumnya; kumpulkan interval representatif lainnya sebelum melakukan penyetelan."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Aktivitas tidak mencukupi: %.0f %s; setidaknya %d pengamatan diperlukan untuk saran ini."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Penghitung tidak konsisten atau telah diatur ulang secara terpisah. Kumpulkan sampel representatif baru sebelum melakukan penyetelan."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "Sampel interval terlalu kecil atau penghitung telah diatur ulang; kumpulkan interval representatif lainnya sebelum melakukan penyetelan."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Interval %s / %s: %.0f / %.0f (%s); ambang batas investigasi: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Kumulatif %s / %s: %.0f / %.0f (%s); ambang batas investigasi: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Penghitung ini dapat melewatkan berkas sementara memory-mapped di MySQL; rasio yang rendah tidak menyingkirkan kemungkinan penggunaan disk."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "Saran redo-log ditunda hingga jendela pengamatan mencukupi dan Innodb_log_waits tersedia."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Innodb_log_waits kumulatif: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Selidiki ukuran transaksi, tekanan log-buffer, dan latensi penyimpanan. Periksa kembali laju di bawah beban sebelum mempertimbangkan innodb_log_buffer_size; jumlah historis ini bukan bukti adanya kemacetan saat ini."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Penantian log-buffer InnoDB"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "composer.json Cacti yang terpasang"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "persyaratan penginstal Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "Kompatibilitas PHP dengan Cacti yang terpasang"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Menjalankan PHP %s; Cacti yang terpasang %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Tidak dapat menentukan persyaratan PHP Cacti. Periksa composer.json Cacti yang terpasang atau dokumentasi rilis; Doctor tidak mengasumsikan kompatibilitas."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s dan < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Memerlukan %s (%s). PHP yang berjalan memenuhi persyaratan tersebut."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Memerlukan %s (%s). PHP yang berjalan tidak memenuhi persyaratan tersebut."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Terdeteksi %s; Doctor memerlukan Cacti 1.2.20 atau yang lebih baru."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Versi Cacti yang didukung"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Dukungan keamanan upstream PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Ini memeriksa cabang rilis PHP, bukan apakah rilis patch ini mutakhir atau apakah vendor OS Anda melakukan backport perbaikan. Kompatibilitas Cacti diperiksa secara terpisah."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Menjalankan PHP %s; status dukungan keamanan upstream tidak diketahui atau ini adalah prarilis. Periksa https://www.php.net/supported-versions.php dan perbarui data dukungan Doctor."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Menjalankan PHP %s; PHP %s menerima perbaikan keamanan upstream hingga %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Menjalankan PHP %s; PHP %s tidak lagi menerima perbaikan keamanan upstream; dukungan berakhir pada %s. Tingkatkan ke cabang PHP yang didukung dan kompatibel dengan instalasi Cacti Anda, atau konfirmasikan pemeliharaan keamanan dengan vendor OS Anda."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Ekstensi PHP CLI saat ini yang diperlukan"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Ekstensi PHP web yang diperlukan"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Tidak ada: %s. Pasang ekstensi tersebut melalui pengelola paket sistem operasi."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Semua ekstensi PHP yang diperlukan oleh penginstal Cacti telah dimuat dalam konteks PHP ini."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "Doctor tidak mengeksekusi biner yang dikonfigurasi saat berjalan sebagai root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "Nama berkas %s tidak sesuai dengan yang diharapkan untuk %s, sehingga Doctor tidak mengeksekusinya."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "Doctor berjalan sebagai root, sehingga pemeriksaan izin menggambarkan akun root alih-alih server web atau akun poller, biner yang dikonfigurasi tidak dieksekusi, dan perbaikan ditolak. Jalankan Doctor sebagai pengguna poller Cacti."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Hak istimewa Doctor"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "Doctor berjalan tanpa hak istimewa root."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Ekstensi PHP CLI yang diperlukan"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Berkas eksekusi PHP CLI yang dikonfigurasi tidak tersedia, sehingga ekstensinya tidak dapat diperiksa."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "shell_exec() dinonaktifkan, sehingga Doctor tidak dapat membandingkan ekstensi PHP CLI dengan persyaratan Cacti."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "Berkas eksekusi PHP CLI yang dikonfigurasi tidak mengembalikan daftar ekstensi yang valid."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "Tidak ada di PHP CLI: %s. Konfigurasi PHP web dan CLI terpisah di banyak sistem."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "PHP CLI yang dikonfigurasi memiliki semua ekstensi yang diperlukan oleh Cacti."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "Dukungan GD TrueType"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Fitur PHP yang direkomendasikan"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Tidak tersedia: %s. Cacti dapat berjalan tanpa fitur ini, tetapi fungsionalitas terkait mungkin terbatas."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "Fitur opsional gettext, SNMP, dan GD TrueType tersedia."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "memory_limit adalah %s (disarankan %dM atau lebih)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "max_execution_time adalah %d detik (disarankan 60 atau lebih)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "date.timezone belum diatur"

#: doctor_functions.php
msgid "unset"
msgstr "belum diatur"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Nilai saat ini: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "Konfigurasi runtime PHP"

#: doctor_functions.php
msgid "Database connection"
msgstr "Koneksi basis data"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
msgstr "Kueri gagal: %s"

#: doctor_functions.php
msgid "A read-only query completed successfully."
msgstr "Kueri baca-saja selesai dengan sukses."

#: doctor_functions.php
msgid "The database returned an unexpected result."
msgstr "Basis data mengembalikan hasil yang tidak diharapkan."

#: doctor_functions.php
#, php-format
msgid "Doctor could not determine the database server version from %s."
msgstr "Doctor tidak dapat menentukan versi server basis data dari %s."

#: doctor_functions.php
msgid "Supported database server"
msgstr "Server basis data yang didukung"

#: doctor_functions.php
#, php-format
msgid "%s %s detected; this Cacti branch recommends %s %s or newer."
msgstr "%s %s terdeteksi; cabang Cacti ini merekomendasikan %s %s atau yang lebih baru."

#: doctor_functions.php
#, php-format
msgid "Database character set is %s and collation is %s. Cacti requires utf8mb4."
msgstr "Set karakter basis data adalah %s dan kolasinya adalah %s. Cacti memerlukan utf8mb4."

#: doctor_functions.php
msgid "unknown"
msgstr "tidak diketahui"

#: doctor_functions.php
msgid "Database character set"
msgstr "Set karakter basis data"

#: doctor_functions.php
msgid "Database timezone support"
msgstr "Dukungan zona waktu basis data"

#: doctor_functions.php
msgid "The Cacti database account cannot read mysql.time_zone_name. Grant SELECT access and populate the database timezone tables."
msgstr "Akun basis data Cacti tidak dapat membaca mysql.time_zone_name. Berikan akses SELECT dan isi tabel zona waktu basis data."

#: doctor_functions.php
#, php-format
msgid "The database timezone table is accessible and contains %d entries."
msgstr "Tabel zona waktu basis data dapat diakses dan berisi %d entri."

#: doctor_functions.php
msgid "The database timezone table is accessible but empty. Populate the system timezone tables."
msgstr "Tabel zona waktu basis data dapat diakses tetapi kosong. Isi tabel zona waktu sistem."

#: doctor_functions.php
msgid "Core tables used by Cacti are present."
msgstr "Tabel inti yang digunakan oleh Cacti tersedia."

#: doctor_functions.php
#, php-format
msgid "Missing core tables: %s. Restore or upgrade the database before attempting other repairs."
msgstr "Tabel inti yang hilang: %s. Pulihkan atau tingkatkan basis data sebelum mencoba perbaikan lainnya."

#: doctor_functions.php
msgid "Core database tables"
msgstr "Tabel inti basis data"

#: doctor_functions.php
#, php-format
msgid "%s is missing (%s)"
msgstr "%s tidak ada (%s)"

#: doctor_functions.php
#, php-format
msgid "%s is not writable (%s)"
msgstr "%s tidak dapat ditulisi (%s)"

#: doctor_functions.php
msgid "Runtime directories"
msgstr "Direktori runtime"

#: doctor_functions.php
msgid "The cache, log, and RRA directories exist and are writable."
msgstr "Direktori cache, log, dan RRA ada dan dapat ditulisi."

#: doctor_functions.php
msgid "Cacti configuration file"
msgstr "Berkas konfigurasi Cacti"

#: doctor_functions.php
msgid "include/config.php is missing or unreadable."
msgstr "include/config.php tidak ada atau tidak dapat dibaca."

#: doctor_functions.php
msgid "include/config.php is readable. POSIX mode-bit checks do not apply on Windows."
msgstr "include/config.php dapat dibaca. Pemeriksaan mode-bit POSIX tidak berlaku di Windows."

#: doctor_functions.php
msgid "include/config.php is writable by other users. Remove world-write permission because this file contains database credentials."
msgstr "include/config.php dapat ditulisi oleh pengguna lain. Hapus izin tulis publik karena berkas ini berisi kredensial basis data."

#: doctor_functions.php
msgid "include/config.php is group-writable. Confirm that every member of the owning group is trusted."
msgstr "include/config.php dapat ditulisi oleh grup. Pastikan setiap anggota grup pemilik dapat dipercaya."

#: doctor_functions.php
msgid "include/config.php is readable by all local users and contains database credentials. Restrict it to the owner and the web server group."
msgstr "include/config.php dapat dibaca oleh semua pengguna lokal dan berisi kredensial basis data. Batasi akses hanya untuk pemilik dan grup server web."

#: doctor_functions.php
msgid "include/config.php is readable and is not world-readable, group-writable, or world-writable."
msgstr "include/config.php dapat dibaca dan tidak dapat dibaca publik, ditulisi grup, atau ditulisi publik."

#: doctor_functions.php
msgid "Cacti log file"
msgstr "Berkas log Cacti"

#: doctor_functions.php
msgid "The log file does not exist. Its parent directory is not writable."
