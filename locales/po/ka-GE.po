#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "ხელმისაწვდომი შეკეთებები: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "უცნობი ფორმატი %s. გამოიყენეთ text, json, nagios ან prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "სენსიტიური მონაცემების დაფარვა ვერ დასრულდა, ამიტომ %s არ ჩაიწერა."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "ჩაიწერა %s. გაზიარებამდე გადახედეთ მას; პაროლის, საიდუმლოს, ტოკენისა და community სახელების შემდეგი მნიშვნელობები შენიღბულია."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "უცნობი შეკეთება"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "შეკეთებაზე უარი ითქვა --yes პარამეტრის გარეშე."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "აირჩიეთ მხარდაჭერილი სიმპტომი და ტექსტური ან JSON გამომავალი."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "მიღებული გაფრთხილება"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "მოწყობილობების ხელმისაწვდომობა"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "მოწყობილობის უფლებების შეფასება ვერ მოხერხდა."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "კონფიგურირებულ PHP CLI-ს არ შეუძლია Doctor-ის შემოწმებების გაშვება."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Doctor-ის შემოწმებები ვერ შესრულდა ან დროის ლიმიტს გადააჭარბა. შეამოწმეთ Doctor-ის ჟურნალი."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "გრაფიკების განახლება შეჩერდა"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "გამოკითხვა ნელა მიმდინარეობს"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "მოწყობილობები აკლია ან მიუწვდომელია"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Doctor-ის შეტყობინებები არ მოდის"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "შეამოწმეთ პოლერის დამგეგმავი და შესაბამისი პოლერის ჟურნალი, შემდეგ კი დაადასტურეთ ახალი დასრულებული ციკლი."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "მონაცემთა შეგროვება შესაძლოა შეჩერდა."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "შეგროვებული მნიშვნელობები შესაძლოა დისკამდე ვერ აღწევს."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "შეამოწმეთ გამომავალი რიგი და Boost-ის ჩაწერის ისტორია; დაადასტურეთ, რომ რიგი იცლება და RRD დროის ნიშნულები წინ მიიწევს."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "შეამოწმეთ მეხსიერების ტევადობა, სამუშაო დირექტორიების უფლებები და ბოლო RRD განახლება; გაითვალისწინეთ გადავადებული ჩაწერები."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "RRD საცავს გამოკვლევა სჭირდება."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "შეგროვების სამუშაო შესაძლოა თავის დროის ბიუჯეტს აჭარბებს."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "პარალელურობის გაზრდამდე შეადარეთ ციკლის ხანგრძლივობა გამოკითხვის ინტერვალს და შეამოწმეთ მოწყობილობების მოლოდინის დროის ამოწურვები."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "სერვერის ლიმიტების შეცვლამდე შეადარეთ მონაცემთა ბაზის მთვლელები ნელი ციკლის დროს და შეამოწმეთ მოთხოვნის გეგმები."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "მონაცემთა ბაზის დატვირთვა შესაძლოა ნელ გამოკითხვას უწყობს ხელს."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "შეგროვების წინაპირობები ან ქსელური ხელმისაწვდომობა შესაძლოა ირღვევა."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Cacti-ის დიაგნოსტიკის გამოყენებით შეამოწმეთ დაზიანებული მოწყობილობის უფლებები, ხელმისაწვდომობა, მონაცემები და მინიჭებული პოლერი."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "დაგეგმილ შემოწმებებს ან ფოსტის მიწოდებას ყურადღება სჭირდება."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "შეამოწმეთ დაგეგმვისა და მიმღების პარამეტრები, დაათვალიერეთ შენახული მიწოდების მცდელობები და გაგზავნეთ Cacti-ის სატესტო წერილი."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "შესაძლო მიზეზები გადამოწმებას საჭიროებს; დამთხვეული შემოწმებები არ ადგენს პირველმიზეზს."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "ხელმისაწვდომი დაკვირვებებით მიზეზი არ დგინდება. გაუშვით ახალი დიაგნოსტიკა და უშუალოდ გამოიკვლიეთ სიმპტომი."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "სერვერის გაშვებიდან და FLUSH STATUS-დან სულ მცირე 24 საათი გავიდა. მთვლელები კუმულაციურია და შესაძლოა განსხვავებული განულების ისტორია ჰქონდეთ; გამართვამდე დაადასტურეთ ტენდენციები ტიპური დატვირთვის პირობებში."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "კუმულაციური გამართვის რჩევები გადადებულია: საჭიროა ვალიდური მუშაობის დრო და სულ მცირე 24 საათი გაშვებიდან და FLUSH STATUS-დან. გამოტოვებული მეტრიკები ან არათანმიმდევრული შერჩევა მონაცემთა ბაზის მდგომარეობას ვერ ადგენს."

#: doctor_functions.php
msgid "Database observation window"
msgstr "მონაცემთა ბაზის დაკვირვების ფანჯარა"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "კავშირის მეტრიკები მიუწვდომელია ან არავალიდურია. შეამოწმეთ წვდომა SHOW GLOBAL STATUS და SHOW GLOBAL VARIABLES ბრძანებებზე; არ ჩათვალოთ გამოტოვებული მეტრიკები უმოქმედო სერვერად."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "მიმდინარე კავშირები: %.0f / %.0f (%s); დაფიქსირებული პიკი: %.0f (მიმდინარე ლიმიტის %s)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "გადახედეთ კავშირების პულსა და პოლერის პარალელურობას. max_connections-ის გაზრდამდე შეამოწმეთ მონაცემთა ბაზის ჰოსტის მეხსიერების მარაგი; ისტორიული პიკი შესაძლოა ძველ ლიმიტს ასახავდეს."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "კავშირების ტევადობა"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "InnoDB ბუფერის პულის წაკითხვები"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "გადახედეთ მოთხოვნის გეგმებსა და სამუშაო ნაკრებს. innodb_buffer_pool_size განიხილეთ მხოლოდ მონაცემთა ბაზის ჰოსტზე ხელმისაწვდომი მეხსიერების გაზომვის შემდეგ; მხოლოდ კუმულაციური აცდენის კოეფიციენტი მეხსიერების დეფიციტს არ ამტკიცებს."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "დისკზე განთავსებული დროებითი ცხრილები"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "მეხსიერების ლიმიტების შეცვლამდე გადახედეთ მოთხოვნის გეგმებს, დახარისხებას, დაჯგუფებასა და დროებითი ცხრილების მონაცემთა ტიპებს. ზოგიერთ ცხრილს დისკის გამოყენება უწევს; მეხსიერების ლიმიტები და აღრიცხვა განსხვავდება MySQL-ისა და MariaDB-ის ვერსიებს შორის."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "კავშირის ნაკადების შექმნა"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "გადახედეთ კავშირების ხელახალ გამოყენებასა და thread_cache_size პარამეტრს. გამართვამდე შეამოწმეთ სერვერის ნაკადების მართვის რეჟიმი; ნაკადების პულის იმპლემენტაციები არ მუშაობს one-thread-per-connection სერვერების მსგავსად."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "სერვერის ბუფერების შეცვლამდე გადახედეთ ნელი მოთხოვნების ჟურნალირებას, long_query_time პარამეტრსა და მოთხოვნის გეგმებს. ეს მთვლელი დამოკიდებულია ნელი მოთხოვნის კონფიგურირებულ ზღვარზე და არ ახდენს ცალკეული ოპერატორების იდენტიფიცირებას."

#: doctor_functions.php
msgid "Slow statements"
msgstr "ნელი მოთხოვნები"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "კუმულაციური რჩევები გადადებულია, სანამ დაკვირვების ფანჯარა საკმარისი არ გახდება."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "ნაკადების ქეშის რჩევა არ შეფასდა: thread_handling მიუწვდომელია ან არ არის one-thread-per-connection. ამის ნაცვლად გადახედეთ ნაკადების პულის აქტიურ იმპლემენტაციას."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "საჭირო მთვლელები აკლია ან არავალიდურია: %s, %s. შეამოწმეთ სერვერის ვერსიის მხარდაჭერა და მონიტორინგის უფლებები."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "წინა შერჩევის შემდეგ მთვლელი განულდა; გამართვამდე შეაგროვეთ სხვა ტიპური ინტერვალი."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "არასაკმარისი აქტივობა: %.0f %s; ამ რეკომენდაციისთვის საჭიროა სულ მცირე %d დაკვირვება."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "მთვლელები არათანმიმდევრულია ან დამოუკიდებლად განულდა. გამართვამდე შეაგროვეთ ახალი ტიპური შერჩევა."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "ინტერვალის შერჩევა ძალიან მცირეა ან მთვლელები განულდა; გამართვამდე შეაგროვეთ სხვა ტიპური ინტერვალი."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "ინტერვალი %s / %s: %.0f / %.0f (%s); გამოკვლევის ზღვარი: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "კუმულაციური %s / %s: %.0f / %.0f (%s); გამოკვლევის ზღვარი: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "ეს მთვლელი MySQL-ზე შესაძლოა გამოტოვებდეს მეხსიერებაში ასახულ დროებით ფაილებს; დაბალი თანაფარდობა დისკის გამოყენებას არ გამორიცხავს."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
