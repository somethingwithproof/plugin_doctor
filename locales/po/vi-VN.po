#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Các bản sửa chữa khả dụng: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Định dạng không xác định %s. Hãy sử dụng text, json, nagios hoặc prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Không thể hoàn tất quá trình che dữ liệu nhạy cảm, vì vậy %s chưa được ghi."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "Đã ghi %s. Hãy kiểm tra lại trước khi chia sẻ; các giá trị sau tên password, secret, token và community đã được che."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Bản sửa chữa không xác định"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Từ chối sửa chữa khi không có --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Chọn một triệu chứng được hỗ trợ và đầu ra dạng text hoặc JSON."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Cảnh báo đã chấp nhận"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Tính khả dụng của thiết bị"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Không thể đánh giá quyền của thiết bị."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "PHP CLI đã cấu hình không thể chạy các kiểm tra của Doctor."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Các kiểm tra của Doctor đã thất bại hoặc vượt quá giới hạn thời gian. Hãy xem nhật ký Doctor."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Biểu đồ ngừng cập nhật"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Quá trình thu thập dữ liệu bị chậm"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Thiết bị bị thiếu hoặc không khả dụng"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Thiếu cảnh báo Doctor"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Kiểm tra bộ lập lịch poller và nhật ký của poller bị ảnh hưởng, sau đó xác minh một chu kỳ mới đã hoàn tất."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "Quá trình thu thập có thể đã dừng."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Các giá trị đã thu thập có thể chưa được ghi xuống đĩa."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Kiểm tra hàng đợi đầu ra và lịch sử xả dữ liệu của Boost; xác minh rằng hàng đợi được giải phóng và dấu thời gian RRD tăng lên."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Kiểm tra dung lượng lưu trữ, quyền thư mục thời gian chạy và lần cập nhật RRD cuối cùng; tính đến các thao tác ghi bị hoãn."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "Cần điều tra bộ nhớ lưu trữ RRD."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Tác vụ thu thập có thể đang vượt quá ngân sách thời gian."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "So sánh thời lượng chu kỳ với khoảng thời gian thăm dò và kiểm tra thời gian chờ của thiết bị trước khi tăng mức độ đồng thời."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "So sánh các bộ đếm cơ sở dữ liệu trong một chu kỳ chậm và kiểm tra kế hoạch truy vấn trước khi thay đổi giới hạn máy chủ."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Áp lực cơ sở dữ liệu có thể đang góp phần làm chậm quá trình thăm dò."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Các điều kiện tiên quyết để thu thập hoặc khả năng kết nối tới đích có thể đang gặp lỗi."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Xác minh quyền, khả năng kết nối, thông tin xác thực và poller được gán của thiết bị bị ảnh hưởng bằng công cụ chẩn đoán Cacti."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Cần chú ý các kiểm tra theo lịch trình hoặc việc gửi thư."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Xác minh cài đặt lập lịch và người nhận, kiểm tra các lần thử gửi được lưu lại và gửi một email thử nghiệm của Cacti."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Các nguyên nhân có thể xảy ra cần được xác minh; các kiểm tra khớp không xác lập nguyên nhân gốc rễ."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Không có nguyên nhân nào được xác lập từ các quan sát hiện có. Hãy chạy chẩn đoán mới và điều tra trực tiếp triệu chứng."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Ít nhất 24 giờ kể từ khi khởi động máy chủ và FLUSH STATUS. Các bộ đếm là tích lũy và có thể có lịch sử đặt lại khác nhau; hãy xác nhận xu hướng trong khối lượng công việc đại diện trước khi tinh chỉnh."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "Khuyến nghị tinh chỉnh tích lũy bị hoãn lại: cần có thời gian hoạt động hợp lệ và ít nhất 24 giờ kể từ khi khởi động cũng như FLUSH STATUS. Thiếu số liệu hoặc mẫu không nhất quán không thể xác lập tình trạng cơ sở dữ liệu."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Cửa sổ quan sát cơ sở dữ liệu"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Các số liệu kết nối không khả dụng hoặc không hợp lệ. Kiểm tra quyền truy cập SHOW GLOBAL STATUS và SHOW GLOBAL VARIABLES; không coi việc thiếu số liệu là máy chủ đang nhàn rỗi."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Kết nối hiện tại: %.0f / %.0f (%s); đỉnh đã ghi nhận: %.0f (%s của giới hạn hiện tại)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Xem xét việc gộp kết nối và mức độ đồng thời của poller. Kiểm tra khoảng dự phòng bộ nhớ của máy chủ cơ sở dữ liệu trước khi tăng max_connections; mức đỉnh lịch sử có thể phản ánh giới hạn cũ hơn."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Dung lượng kết nối"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Lượt đọc vùng đệm InnoDB"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Xem xét kế hoạch truy vấn và tập dữ liệu làm việc. Chỉ cân nhắc innodb_buffer_pool_size sau khi đo bộ nhớ khả dụng trên máy chủ cơ sở dữ liệu; chỉ riêng tỷ lệ trượt tích lũy không chứng minh được áp lực bộ nhớ."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Bảng tạm trên đĩa"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Xem xét kế hoạch truy vấn, sắp xếp, nhóm và kiểu dữ liệu của bảng tạm trước khi thay đổi giới hạn bộ nhớ. Một số bảng bắt buộc phải dùng đĩa; giới hạn bộ nhớ và cách thống kê khác nhau giữa các phiên bản MySQL và MariaDB."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Tạo luồng kết nối"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Xem xét việc tái sử dụng kết nối và thread_cache_size. Kiểm tra chế độ xử lý luồng của máy chủ trước khi tinh chỉnh; các triển khai nhóm luồng không hoạt động giống máy chủ một luồng trên mỗi kết nối."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Xem xét nhật ký truy vấn chậm, long_query_time và kế hoạch truy vấn trước khi thay đổi bộ đệm máy chủ. Bộ đếm này phụ thuộc vào ngưỡng truy vấn chậm đã cấu hình và không xác định từng câu lệnh riêng lẻ."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Câu lệnh chậm"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Khuyến nghị tích lũy được hoãn cho đến khi cửa sổ quan sát đủ dài."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "Khuyến nghị bộ nhớ đệm luồng không được đánh giá: thread_handling không khả dụng hoặc không ở chế độ one-thread-per-connection. Hãy xem xét triển khai nhóm luồng đang hoạt động thay thế."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Các bộ đếm bắt buộc bị thiếu hoặc không hợp lệ: %s, %s. Kiểm tra hỗ trợ phiên bản máy chủ và quyền giám sát."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "Một bộ đếm đã đặt lại kể từ mẫu trước đó; hãy thu thập một khoảng thời gian đại diện khác trước khi tinh chỉnh."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Hoạt động chưa đủ: %.0f %s; cần ít nhất %d quan sát cho khuyến nghị này."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Các bộ đếm không nhất quán hoặc đã được đặt lại độc lập. Hãy thu thập một mẫu đại diện mới trước khi tinh chỉnh."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "Mẫu khoảng thời gian quá nhỏ hoặc các bộ đếm đã đặt lại; hãy thu thập một khoảng thời gian đại diện khác trước khi tinh chỉnh."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Khoảng %s / %s: %.0f / %.0f (%s); ngưỡng điều tra: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Tích lũy %s / %s: %.0f / %.0f (%s); ngưỡng điều tra: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Bộ đếm này có thể bỏ sót các tệp tạm ánh xạ bộ nhớ trên MySQL; tỷ lệ thấp không loại trừ việc sử dụng đĩa."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "Khuyến nghị nhật ký redo được hoãn cho đến khi cửa sổ quan sát đủ dài và Innodb_log_waits khả dụng."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Innodb_log_waits tích lũy: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Điều tra kích thước giao dịch, áp lực bộ đệm nhật ký và độ trễ lưu trữ. Kiểm tra lại tốc độ khi có tải trước khi cân nhắc innodb_log_buffer_size; số đếm lịch sử này không phải là bằng chứng về tình trạng tắc nghẽn hiện tại."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Lượt chờ bộ đệm nhật ký InnoDB"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "tệp composer.json của Cacti đã cài đặt"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "yêu cầu trình cài đặt Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "Khả năng tương thích của PHP với Cacti đã cài đặt"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Đang chạy PHP %s; đã cài đặt Cacti %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Không thể xác định yêu cầu PHP của Cacti. Kiểm tra tệp composer.json của Cacti đã cài đặt hoặc tài liệu phát hành; Doctor không giả định tính tương thích."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s và < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Yêu cầu %s (%s). PHP đang chạy đáp ứng yêu cầu đó."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Yêu cầu %s (%s). PHP đang chạy không đáp ứng yêu cầu đó."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Đã phát hiện %s; Doctor yêu cầu Cacti 1.2.20 trở lên."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Phiên bản Cacti được hỗ trợ"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Hỗ trợ bảo mật thượng nguồn cho PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Mục này kiểm tra nhánh phát hành PHP, không kiểm tra bản vá hiện tại đã mới nhất hay nhà cung cấp hệ điều hành có chuyển ngược bản sửa lỗi hay không. Khả năng tương thích với Cacti được kiểm tra riêng."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Đang chạy PHP %s; không rõ trạng thái hỗ trợ bảo mật thượng nguồn hoặc đây là bản phát hành trước. Kiểm tra https://www.php.net/supported-versions.php và cập nhật dữ liệu hỗ trợ của Doctor."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Đang chạy PHP %s; PHP %s nhận các bản sửa lỗi bảo mật thượng nguồn đến hết %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Đang chạy PHP %s; PHP %s không còn nhận các bản sửa lỗi bảo mật thượng nguồn; hỗ trợ đã kết thúc vào %s. Hãy nâng cấp lên nhánh PHP được hỗ trợ tương thích với bản cài đặt Cacti của bạn, hoặc xác nhận việc bảo trì bảo mật với nhà cung cấp hệ điều hành."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Các phần mở rộng PHP CLI hiện tại bắt buộc"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Các phần mở rộng PHP web bắt buộc"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Thiếu: %s. Hãy cài đặt chúng qua trình quản lý gói của hệ điều hành."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Tất cả phần mở rộng PHP do trình cài đặt Cacti yêu cầu đều đã được nạp trong ngữ cảnh PHP này."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "Doctor không thực thi các tệp nhị phân đã cấu hình khi đang chạy với quyền root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "Tên tệp %s không đúng như mong đợi cho %s, nên Doctor đã không thực thi tệp đó."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "Doctor đang chạy với quyền root, nên các kiểm tra quyền phản ánh tài khoản root thay vì tài khoản máy chủ web hoặc poller, các tệp nhị phân đã cấu hình không được thực thi và các thao tác sửa chữa bị từ chối. Hãy chạy Doctor với tư cách người dùng poller của Cacti."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Quyền của Doctor"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "Doctor đang chạy không có quyền root."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Các phần mở rộng PHP CLI bắt buộc"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Tệp thực thi PHP CLI đã cấu hình không khả dụng, nên không thể kiểm tra các phần mở rộng của nó."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "shell_exec() đã bị vô hiệu hóa, nên Doctor không thể so sánh các phần mở rộng PHP CLI với yêu cầu của Cacti."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
