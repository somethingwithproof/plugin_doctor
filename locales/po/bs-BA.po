msgid "Doctor schedule is already running or the database lock is unavailable."
msgstr "Raspored dodatka Doctor već radi ili zaključavanje baze podataka nije dostupno."

#: doctor_web.php
msgid "The finding could not be acknowledged. Run Doctor again, then acknowledge the current result."
msgstr "Nalaz nije mogao biti potvrđen. Ponovo pokrenite Doctor, a zatim potvrdite trenutni rezultat."

#: doctor_web.php
msgid "The warning exception could not be saved. Use a fresh assessed warning, an owner, a reason and an expiry within 90 days."
msgstr "Izuzetak upozorenja nije mogao biti sačuvan. Koristite svježe ocijenjeno upozorenje, vlasnika, razlog i rok isteka unutar 90 dana."

#: doctor_web.php
msgid "Confirm repair"
msgstr "Potvrdi popravku"

#: doctor_web.php
msgid "Approval expires after five minutes and is invalidated by a changed filesystem. The acting account must be able to create directories or change owner permissions."
msgstr "Odobrenje ističe nakon pet minuta i postaje nevažeće ako se datotečni sistem promijeni. Nalog koji vrši radnju mora moći kreirati direktorije ili mijenjati vlasničke dozvole."

#: doctor_web.php
msgid "Repair prerequisites are not met. No changes will be made."
msgstr "Preduslovi za popravku nisu ispunjeni. Nikakve izmjene neće biti napravljene."

#: doctor_web.php
msgid "Cancel"
msgstr "Odustani"

