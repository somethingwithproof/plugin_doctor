#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Dostupne popravke: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Nepoznat format %s. Koristite text, json, nagios ili prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Redigovanje nije moglo biti završeno, pa datoteka %s nije zapisana."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "Zapisano u %s. Pregledajte datoteku prije dijeljenja; vrijednosti iza naziva password, secret, token i community su maskirane."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Nepoznata popravka"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Odbijena popravka bez zastavice --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Izaberite podržani simptom i tekstualni ili JSON izlaz."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Prihvaćeno upozorenje"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Dostupnost uređaja"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Dozvole za uređaje nisu mogle biti ocijenjene."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "Konfigurisani PHP CLI ne može pokrenuti provjere dodatka Doctor."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Provjere dodatka Doctor nisu uspjele ili su prekoračile vremensko ograničenje. Pregledajte Doctor zapisnik."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Grafikoni se više ne ažuriraju"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Prikupljanje podataka je sporo"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Uređaji nedostaju ili su nedostupni"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Nedostaju obavijesti dodatka Doctor"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Provjerite planer pollera i zapisnik zahvaćenog pollera, a zatim potvrdite novi završeni ciklus."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "Prikupljanje podataka je možda zaustavljeno."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Prikupljene vrijednosti možda ne stižu na disk."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Pregledajte izlazni red i historiju pražnjenja Boosta; provjerite da se red prazni i da vremenske oznake RRD datoteka napreduju."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Provjerite kapacitet diska, dozvole direktorija izvođenja i posljednje RRD ažuriranje; uzmite u obzir odgođene zapise."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "RRD skladište zahtijeva ispitivanje."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Posao prikupljanja možda prekoračuje dodijeljeno vrijeme."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Uporedite trajanje ciklusa sa intervalom prikupljanja i pregledajte isteke vremena uređaja prije povećanja paralelizma."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Uporedite brojače baze podataka tokom sporog ciklusa i pregledajte planove upita prije izmjene limita servera."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Opterećenje baze podataka možda doprinosi sporom prikupljanju."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Preduslovi za prikupljanje ili mrežna dostupnost možda ne uspijevaju."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Provjerite dozvole zahvaćenog uređaja, dostupnost, akreditive i dodijeljeni poller koristeći Cacti dijagnostiku."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Zakazane provjere ili isporuka pošte zahtijevaju pažnju."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Provjerite postavke zakazivanja i primalaca, pregledajte zadržane pokušaje isporuke i pošaljite Cacti probni email."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Mogući uzroci zahtijevaju verifikaciju; podudarne provjere ne utvrđuju osnovni uzrok."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Dostupna posmatranja ne utvrđuju uzrok. Pokrenite novu dijagnostiku i direktno ispitajte simptom."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Najmanje 24 sata od pokretanja servera i naredbe FLUSH STATUS. Brojači su kumulativni i mogu imati različite historije resetovanja; potvrdite trendove tokom reprezentativnog opterećenja prije podešavanja."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "Kumulativni savjeti za podešavanje su odgođeni: obezbijedite važeće vrijeme rada i najmanje 24 sata od pokretanja servera i naredbe FLUSH STATUS. Nedostajuće metrike ili nedosljedan uzorak ne mogu utvrditi zdravlje baze podataka."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Prozor posmatranja baze podataka"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Metrike konekcija su nedostupne ili neispravne. Provjerite pristup naredbama SHOW GLOBAL STATUS i SHOW GLOBAL VARIABLES; ne smatrajte nedostajuće metrike neaktivnim serverom."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Trenutne konekcije: %.0f / %.0f (%s); zabilježeni maksimum: %.0f (%s trenutnog limita)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Pregledajte grupisanje konekcija i paralelizam pollera. Provjerite raspoloživu memoriju računara baze podataka prije povećanja max_connections; historijski maksimum može odražavati stariji limit."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Kapacitet konekcija"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Čitanja InnoDB buffer poola"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Pregledajte planove upita i radni skup. Razmotrite innodb_buffer_pool_size tek nakon mjerenja dostupne memorije na računaru baze podataka; sam kumulativni omjer promašaja ne dokazuje nedostatak memorije."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Privremene tabele na disku"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Pregledajte planove upita, sortiranje, grupisanje i tipove podataka privremenih tabela prije izmjene memorijskih limita. Neke tabele moraju koristiti disk; memorijski limiti i obračun razlikuju se između verzija MySQL-a i MariaDB-a."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Kreiranje niti konekcija"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Pregledajte ponovnu upotrebu konekcija i thread_cache_size. Provjerite režim obrade niti na serveru prije podešavanja; implementacije sa skupom niti ne ponašaju se kao serveri sa jednom niti po konekciji."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Pregledajte bilježenje sporih upita, long_query_time i planove upita prije izmjene bafera servera. Ovaj brojač zavisi od konfigurisanog praga za spore upite i ne identifikuje pojedinačne naredbe."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Spore naredbe"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Kumulativni savjeti su odgođeni dok prozor posmatranja ne bude dovoljan."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "Savjet za keš niti nije ocijenjen: thread_handling nije dostupan ili nije postavljen na one-thread-per-connection. Umjesto toga pregledajte aktivnu implementaciju skupa niti."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Obavezni brojači nedostaju ili su neispravni: %s, %s. Provjerite podršku verzije servera i dozvole za nadzor."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "Brojač je resetovan od prethodnog uzorka; prikupite drugi reprezentativan interval prije podešavanja."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Nedovoljna aktivnost: %.0f %s; za ovaj savjet potrebno je najmanje %d posmatranja."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Brojači su nedosljedni ili su nezavisno resetovani. Prikupite novi reprezentativan uzorak prije podešavanja."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "Uzorak intervala je premali ili su brojači resetovani; prikupite drugi reprezentativan interval prije podešavanja."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Interval %s / %s: %.0f / %.0f (%s); prag ispitivanja: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Kumulativno %s / %s: %.0f / %.0f (%s); prag ispitivanja: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Ovaj brojač može izostaviti memorijski mapirane privremene datoteke u MySQL-u; nizak omjer ne isključuje korištenje diska."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "Savjet za redo zapisnik je odgođen dok prozor posmatranja ne bude dovoljan i Innodb_log_waits ne bude dostupan."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Kumulativni Innodb_log_waits: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Ispitajte veličine transakcija, opterećenje bafera zapisnika i latenciju diska. Ponovo provjerite stopu pod opterećenjem prije razmatranja innodb_log_buffer_size; ovaj historijski zbir nije dokaz trenutnog zastoja."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Čekanja InnoDB bafera zapisnika"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "instalirani Cacti composer.json"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "zahtjev instalatera za Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "PHP kompatibilnost sa instaliranim Cactijem"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Aktivni PHP %s; instalirani Cacti %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Nije bilo moguće utvrditi PHP zahtjev Cactija. Provjerite instalirani Cacti composer.json ili dokumentaciju izdanja; Doctor ne pretpostavlja kompatibilnost."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s i < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Zahtijeva %s (%s). Aktivni PHP zadovoljava taj uslov."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Zahtijeva %s (%s). Aktivni PHP ne zadovoljava taj uslov."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Otkriveno %s; Doctor zahtijeva Cacti 1.2.20 ili noviji."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Podržana verzija Cactija"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Uzvodna sigurnosna podrška za PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Ovo provjerava granu izdanja PHP-a, a ne da li je ova zakrpa ažurna ili da li isporučilac operativnog sistema prenosi ispravke. Kompatibilnost sa Cactijem provjerava se odvojeno."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Aktivni PHP %s; status uzvodne sigurnosne podrške je nepoznat ili je ovo predizdanje. Provjerite https://www.php.net/supported-versions.php i ažurirajte podatke o podršci dodatka Doctor."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Aktivni PHP %s; PHP %s prima uzvodne sigurnosne zakrpe do %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Aktivni PHP %s; PHP %s više ne prima uzvodne sigurnosne zakrpe; podrška je završena %s. Nadogradite na podržanu granu PHP-a kompatibilnu sa vašom Cacti instalacijom ili potvrdite sigurnosno održavanje kod isporučioca operativnog sistema."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Obavezne ekstenzije trenutnog CLI PHP-a"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Obavezne ekstenzije web PHP-a"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Nedostaju: %s. Instalirajte ih putem upravljača paketa operativnog sistema."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Sve PHP ekstenzije koje zahtijeva Cacti instalater učitane su u ovom PHP kontekstu."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "Doctor ne izvršava konfigurisane izvršne datoteke dok radi kao root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "Naziv datoteke %s nije očekivan za %s, pa je Doctor nije izvršio."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "Doctor radi kao root, pa provjere dozvola opisuju root umjesto naloga web servera ili pollera, konfigurisane izvršne datoteke se ne izvršavaju, a popravke su odbijene. Pokrenite Doctor kao korisnik Cacti pollera."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Privilegije dodatka Doctor"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "Doctor radi bez root privilegija."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Obavezne CLI PHP ekstenzije"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Konfigurisana PHP CLI izvršna datoteka nije dostupna, pa njene ekstenzije ne mogu biti provjerene."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "Funkcija shell_exec() je onemogućena, pa Doctor ne može uporediti CLI PHP ekstenzije sa zahtjevima Cactija."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "Konfigurisana PHP CLI izvršna datoteka nije vratila važeći spisak ekstenzija."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "Nedostaju u CLI PHP-u: %s. Konfiguracije web i CLI PHP-a su odvojene na mnogim sistemima."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "Konfigurisani PHP CLI ima svaku ekstenziju koju zahtijeva Cacti."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "GD TrueType podrška"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Preporučene PHP mogućnosti"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Nedostupno: %s. Cacti može raditi bez ovih mogućnosti, ali povezana funkcionalnost može biti ograničena."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "Opcionalne mogućnosti gettext, SNMP i GD TrueType su dostupne."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "memory_limit je %s (preporučuje se %dM ili više)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "max_execution_time iznosi %d sekundi (preporučuje se 60 ili više)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "date.timezone nije postavljen"

#: doctor_functions.php
msgid "unset"
msgstr "nije postavljeno"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Trenutne vrijednosti: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "PHP konfiguracija izvođenja"

#: doctor_functions.php
msgid "Database connection"
msgstr "Konekcija sa bazom podataka"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
msgstr "Upit nije uspio: %s"

#: doctor_functions.php
msgid "A read-only query completed successfully."
msgstr "Upit samo za čitanje uspješno je završen."

#: doctor_functions.php
msgid "The database returned an unexpected result."
msgstr "Baza podataka vratila je neočekivan rezultat."

#: doctor_functions.php
#, php-format
msgid "Doctor could not determine the database server version from %s."
msgstr "Doctor nije mogao utvrditi verziju servera baze podataka iz %s."

#: doctor_functions.php
msgid "Supported database server"
msgstr "Podržani server baze podataka"

#: doctor_functions.php
#, php-format
msgid "%s %s detected; this Cacti branch recommends %s %s or newer."
msgstr "Otkriveno %s %s; ova grana Cactija preporučuje %s %s ili noviji."

#: doctor_functions.php
#, php-format
msgid "Database character set is %s and collation is %s. Cacti requires utf8mb4."
msgstr "Skup znakova baze podataka je %s, a kolacija %s. Cacti zahtijeva utf8mb4."

#: doctor_functions.php
msgid "unknown"
msgstr "nepoznato"

#: doctor_functions.php
msgid "Database character set"
msgstr "Skup znakova baze podataka"

#: doctor_functions.php
msgid "Database timezone support"
msgstr "Podrška baze podataka za vremenske zone"

#: doctor_functions.php
msgid "The Cacti database account cannot read mysql.time_zone_name. Grant SELECT access and populate the database timezone tables."
msgstr "Cacti nalog baze podataka ne može čitati mysql.time_zone_name. Dodijelite SELECT dozvolu i popunite tabele vremenskih zona u bazi podataka."

#: doctor_functions.php
#, php-format
msgid "The database timezone table is accessible and contains %d entries."
msgstr "Tabela vremenskih zona u bazi podataka je dostupna i sadrži %d unosa."

#: doctor_functions.php
msgid "The database timezone table is accessible but empty. Populate the system timezone tables."
msgstr "Tabela vremenskih zona u bazi podataka je dostupna, ali prazna. Popunite sistemske tabele vremenskih zona."

#: doctor_functions.php
msgid "Core tables used by Cacti are present."
msgstr "Osnovne tabele koje koristi Cacti su prisutne."

#: doctor_functions.php
#, php-format
msgid "Missing core tables: %s. Restore or upgrade the database before attempting other repairs."
msgstr "Nedostaju osnovne tabele: %s. Vratite iz rezerve ili nadogradite bazu podataka prije drugih popravki."

#: doctor_functions.php
msgid "Core database tables"
msgstr "Osnovne tabele baze podataka"

#: doctor_functions.php
#, php-format
msgid "%s is missing (%s)"
msgstr "%s nedostaje (%s)"

#: doctor_functions.php
#, php-format
msgid "%s is not writable (%s)"
msgstr "U %s nije moguće pisati (%s)"

#: doctor_functions.php
msgid "Runtime directories"
msgstr "Direktoriji izvođenja"

#: doctor_functions.php
msgid "The cache, log, and RRA directories exist and are writable."
msgstr "Direktoriji cache, log i RRA postoje i u njih je moguće pisati."

#: doctor_functions.php
msgid "Cacti configuration file"
msgstr "Konfiguracijska datoteka Cactija"

#: doctor_functions.php
msgid "include/config.php is missing or unreadable."
msgstr "Datoteka include/config.php nedostaje ili nije čitljiva."

#: doctor_functions.php
msgid "include/config.php is readable. POSIX mode-bit checks do not apply on Windows."
msgstr "Datoteka include/config.php je čitljiva. Provjere POSIX bitova dozvola ne važe na sistemu Windows."

#: doctor_functions.php
msgid "include/config.php is writable by other users. Remove world-write permission because this file contains database credentials."
