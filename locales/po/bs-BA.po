#: setup.php
msgid "Run every Doctor check in the background after the poller and record each check's status."
msgstr "Pokreće sve Doctor provjere u pozadini nakon pollera i bilježi status svake provjere."

#: setup.php
msgid "Check Interval"
msgstr "Interval provjere"

#: setup.php
msgid "How often the scheduled checks run."
msgstr "Koliko često se pokreću zakazane provjere."

#: setup.php
msgid "Every 15 Minutes"
msgstr "Svakih 15 minuta"

#: setup.php
msgid "Every Hour"
msgstr "Svakog sata"

#: setup.php
msgid "Every 6 Hours"
msgstr "Svakih 6 sati"

#: setup.php
msgid "Every Day"
msgstr "Svakog dana"

#: setup.php
msgid "Alert Email Addresses"
msgstr "Email adrese za obavijesti"

#: setup.php
msgid "Comma-separated addresses to email when a check starts or stops failing. Leave empty to only log changes to the Cacti log."
msgstr "Adrese odvojene zarezom na koje se šalje email kada provjera počne ili prestane padati. Ostavite prazno da se promjene samo bilježe u Cacti zapisnik."

#: setup.php
msgid "Alert on Warnings"
msgstr "Obavijesti o upozorenjima"

#: setup.php
msgid "Also alert when a check moves into or out of a warning."
msgstr "Obavijesti i kada provjera uđe u status upozorenja ili izađe iz njega."

#: setup.php
msgid "Thresholds"
msgstr "Pragovi"

#: setup.php
msgid "Poller Run Time Warning (percent)"
msgstr "Upozorenje za trajanje rada pollera (procenti)"

#: setup.php
msgid "Warn when the last main-poller run used this share of the polling interval. Runs that take the whole interval always fail."
msgstr "Upozori kada je posljednje pokretanje glavnog pollera potrošilo ovaj udio intervala prikupljanja. Pokretanja koja traju čitav interval uvijek prijavljuju grešku."

#: setup.php
msgid "RRA Disk Free Warning (percent)"
msgstr "Upozorenje za slobodan prostor na RRA disku (procenti)"

#: setup.php
msgid "Warn when free space on the RRA file system drops below this percentage."
msgstr "Upozori kada slobodan prostor na RRA datotečnom sistemu padne ispod ovog procenta."

#: setup.php
msgid "Fail when free space on the RRA file system drops below this percentage."
msgstr "Prijavi grešku kada slobodan prostor na RRA datotečnom sistemu padne ispod ovog procenta."

#: setup.php
msgid "RRA Disk Free Failure (percent)"
msgstr "Greška za slobodan prostor na RRA disku (procenti)"

#: setup.php
msgid "Clock Drift Warning (seconds)"
msgstr "Upozorenje za odstupanje sata (sekunde)"

#: setup.php
msgid "Warn when the database and PHP clocks differ by more than this."
msgstr "Upozori kada se satovi baze podataka i PHP-a razlikuju za više od ove vrijednosti."

#: setup.php
msgid "Clock Drift Failure (seconds)"
msgstr "Greška za odstupanje sata (sekunde)"

#: setup.php
msgid "Fail when the database and PHP clocks differ by more than this."
msgstr "Prijavi grešku kada se satovi baze podataka i PHP-a razlikuju za više od ove vrijednosti."

#: setup.php
msgid "RRD Stale Intervals"
msgstr "Intervali zastarjelosti RRD datoteka"

#: setup.php
msgid "Warn after this many collection intervals without a file update (1 to 100)."
msgstr "Upozori nakon ovoliko intervala prikupljanja bez ažuriranja datoteke (1 do 100)."

#: setup.php
msgid "Additional disk-write delay for external caching (0 to 86400). Boost adds its own allowance."
msgstr "Dodatno kašnjenje zapisa na disk za vanjsko keširanje (0 do 86400). Boost dodaje vlastito dopuštenje."

#: setup.php
msgid "Deferred RRD Write Allowance (seconds)"
msgstr "Dopušteno kašnjenje odgođenog RRD zapisa (sekunde)"

#: setup.php
msgid "Cacti Log Size Warning (MB)"
msgstr "Upozorenje za veličinu Cacti zapisnika (MB)"

#: setup.php
msgid "Warn when the Cacti log grows beyond this size, which usually means log rotation is not running."
msgstr "Upozori kada Cacti zapisnik pređe ovu veličinu, što obično znači da rotacija zapisnika ne radi."
