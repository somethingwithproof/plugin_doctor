msgid "The audit record could not be saved. No repair was attempted."
msgstr "Hindi mai-save ang tala ng audit. Walang sinubukang pag-aayos."

#: doctor_workflows.php
msgid "The completion audit failed; inspect the filesystem and the started audit record."
msgstr "Nabigo ang audit sa pagkumpleto; siyasatin ang filesystem at ang sinimulang tala ng audit."

#: setup.php
msgid "Doctor Administrator"
msgstr "Administrator ng Doctor"

#: setup.php
msgid "Doctor Operator"
msgstr "Operator ng Doctor"

#: setup.php
msgid "Doctor Viewer"
msgstr "Tagatingin ng Doctor"

#: setup.php
msgid "Utilities"
msgstr "Mga Utility"

#: setup.php
msgid "System Administration"
msgstr "Pangangasiwa ng Sistema"

#: setup.php
msgid "Scheduled Checks"
msgstr "Mga Nakaiskedyul na Pagsusuri"

#: setup.php
msgid "Run Checks on a Schedule"
msgstr "Patakbuhin ang mga Pagsusuri ayon sa Iskedyul"

#: setup.php
msgid "Run every Doctor check in the background after the poller and record each check's status."
msgstr "Patakbuhin ang bawat pagsusuri ng Doctor sa background pagkatapos ng poller at itala ang status ng bawat pagsusuri."

#: setup.php
msgid "Check Interval"
msgstr "Agwat ng Pagsusuri"

#: setup.php
msgid "How often the scheduled checks run."
msgstr "Gaano kadalas tumatakbo ang mga nakaiskedyul na pagsusuri."

#: setup.php
msgid "Every 15 Minutes"
msgstr "Bawat 15 Minuto"

#: setup.php
msgid "Every Hour"
msgstr "Bawat Oras"

#: setup.php
msgid "Every 6 Hours"
msgstr "Bawat 6 na Oras"

#: setup.php
msgid "Every Day"
msgstr "Araw-araw"

#: setup.php
msgid "Alert Email Addresses"
msgstr "Mga Email Address para sa Alerto"

#: setup.php
msgid "Comma-separated addresses to email when a check starts or stops failing. Leave empty to only log changes to the Cacti log."
msgstr "Mga address na pinaghihiwalay ng kuwit na padadalhan ng email kapag nagsimula o humintong mabigo ang isang pagsusuri. Iwanang blangko upang i-log lamang ang mga pagbabago sa Cacti log."

#: setup.php
msgid "Alert on Warnings"
msgstr "Mag-alert sa mga Babala"

#: setup.php
msgid "Also alert when a check moves into or out of a warning."
msgstr "Mag-alert din kapag ang isang pagsusuri ay pumasok o lumabas sa estado ng babala."

#: setup.php
msgid "Thresholds"
msgstr "Mga Threshold"

#: setup.php
msgid "Poller Run Time Warning (percent)"
msgstr "Babala sa Oras ng Pagpapatakbo ng Poller (porsyento)"

#: setup.php
msgid "Warn when the last main-poller run used this share of the polling interval. Runs that take the whole interval always fail."
msgstr "Magbabala kapag ang huling pagpapatakbo ng main-poller ay gumamit ng ganitong bahagi ng polling interval. Palaging nabibigo ang mga pagpapatakbo na sumasakop sa buong interval."

#: setup.php
msgid "RRA Disk Free Warning (percent)"
msgstr "Babala sa Libreng Espasyo sa Disk ng RRA (porsyento)"

#: setup.php
msgid "Warn when free space on the RRA file system drops below this percentage."
msgstr "Magbabala kapag ang libreng espasyo sa RRA file system ay bumaba sa mas mababa pa sa porsyentong ito."

#: setup.php
msgid "Fail when free space on the RRA file system drops below this percentage."
msgstr "Mabigo kapag ang libreng espasyo sa RRA file system ay bumaba sa mas mababa pa sa porsyentong ito."

#: setup.php
msgid "RRA Disk Free Failure (percent)"
msgstr "Pagkabigo sa Libreng Espasyo sa Disk ng RRA (porsyento)"

#: setup.php
msgid "Clock Drift Warning (seconds)"
msgstr "Babala sa Clock Drift (segundo)"

#: setup.php
msgid "Warn when the database and PHP clocks differ by more than this."
msgstr "Magbabala kapag ang mga orasan ng database at PHP ay nagkakaiba nang higit pa rito."

#: setup.php
msgid "Clock Drift Failure (seconds)"
msgstr "Pagkabigo sa Clock Drift (segundo)"

#: setup.php
msgid "Fail when the database and PHP clocks differ by more than this."
msgstr "Mabigo kapag ang mga orasan ng database at PHP ay nagkakaiba nang higit pa rito."

#: setup.php
msgid "RRD Stale Intervals"
msgstr "Mga Stale Interval ng RRD"

#: setup.php
msgid "Warn after this many collection intervals without a file update (1 to 100)."
msgstr "Magbabala pagkatapos ng ganitong karaming interval ng pagkolekta nang walang pag-update ng file (1 hanggang 100)."

#: setup.php
msgid "Additional disk-write delay for external caching (0 to 86400). Boost adds its own allowance."
msgstr "Karagdagang pagkaantala sa pagsulat sa disk para sa panlabas na pag-cache (0 hanggang 86400). Nagdaragdag ang Boost ng sarili nitong palugit."

#: setup.php
msgid "Deferred RRD Write Allowance (seconds)"
msgstr "Palugit sa Naantalang Pagsulat ng RRD (segundo)"

#: setup.php
msgid "Cacti Log Size Warning (MB)"
msgstr "Babala sa Laki ng Cacti Log (MB)"

#: setup.php
msgid "Warn when the Cacti log grows beyond this size, which usually means log rotation is not running."
msgstr "Magbabala kapag ang Cacti log ay lumaki nang lampas sa laking ito, na kadalasang nangangahulugang hindi tumatakbo ang log rotation."
