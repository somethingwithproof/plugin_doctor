msgstr "Buksan ang Mga Utility > Doctor para sa mga kasalukuyang sukat, inirerekomendang aksyon, at hakbang sa pag-verify."

#: doctor_scheduling.php
#, php-format
msgid "Cacti Doctor: %d retained status changes"
msgstr "Cacti Doctor: %d pinananatiling pagbabago ng status"

#: doctor_scheduling.php
msgid "Doctor schedule is already running or the database lock is unavailable."
msgstr "Tumatakbo na ang iskedyul ng Doctor o hindi available ang lock ng database."

#: doctor_web.php
msgid "The finding could not be acknowledged. Run Doctor again, then acknowledge the current result."
msgstr "Hindi makilala ang natuklasan. Patakbuhin muli ang Doctor, pagkatapos ay kilalanin ang kasalukuyang resulta."

#: doctor_web.php
msgid "The warning exception could not be saved. Use a fresh assessed warning, an owner, a reason and an expiry within 90 days."
msgstr "Hindi mai-save ang exception sa babala. Gumamit ng bagong nasuring babala, may-ari, dahilan, at pag-expire sa loob ng 90 araw."

#: doctor_web.php
msgid "Confirm repair"
msgstr "Kumpirmahin ang pag-aayos"

#: doctor_web.php
msgid "Approval expires after five minutes and is invalidated by a changed filesystem. The acting account must be able to create directories or change owner permissions."
msgstr "Nag-e-expire ang pag-apruba pagkalipas ng limang minuto at nawawalan ng bisa kapag nagbago ang filesystem. Dapat na makalikha ng mga direktoryo o makapagbago ng mga pahintulot ng may-ari ang gumaganap na account."

#: doctor_web.php
msgid "Repair prerequisites are not met. No changes will be made."
msgstr "Hindi natutugunan ang mga kinakailangan sa pag-aayos. Walang gagawing pagbabago."

#: doctor_web.php
msgid "Cancel"
msgstr "Kanselahin"

#: doctor_web.php
#, php-format
msgid "Last observation: %s UTC."
msgstr "Huling obserbasyon: %s UTC."

#: doctor_web.php
msgid "No completed diagnostic report is available."
msgstr "Walang available na nakumpletong ulat ng diagnostic."

#: doctor_web.php
msgid "Health is unknown: observations are missing or stale."
msgstr "Hindi alam ang kalusugan: nawawala o luma na ang mga obserbasyon."

#: doctor_web.php
msgid "Run diagnostic checks"
msgstr "Patakbuhin ang mga diagnostic check"

