#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Gyare-gyaren da ke samuwa: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Tsarin %s da ba a sani ba. Yi amfani da text, json, nagios, ko prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Ba a iya kammala ɓoye bayanan sirri ba, don haka ba a rubuta %s ba."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "An rubuta %s. Duba shi kafin rabawa; an rufe ƙimomin da ke bayan sunayen password, secret, token, da community."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Gyara da ba a sani ba"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "An ƙi yin gyara ba tare da --yes ba."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Zaɓi alamar matsala da ake goyon baya da fitarwar text ko JSON."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Gargaɗin da aka karɓa"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Samuwar na'ura"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Ba a iya tantance izinin na'ura ba."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "PHP CLI da aka saita ba za ta iya gudanar da binciken Doctor ba."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Binciken Doctor ya gaza ko ya wuce ƙayyadadden lokacinsa. Duba rajistar Doctor."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Jadawalai sun daina sabuntawa"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Tattara bayanai (polling) yana tafiya a hankali"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Na'urori sun ɓace ko ba sa samuwa"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Faɗakarwar Doctor sun ɓace"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Duba mai tsara lokacin poller da rajistar poller da abin ya shafa, sannan ka tabbatar da sabon zagayen da aka kammala."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "Wataƙila tattarawa ya tsaya."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Wataƙila ƙimomin da aka tattara ba sa isa rumbun ajiya."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Bincika jerin fitarwa da tarihin sharewa na Boost; ka tabbatar jerin yana raguwa kuma tambarin lokacin RRD yana ci gaba."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Duba ƙarfin ajiya, izinin jakar aiki na lokacin gudanarwa da sabuntawar RRD ta ƙarshe; ka yi la'akari da rubuce-rubucen da aka jinkirta."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "Ma'ajiyar RRD tana buƙatar bincike."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Wataƙila aikin tattarawa yana wucewa lokacin da aka keɓe masa."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Kwatanta tsawon zagaye da tazarar polling sannan ka bincika ƙarewar lokacin na'urori kafin ka ƙara yawan ayyukan lokaci guda."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Kwatanta masu ƙidaya na rumbun bayanai yayin zagaye mai nauyi sannan ka bincika tsare-tsaren tambayoyi kafin ka canja iyakokin sabar."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Wataƙila matsin rumbun bayanai yana taimakawa wajen jinkirin polling."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Wataƙila sharuɗɗan tattarawa ko samun damar isa suna gazawa."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Tabbatar da izinin na'urar da abin ya shafa, samun damar isa gare ta, bayanan shiga da poller ɗin da aka keɓe mata ta amfani da binciken Cacti."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Binciken da aka tsara ko isar da saƙon imel suna buƙatar kulawa."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Tabbatar da saitin tsara lokaci da na masu karɓa, ka bincika yunƙurin isarwa da aka ajiye, sannan ka aika imel na gwaji na Cacti."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Dalilan da ka iya yiwuwa suna buƙatar tabbatarwa; dacewar bincike ba ta tabbatar da tushen matsala ba."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Babu wani dalili da aka tabbatar daga lura da ake da su. Gudanar da sabon bincike kuma ka bincika alamar kai tsaye."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Aƙalla sa'o'i 24 tun bayan kunna sabar da FLUSH STATUS. Masu ƙidaya na taruwa ne kuma suna iya samun tarihin sake saiti daban-daban; tabbatar da yanayin yayin aikin gwaji mai wakilci kafin daidaitawa."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "An jinkirta shawarar daidaitawa mai taruwa: samu sahihin lokacin aiki da aƙalla sa'o'i 24 tun bayan kunnawa da FLUSH STATUS. Ma'aunan da suka ɓace ko samfurin da bai daidaita ba ba za su iya tabbatar da lafiyar rumbun bayanai ba."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Lokacin lura na rumbun bayanai"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Ma'aunan haɗi ba su samuwa ko ba su da inganci. Duba izinin shiga SHOW GLOBAL STATUS da SHOW GLOBAL VARIABLES; kada ka ɗauki ma'aunan da suka ɓace a matsayin sabar da ba ta aiki."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Haɗe-haɗe na yanzu: %.0f / %.0f (%s); kololuwar da aka rubuta: %.0f (%s na iyakar yanzu)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Duba haɗa haɗe-haɗe da aikin poller na lokaci guda. Duba sararin ƙwaƙwalwar na'urar rumbun bayanai kafin ƙara max_connections; kololuwar tarihi na iya nuna tsohuwar iyaka."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Ƙarfin haɗi"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Karatun InnoDB buffer pool"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Duba tsare-tsaren tambayoyi da rukunin aiki. Yi la'akari da innodb_buffer_pool_size kawai bayan auna ƙwaƙwalwar da ke akwai a na'urar rumbun bayanai; adadin gazawa mai taruwa kaɗai ba ya tabbatar da matsin ƙwaƙwalwa."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Tebura na wucin gadi a kan rumbun ajiya"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Duba tsare-tsaren tambayoyi, jerawa, rukuni, da nau'ikan bayanai na teburin wucin gadi kafin canja iyakokin ƙwaƙwalwa. Wasu tebura dole su yi amfani da rumbun ajiya; iyakokin ƙwaƙwalwa da lissafi sun sha bamban tsakanin nau'ikan MySQL da MariaDB."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Ƙirƙirar zaren haɗi"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Duba sake amfani da haɗi da thread_cache_size. Duba yanayin sarrafa zare na sabar kafin daidaitawa; tsarin thread-pool ba ya aiki kamar sabar mai zare ɗaya ga kowane haɗi."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Duba rajistar tambayoyi masu nauyi, long_query_time, da tsare-tsaren tambayoyi kafin canja ma'ajiyar sabar. Wannan mai ƙidaya ya dogara da ƙayyadadden iyakar tambayoyi masu nauyi kuma ba ya gano ɗaiɗaikun umarni."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Umarni masu jinkiri"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "An jinkirta shawara mai taruwa har sai lokacin lura ya isa."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "Ba a tantance shawarar thread-cache ba: thread_handling ba ya samuwa ko ba zare ɗaya ga kowane haɗi ba ne. Maimakon haka duba tsarin thread-pool da ke aiki."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Masu ƙidaya da ake buƙata sun ɓace ko ba su da inganci: %s, %s. Duba goyon bayan nau'in sabar da izinin sa ido."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "An sake saita wani mai ƙidaya tun samfurin da ya gabata; tattara wani lokaci mai wakilci kafin daidaitawa."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Rashin isasshen aiki: %.0f %s; ana buƙatar aƙalla lura %d don wannan shawara."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Masu ƙidaya ba su daidaita ba ko an sake saita su daban-daban. Tattara sabon samfuri mai wakilci kafin daidaitawa."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "Samfurin tazarar ya yi ƙanƙanta ko an sake saita masu ƙidaya; tattara wani lokaci mai wakilci kafin daidaitawa."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Tazarar %s / %s: %.0f / %.0f (%s); iyakar bincike: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Taruwar %s / %s: %.0f / %.0f (%s); iyakar bincike: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Wannan mai ƙidaya na iya tsallake fayilolin wucin gadi da aka haɗa da ƙwaƙwalwa a MySQL; ƙarancin rabo ba ya kore yiwuwar amfani da rumbun ajiya."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "An jinkirta shawarar redo-log har sai lokacin lura ya isa kuma Innodb_log_waits yana samuwa."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Taruwar Innodb_log_waits: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Bincika girman ma'amaloli, matsin log-buffer, da jinkirin ma'ajiya. Sake duba adadin yayin nauyin aiki kafin la'akari da innodb_log_buffer_size; wannan ƙidayar tarihi ba hujja ce ta tsayawar yanzu ba."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Jiran InnoDB log-buffer"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "composer.json na Cacti da aka shigar"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "Buƙatar mai shigar da Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "Dacewar PHP da Cacti da aka shigar"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Ana gudanar da PHP %s; an shigar da Cacti %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Ba a iya tabbatar da buƙatar PHP ta Cacti ba. Duba composer.json na Cacti da aka shigar ko takardun saki; Doctor ba ya ɗauka cewa sun dace."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s da < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Yana buƙatar %s (%s). PHP da ke gudanarwa ya cika wannan buƙata."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Yana buƙatar %s (%s). PHP da ke gudanarwa bai cika wannan buƙata ba."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "An gano %s; Doctor yana buƙatar Cacti 1.2.20 ko sabo."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Nau'in Cacti da ake goyon baya"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Goyon bayan tsaro na asali na PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Wannan yana duba reshen sakin PHP ne, ba ko wannan sakin gyara ya sabunta ko ko mai samar da OS naka yana mayar da gyare-gyare ba. Ana duba dacewar Cacti daban."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Ana gudanar da PHP %s; ba a san matsayin goyon bayan tsaro na asali ba ko wannan sakin farko ne. Duba https://www.php.net/supported-versions.php kuma ka sabunta bayanan goyon baya na Doctor."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Ana gudanar da PHP %s; PHP %s yana karɓar gyare-gyaren tsaro na asali har zuwa %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Ana gudanar da PHP %s; PHP %s ba ya ƙara karɓar gyare-gyaren tsaro na asali; goyon baya ya ƙare %s. Haɓaka zuwa reshen PHP da ake goyon baya mai dacewa da shigar Cacti naka, ko ka tabbatar da kulawar tsaro tare da mai samar da OS naka."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Ƙarin PHP na CLI na yanzu da ake buƙata"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Ƙarin PHP na yanar gizo da ake buƙata"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Waɗanda suka ɓace: %s. Shigar da su ta mai sarrafa fakitin tsarin aiki."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Duk ƙarin PHP da mai shigar da Cacti ke buƙata an ɗora su a wannan yanayin PHP."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "Doctor ba ya gudanar da fayilolin shiri da aka saita yayin da yake aiki a matsayin root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "Ba a yi tsammanin sunan fayil %s don %s ba, don haka Doctor bai gudanar da shi ba."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "Doctor yana aiki a matsayin root, don haka binciken izini yana bayyana root ne maimakon asusun sabar yanar gizo ko na poller, ba a gudanar da fayilolin shiri da aka saita ba, kuma an ƙi gyare-gyare. Gudanar da Doctor a matsayin mai amfani na Cacti poller."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Izinin Doctor"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "Doctor yana aiki ba tare da izinin root ba."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Ƙarin PHP na CLI da ake buƙata"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Fayil ɗin gudanarwa na PHP CLI da aka saita ba ya samuwa, don haka ba za a iya duba ƙarinsa ba."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "An kashe shell_exec(), don haka Doctor ba zai iya kwatanta ƙarin CLI PHP da buƙatun Cacti ba."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "Fayil ɗin gudanarwa na PHP CLI da aka saita bai dawo da ingantaccen jerin ƙari ba."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "Waɗanda suka ɓace daga CLI PHP: %s. Saitunan PHP na yanar gizo da na CLI suna daban a yawancin tsaruka."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "PHP CLI da aka saita yana da kowane ƙari da Cacti ke buƙata."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "Goyon bayan GD TrueType"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Fasalolin PHP da aka ba da shawara"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Ba sa samuwa: %s. Cacti na iya aiki ba tare da waɗannan fasaloli ba, amma ayyukan da suka shafe su na iya samun iyaka."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "Fasalolin zaɓi na gettext, SNMP, da GD TrueType suna samuwa."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "memory_limit shine %s (ana ba da shawarar %dM ko fiye)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "max_execution_time shine daƙiƙa %d (ana ba da shawarar 60 ko fiye)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "ba a saita date.timezone ba"

#: doctor_functions.php
msgid "unset"
msgstr "ba a saita ba"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Ƙimomin yanzu: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "Saitin lokacin gudanarwa na PHP"

#: doctor_functions.php
msgid "Database connection"
msgstr "Haɗin rumbun bayanai"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
msgstr "Tambaya ta gaza: %s"

#: doctor_functions.php
msgid "A read-only query completed successfully."
msgstr "Tambayar karatu kawai ta kammala cikin nasara."

#: doctor_functions.php
msgid "The database returned an unexpected result."
msgstr "Rumbun bayanai ya dawo da sakamakon da ba a yi tsammani ba."

#: doctor_functions.php
#, php-format
msgid "Doctor could not determine the database server version from %s."
msgstr "Doctor bai iya tantance nau'in sabar rumbun bayanai daga %s ba."

#: doctor_functions.php
msgid "Supported database server"
msgstr "Sabar rumbun bayanai da ake goyon baya"

#: doctor_functions.php
#, php-format
msgid "%s %s detected; this Cacti branch recommends %s %s or newer."
msgstr "An gano %s %s; wannan reshen Cacti yana ba da shawarar %s %s ko sabo."

#: doctor_functions.php
#, php-format
msgid "Database character set is %s and collation is %s. Cacti requires utf8mb4."
msgstr "Tsarin haruffan rumbun bayanai shine %s kuma tsarin jerawa shine %s. Cacti yana buƙatar utf8mb4."

#: doctor_functions.php
msgid "unknown"
msgstr "ba a sani ba"

#: doctor_functions.php
msgid "Database character set"
msgstr "Tsarin haruffan rumbun bayanai"

#: doctor_functions.php
msgid "Database timezone support"
msgstr "Goyon bayan yankin lokaci na rumbun bayanai"

#: doctor_functions.php
msgid "The Cacti database account cannot read mysql.time_zone_name. Grant SELECT access and populate the database timezone tables."
msgstr "Asusun rumbun bayanai na Cacti ba zai iya karanta mysql.time_zone_name ba. Ba da izinin SELECT kuma ka cika teburan yankin lokaci na rumbun bayanai."

#: doctor_functions.php
#, php-format
msgid "The database timezone table is accessible and contains %d entries."
msgstr "Ana iya samun damar shiga teburin yankin lokaci na rumbun bayanai kuma yana ƙunshe da bayanai %d."

#: doctor_functions.php
msgid "The database timezone table is accessible but empty. Populate the system timezone tables."
msgstr "Ana iya samun damar shiga teburin yankin lokaci na rumbun bayanai amma babu komai a ciki. Cika teburan yankin lokaci na tsari."

#: doctor_functions.php
msgid "Core tables used by Cacti are present."
msgstr "Babban teburan da Cacti ke amfani da su suna nan."

#: doctor_functions.php
#, php-format
msgid "Missing core tables: %s. Restore or upgrade the database before attempting other repairs."
msgstr "Babban teburan da suka ɓace: %s. Maido ko haɓaka rumbun bayanai kafin yunƙurin sauran gyare-gyare."

#: doctor_functions.php
msgid "Core database tables"
msgstr "Babban teburan rumbun bayanai"

#: doctor_functions.php
#, php-format
msgid "%s is missing (%s)"
msgstr "%s ya ɓace (%s)"

