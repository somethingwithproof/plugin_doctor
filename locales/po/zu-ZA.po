#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Ukulungiswa okutholakalayo: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Ifomethi engaziwa %s. Sebenzisa i-text, json, nagios, noma i-prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Ukufihla imininingwane eyimfihlo akukwazanga ukuqedwa, ngakho %s ayibhalwanga."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "Kubhalwe %s. Kubuyekeze ngaphambi kokwabelana; amanani alandela amagama ephasiwedi, imfihlo, ithokheni, kanye ne-community afihliwe."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Ukulungiswa okungaziwa"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Iyala ukulungisa ngaphandle kwefulegi elithi --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Khetha uphawu olusekelwayo kanye nokukhishwa kwe-text noma kwe-JSON."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Isixwayiso esamukelwe"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Ukutholakala kwedivayisi"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Izimvume zedivayisi azikwazanga ukuhlolwa."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "I-PHP CLI elungisiwe ayikwazi ukusebenzisa ukuhlolwa kwe-Doctor."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Ukuhlolwa kwe-Doctor kwehlulekile noma kudlule umkhawulo wesikhathi sakho. Buyekeza ilogi ye-Doctor."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Amagrafu ayekile ukubuyekezwa"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Ukuhlola kuhamba kancane"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Amadivayisi awekho noma awatholakali"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Izexwayiso ze-Doctor ziyashoda"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Hlola umhleli we-poller kanye nelogi ye-poller ethintekile, bese uqinisekisa umjikelezo omusha oqediwe."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "Ukuqoqwa kwedatha kungase kube kumile."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Amanani aqoqiwe angase angafiki ediskini."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Hlola ulayini wokuphumayo kanye nomlando wokukhipha we-Boost; qinisekisa ukuthi ulayini uyakhishwa nokuthi izitembu zesikhathi ze-RRD ziyaqhubeka."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Hlola umthamo wokugcina, izimvume zohla lwemibhalo lwesikhathi sokusebenza kanye nesibuyekezo sokugcina se-RRD; bala nokubhalwa okuhlehlisiwe."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "Isitoreji se-RRD sidinga ukuphenywa."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Umsebenzi wokuqoqa ungase weqe isabelo sawo sesikhathi."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Qhathanisa ubude bomjikelezo nesikhawu soku-poll futhi uhlole ukuphelelwa yisikhathi kwedivayisi ngaphambi kokwandisa ukusebenzisana kanyekanye."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Qhathanisa izibali zesizindalwazi phakathi nomjikelezo ohamba kancane futhi uhlole izinhlelo zokubuza ngaphambi kokushintsha imikhawulo yeseva."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Ingcindezi yesizindalwazi ingase ibe nomthelela eku-polleni okuhamba kancane."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Izidingo zangaphambi kokuqoqa noma ukufinyeleleka kungase kuhluleke."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Qinisekisa izimvume zedivayisi ethintekile, ukufinyeleleka, imininingwane yokungena kanye ne-poller eyabelwe usebenzisa ukuxilonga kwe-Cacti."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Ukuhlolwa okuhleliwe noma ukulethwa kweposi kudinga ukunakwa."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Qinisekisa izilungiselelo zokuhlela nezomamukeli, hlola imizamo yokuletha egciniwe, bese uthumela i-imeyili yokuhlola ye-Cacti."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Izimbangela ezingenzeka zidinga ukuqinisekiswa; ukuhlolwa okufanayo akusunguli imbangela eyisisekelo."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Ayikho imbangela esungulwe ngokubhekwayo okutholakalayo. Qalisa ukuxilonga okusha bese uphenya uphawu ngokuqondile."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Okungenani amahora angu-24 kusukela ekuqalisweni kweseva nase-FLUSH STATUS. Izibali ziyanqwabelana futhi zingaba nemilando ehlukene yokusetha kabusha; qinisekisa izitayela phakathi nomthwalo womsebenzi omele ngaphambi kokushuna."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "Izeluleko zokushuna ezinqwabelanayo zihlehlisiwe: thola isikhathi sokusebenza esisebenzayo kanye nokungenani amahora angu-24 kusukela ekuqalisweni nase-FLUSH STATUS. Amamethrikhi alahlekile noma isampula elingahambisani alikwazi ukusungula impilo yesizindalwazi."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Iwindi lokubheka isizindalwazi"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Amamethrikhi okuxhumeka awatholakali noma awasebenzi. Hlola ukufinyelela ku-SHOW GLOBAL STATUS naku-SHOW GLOBAL VARIABLES; ungaphathi amamethrikhi alahlekile njengeseva engasebenzi."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Ukuxhumeka kwamanje: %.0f / %.0f (%s); inani eliphezulu eliqoshiwe: %.0f (%s yomkhawulo wamanje)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Buyekeza ukuhlanganiswa kokuxhumeka kanye nokusebenzisana kanyekanye kwe-poller. Hlola isikhala sememori yomsingathi wesizindalwazi ngaphambi kokukhuphula i-max_connections; inani eliphezulu lomlando lingabonisa umkhawulo omdala."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Umthamo wokuxhumeka"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Ukufundwa kwesiziba sebhafa ye-InnoDB"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Buyekeza izinhlelo zokubuza kanye nesethi yokusebenza. Cabangela i-innodb_buffer_pool_size kuphela ngemva kokulinganisa imemori etholakala kumsingathi wesizindalwazi; isilinganiso sokuphuthelwa esinqwabelanayo sodwa asifakazeli ingcindezi yememori."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Amathebula esikhashana akudiski"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Buyekeza izinhlelo zokubuza, ukuhlela, ukuhlanganisa ngamaqembu, kanye nezinhlobo zedatha zamathebula esikhashana ngaphambi kokushintsha imikhawulo yememori. Amanye amathebula kufanele asebenzise idiski; imikhawulo yememori nokubalwa kwayo kuyahluka phakathi kwezinguqulo ze-MySQL neze-MariaDB."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Ukudalwa kwemicu yokuxhumeka"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Buyekeza ukusetshenziswa kabusha kokuxhumeka kanye ne-thread_cache_size. Hlola imodi yokuphatha imicu yeseva ngaphambi kokushuna; ukusetshenziswa kwesiziba semicicu akuziphathi njengamaseva omucu owodwa ngokuxhumeka ngakunye."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Buyekeza ukufakwa kwelogi kwemibuzo ehamba kancane, i-long_query_time, kanye nezinhlelo zokubuza ngaphambi kokushintsha amabhafa eseva. Lesi sibali sincike kumkhawulo wombuzo ohamba kancane olungisiwe futhi asihlonzi izitatimende ngazinye."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Izitatimende ezihamba kancane"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Izeluleko ezinqwabelanayo zihlehlisiwe kuze kube yilapho iwindi lokubheka selanele."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "Izeluleko ze-thread-cache azihloliwe: i-thread_handling ayitholakali noma akuyona i-one-thread-per-connection. Buyekeza ukusetshenziswa kwesiziba semicicu esisebenzayo esikhundleni salokho."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Izibali ezidingekayo ziyashoda noma azisebenzi: %s, %s. Hlola ukusekelwa kwenguqulo yeseva kanye nezimvume zokuqapha."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "Isibali sisethwe kabusha kusukela kusampula langaphambilini; qoqa esinye isikhawu esimele ngaphambi kokushuna."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Umsebenzi onganele: %.0f %s; okungenani ukubhekwayo okungu-%d kuyadingeka kulesi seluleko."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Izibali azihambisani noma zisethwe kabusha ngokuzimela. Qoqa isampula elisha elimele ngaphambi kokushuna."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "Isampula lesikhawu lincane kakhulu noma izibali zisethwe kabusha; qoqa esinye isikhawu esimele ngaphambi kokushuna."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Isikhawu %s / %s: %.0f / %.0f (%s); umkhawulo wophenyo: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Okunqwabelanayo %s / %s: %.0f / %.0f (%s); umkhawulo wophenyo: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Lesi sibali singashiya amafayela esikhashana amephelwe ememorini ku-MySQL; isilinganiso esiphansi asikhiphi ukusetshenziswa kwediski."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "Izeluleko ze-redo-log zihlehlisiwe kuze kube yilapho iwindi lokubheka selanele futhi i-Innodb_log_waits itholakala."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "I-Innodb_log_waits enqwabelanayo: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Phenya ubukhulu bokwenziwayo, ingcindezi yebhafa yelogi, kanye nokubambezeleka kwesitoreji. Hlola kabusha izinga ngaphansi komthwalo ngaphambi kokucabangela i-innodb_log_buffer_size; lesi sibalo somlando asibufakazi ukuma kwamanje."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Ukulinda kwebhafa yelogi ye-InnoDB"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "i-composer.json ye-Cacti efakiwe"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "Isidingo sesifaki se-Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "Ukuhambisana kwe-PHP ne-Cacti efakiwe"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Kusebenza i-PHP %s; kufakwe i-Cacti %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Ayikwazanga ukusungula isidingo se-PHP se-Cacti. Hlola i-composer.json ye-Cacti efakiwe noma imibhalo yokukhululwa; i-Doctor ayicabangeli ukuhambisana."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "I-PHP >= %s futhi < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "I-PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Idinga i-%s (%s). I-PHP esebenzayo iyasifeza leso sidingo."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Idinga i-%s (%s). I-PHP esebenzayo ayisifezi leso sidingo."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Kutholakale i-%s; i-Doctor idinga i-Cacti 1.2.20 noma entsha."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Inguqulo ye-Cacti esekelwayo"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Ukusekelwa kokuphepha kwangaphambili kwe-PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Lokhu kuhlola igatsha lokukhululwa kwe-PHP, hhayi ukuthi lokhu kukhululwa kwephetshi kusesikhathini yini noma umthengisi wakho we-OS ubuyisela emuva izilungiso. Ukuhambisana kwe-Cacti kuhlolwa ngokwehlukana."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Kusebenza i-PHP %s; isimo sokusekelwa kokuphepha kwangaphambili asaziwa noma lokhu ukukhululwa kwangaphambi kwesikhathi. Hlola ku https://www.php.net/supported-versions.php bese ubuyekeza idatha yokusekelwa ye-Doctor."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Kusebenza i-PHP %s; i-PHP %s ithola izilungiso zokuphepha zangaphambili kuze kube ngu-%s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Kusebenza i-PHP %s; i-PHP %s ayisazitholi izilungiso zokuphepha zangaphambili; ukusekelwa kuphele ngo-%s. Thuthukisela egatsheni le-PHP elisekelwayo elihambisana nokufakwa kwakho kwe-Cacti, noma uqinisekise ukulungiswa kokuphepha nomthengisi wakho we-OS."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Izandiso ze-PHP ze-CLI zamanje ezidingekayo"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Izandiso ze-PHP zewebhu ezidingekayo"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Kuyashoda: %s. Kufake ngomphathi wamaphakheji wesistimu yokusebenza."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Zonke izandiso ze-PHP ezidingwa isifaki se-Cacti zilayishiwe kulo mongo we-PHP."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "I-Doctor ayisebenzisi amabhanari alungisiwe ngenkathi isebenza njenge-root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "Igama lefayela elithi %s alilindelekile ku-%s, ngakho i-Doctor ayilisebenzisanga."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "I-Doctor isebenza njenge-root, ngakho ukuhlolwa kwezimvume kuchaza i-root kuneseva yewebhu noma i-akhawunti ye-poller, amabhanari alungisiwe awasetshenziswa, futhi ukulungiswa kuyaliwa. Qalisa i-Doctor njengomsebenzisi we-poller we-Cacti."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Izimvume ze-Doctor"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "I-Doctor isebenza ngaphandle kwezimvume ze-root."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Izandiso ze-PHP ze-CLI ezidingekayo"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Ifayela elisebenzisekayo le-PHP CLI elilungisiwe alitholakali, ngakho izandiso zalo azikwazi ukuhlolwa."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "I-shell_exec() ikhutshaziwe, ngakho i-Doctor ayikwazi ukuqhathanisa izandiso ze-PHP ze-CLI nezidingo ze-Cacti."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "Ifayela elisebenzisekayo le-PHP CLI elilungisiwe alibuyisanga uhlu lwezandiso olusebenzayo."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "Kuyashoda ku-CLI PHP: %s. Izilungiselelo ze-PHP zewebhu neze-CLI zihlukene kumasistimu amaningi."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "I-PHP CLI elungisiwe inazo zonke izandiso ezidingwa yi-Cacti."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "Ukusekelwa kwe-GD TrueType"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Izici ze-PHP ezinconyiwe"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Akutholakali: %s. I-Cacti ingasebenza ngaphandle kwalezi zici, kodwa ukusebenza okuhlobene kungase kube nomkhawulo."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "Izici zokuzikhethela ze-gettext, i-SNMP, kanye ne-GD TrueType ziyatholakala."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "I-memory_limit ngu-%s (kunconywa u-%dM noma ngaphezulu)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "I-max_execution_time ingamasekhondi angu-%d (kunconywa u-60 noma ngaphezulu)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "I-date.timezone ayisethiwe"

#: doctor_functions.php
msgid "unset"
msgstr "akusethiwe"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Amanani amanje: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "Izilungiselelo zesikhathi sokusebenza se-PHP"

#: doctor_functions.php
msgid "Database connection"
msgstr "Ukuxhumeka kwesizindalwazi"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
msgstr "Umbuzo wehlulekile: %s"

#: doctor_functions.php
msgid "A read-only query completed successfully."
msgstr "Umbuzo wokufunda kuphela uqediwe ngempumelelo."

#: doctor_functions.php
msgid "The database returned an unexpected result."
msgstr "Isizindalwazi sibuyise umphumela obungalindelekile."

#: doctor_functions.php
#, php-format
msgid "Doctor could not determine the database server version from %s."
msgstr "I-Doctor ayikwazanga ukunquma inguqulo yeseva yesizindalwazi kusuka ku-%s."

#: doctor_functions.php
msgid "Supported database server"
msgstr "Iseva yesizindalwazi esekelwayo"

#: doctor_functions.php
#, php-format
msgid "%s %s detected; this Cacti branch recommends %s %s or newer."
msgstr "Kutholakale i-%s %s; leli gatsha le-Cacti lincoma i-%s %s noma entsha."

#: doctor_functions.php
#, php-format
msgid "Database character set is %s and collation is %s. Cacti requires utf8mb4."
msgstr "Isethi yezinhlamvu yesizindalwazi ngu-%s futhi ukuhlelwa kwezinhlamvu ngu-%s. I-Cacti idinga i-utf8mb4."

#: doctor_functions.php
msgid "unknown"
msgstr "akwaziwa"

#: doctor_functions.php
msgid "Database character set"
msgstr "Isethi yezinhlamvu yesizindalwazi"

#: doctor_functions.php
msgid "Database timezone support"
