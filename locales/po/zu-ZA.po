msgstr "AKWAZIWA"

#: doctor_rrd.php
msgid "Data source freshness could not be assessed."
msgstr "Ukuba sha komthombo wedatha akukwazanga ukuhlolwa."

#: doctor_rrd.php
msgid "RRD update freshness"
msgstr "Ukuba sha kwesibuyekezo se-RRD"

#: doctor_rrd.php
msgid "The deferred-write interval is unknown; configure it before judging file age."
msgstr "Isikhawu sokubhala okuhlehlisiwe asaziwa; simise ngaphambi kokwahlulela isikhathi kusukela esibuyekezweni sokugcina sefayela."

#: doctor_rrd.php
#, php-format
msgid "Checked %d files; %d stale files across %d devices; %d unavailable or future-dated files."
msgstr "Kuhlolwe amafayela angu-%d; amafayela amadala angu-%d kumadivayisi angu-%d; amafayela angatholakali noma anedethi yesikhathi esizayo angu-%d."

#: doctor_rrd.php
msgid "File age includes the collection interval and configured deferred-write allowance; verify the poller and flush process before changing data."
msgstr "Isikhathi kusukela esibuyekezweni sokugcina sefayela sihlanganisa isikhawu sokuqoqa kanye nesikhathi esivunyelwe sokubhala okuhlehlisiwe esimisiwe; qinisekisa i-poller kanye nenqubo ye-flush ngaphambi kokushintsha idatha."

#: doctor_scheduling.php
msgid "Scheduled checks are disabled. Enable them in Settings > Doctor to retain samples and alert on changes."
msgstr "Ukuhlolwa okuhleliwe kukhutshaziwe. Kunike amandla ku-Izilungiselelo > Doctor ukuze ugcine amasampula futhi uxwayise ngezinguquko."

#: doctor_scheduling.php
msgid "Scheduled report freshness"
msgstr "Ukuba sha kombiko ohleliwe"

#: doctor_scheduling.php
#, php-format
msgid "%s UTC"
msgstr "%s UTC"

#: doctor_scheduling.php
#, php-format
msgid "Last started: %s; last completed: %s."
msgstr "Kuqalwe okokugcina: %s; kuphothulwe okokugcina: %s."

#: doctor_scheduling.php
msgid "never"
msgstr "akukaze"

#: doctor_scheduling.php
msgid "Results are missing or stale. Check the primary poller and DOCTOR log for startup, timeout, or persistence errors."
msgstr "Imiphumela ayikho noma isindala. Hlola i-poller eyinhloko kanye nelogi ye-DOCTOR ukuze uthole amaphutha okuqalisa, ukuphelelwa isikhathi, noma okugcina."

#: doctor_scheduling.php
msgid "A completed diagnostic run is recent; this does not mean all checks passed."
msgstr "Ukuhlolwa kokuxilonga okuphothuliwe kwakamuva; lokhu akusho ukuthi konke ukuhlolwa kuphumelele."

#: doctor_scheduling.php
msgid "Doctor alert state is invalid. Restore doctor_alert_pending from backup before retrying."
msgstr "Isimo sesexwayiso se-Doctor asivumelekile. Buyisela i-doctor_alert_pending kusukela kwisipele ngaphambi kokuzama futhi."

#: doctor_scheduling.php
msgid "Doctor alert transitions are invalid; no email was sent."
msgstr "Izinguquko zesexwayiso se-Doctor azivumelekile; alikho i-imeyili elithunyelwe."

#: doctor_scheduling.php
msgid "Alert delivery"
msgstr "Ukulethwa kwesexwayiso"

#: doctor_scheduling.php
#, php-format
msgid "%d check transitions await delivery; attempts: %d of 3."
msgstr "Izinguquko zokuhlolwa ezingu-%d zilinde ukulethwa; imizamo: %d kwemi-3."

#: doctor_scheduling.php
msgid "Automatic retries exhausted. Correct Cacti mail settings, then run Doctor with --scheduled --retry-alerts as the poller user."
msgstr "Imizamo ezenzakalelayo iphelile. Lungisa izilungiselelo ze-imeyili ze-Cacti, bese usebenzisa i-Doctor ngokuthi --scheduled --retry-alerts njengomsebenzisi we-poller."

#: doctor_scheduling.php
#, php-format
msgid "Next eligible retry: %s UTC, after a primary poller cycle."
msgstr "Umzamo olandelayo ofanelekile: %s UTC, ngemva komjikelezo we-poller eyinhloko."

#: doctor_scheduling.php
msgid "No alert recipients are currently configured; pending transitions are retained."
msgstr "Abekho abamukeli bezexwayiso abamisiwe njengamanje; izinguquko ezilindile zigciniwe."

#: doctor_scheduling.php
msgid "No retained alert is awaiting delivery. Mail-server acceptance does not prove inbox delivery."
msgstr "Asikho isexwayiso esigciniwe esilinde ukulethwa. Ukwamukelwa yiseva ye-imeyili akufakazeli ukulethwa ebhokisini lokungenayo."

#: doctor_scheduling.php
msgid "Doctor retained status changes (UTC). Repeated changes for one check are coalesced; an out-and-back transition is retained."
msgstr "Izinguquko zesimo ezigciniwe ze-Doctor (UTC). Izinguquko eziphindaphindiwe zokuhlolwa okukodwa ziyahlanganiswa; ushintsho oluya phambili luphinde lubuye luyagcinwa."

#: doctor_scheduling.php
#, php-format
msgid "%s: %s -> %s (latest change %s)"
msgstr "%s: %s -> %s (ushintsho lwakamuva %s)"

#: doctor_scheduling.php
#, php-format
msgid "%d further status changes are not listed because the alert queue reached its storage limit."
msgstr "Ezinye izinguquko zesimo ezingu-%d azibaliwe ohlwini ngoba ulayini wezexwayiso ufinyelele umkhawulo wawo wesitoreji."

#: doctor_scheduling.php
msgid "Open Utilities > Doctor for current measurements, recommended actions, and verification steps."
msgstr "Vula Izinsiza > Doctor ukuze uthole izilinganiso zamanje, izenzo ezinconywayo, kanye nezinyathelo zokuqinisekisa."

#: doctor_scheduling.php
#, php-format
msgid "Cacti Doctor: %d retained status changes"
msgstr "I-Cacti Doctor: izinguquko zesimo ezigciniwe ezingu-%d"

#: doctor_scheduling.php
msgid "Doctor schedule is already running or the database lock is unavailable."
msgstr "Uhlelo lwe-Doctor seluvele luyasebenza noma ukukhiya kwesizindalwazi akutholakali."

#: doctor_web.php
msgid "The finding could not be acknowledged. Run Doctor again, then acknowledge the current result."
msgstr "Okutholakele akukwazanga ukuvunywa. Sebenzisa i-Doctor futhi, bese uvuma umphumela wamanje."

#: doctor_web.php
msgid "The warning exception could not be saved. Use a fresh assessed warning, an owner, a reason and an expiry within 90 days."
msgstr "Okuhlukile kwesexwayiso akukwazanga ukulondolozwa. Sebenzisa isexwayiso esisha esihloliwe, umnikazi, isizathu kanye nosuku lokuphelelwa yisikhathi olungaphakathi kwezinsuku ezingu-90."

#: doctor_web.php
msgid "Confirm repair"
msgstr "Qinisekisa ukulungisa"

#: doctor_web.php
msgid "Approval expires after five minutes and is invalidated by a changed filesystem. The acting account must be able to create directories or change owner permissions."
msgstr "Imvume iphelelwa yisikhathi ngemva kwemizuzu emihlanu futhi ayisasebenzi uma uhlelo lwamafayela lushintshile. I-akhawunti esebenzayo kumele ikwazi ukudala izinhla zemibhalo noma ukushintsha izimvume zomnikazi."

#: doctor_web.php
msgid "Repair prerequisites are not met. No changes will be made."
msgstr "Izidingo zangaphambilini zokulungisa azihlangatshezwanga. Azikho izinguquko ezizokwenziwa."

#: doctor_web.php
