#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Доступные исправления: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Неизвестный формат %s. Используйте text, json, nagios или prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Маскирование данных не удалось завершить, поэтому файл %s не был записан."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "Записано в %s. Проверьте файл перед отправкой; значения после имён password, secret, token и community замаскированы."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Неизвестное исправление"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Исправление отклонено без флага --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Выберите поддерживаемый симптом и текстовый или JSON-вывод."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Принятое предупреждение"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Доступность устройств"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Не удалось оценить разрешения устройств."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "Настроенный PHP CLI не может запускать проверки Doctor."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Проверки Doctor завершились с ошибкой или превысили лимит времени. Проверьте журнал Doctor."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Графики перестали обновляться"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Медленный опрос"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Устройства отсутствуют или недоступны"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Оповещения Doctor отсутствуют"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Проверьте планировщик опросчика и журнал затронутого опросчика, затем убедитесь в завершении нового цикла."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "Возможно, сбор данных остановлен."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Возможно, собранные значения не записываются на диск."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Проверьте очередь вывода и журнал сброса Boost; убедитесь, что очередь очищается, а временные метки RRD обновляются."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Проверьте свободное место в хранилище, разрешения для каталога среды выполнения и последнее обновление RRD; учитывайте отложенную запись."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "Хранилище RRD требует проверки."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Возможно, сбор данных превышает отведённое время."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Сравните длительность цикла с интервалом опроса и проверьте таймауты устройств перед увеличением параллелизма."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Сравните счётчики базы данных во время медленного цикла и изучите планы запросов перед изменением ограничений сервера."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Возможно, нагрузка на базу данных замедляет опрос."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Возможно, не выполняются предварительные условия сбора данных или отсутствует доступность."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Проверьте разрешения, доступность, учётные данные и назначенный опросчик для затронутого устройства с помощью диагностики Cacti."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Запланированные проверки или доставка почты требуют внимания."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Проверьте настройки расписания и получателей, изучите сохранённые попытки доставки и отправьте тестовое письмо Cacti."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Возможные причины требуют проверки; совпадение результатов проверок не определяет первопричину."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Имеющиеся наблюдения не позволяют установить причину. Запустите новую диагностику и исследуйте симптом напрямую."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Не менее 24 часов с момента запуска сервера и FLUSH STATUS. Счётчики являются накопительными и могли сбрасываться в разное время; перед настройкой подтвердите тенденции при репрезентативной нагрузке."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "Рекомендации по настройке на основе накопительных счётчиков отложены: необходимо получить корректное время работы и не менее 24 часов с момента запуска и FLUSH STATUS. Отсутствующие метрики или несогласованная выборка не позволяют оценить состояние базы данных."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Окно наблюдения базы данных"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Метрики подключений недоступны или некорректны. Проверьте доступ к SHOW GLOBAL STATUS и SHOW GLOBAL VARIABLES; не считайте отсутствие метрик признаком простоя сервера."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Текущие подключения: %.0f / %.0f (%s); зафиксированный пик: %.0f (%s от текущего лимита)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Проверьте пул подключений и параллелизм опросчика. Перед увеличением max_connections оцените запас памяти на хосте базы данных; исторический пик может отражать прежний лимит."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Запас подключений"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Чтения буферного пула InnoDB"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Изучите планы запросов и рабочий набор данных. Изменяйте innodb_buffer_pool_size только после измерения доступной памяти на хосте базы данных; сама по себе накопительная доля промахов не доказывает нехватку памяти."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Временные таблицы на диске"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Изучите планы запросов, сортировку, группировку и типы данных временных таблиц перед изменением ограничений памяти. Некоторые таблицы неизбежно создаются на диске; ограничения памяти и их учёт различаются между версиями MySQL и MariaDB."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Создание потоков подключений"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Проверьте повторное использование подключений и параметр thread_cache_size. Перед настройкой проверьте режим обработки потоков на сервере; реализации с пулом потоков ведут себя иначе, чем серверы с моделью один-поток-на-подключение."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Изучите журнал медленных запросов, long_query_time и планы запросов перед изменением буферов сервера. Этот счётчик зависит от настроенного порога медленных запросов и не указывает на конкретные запросы."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Медленные запросы"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Рекомендации по накопительным метрикам отложены до накопления достаточного окна наблюдения."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "Рекомендации по кэшу потоков не оцениваются: параметр thread_handling недоступен или не использует режим one-thread-per-connection. Вместо этого проверьте активную реализацию пула потоков."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Необходимые счётчики отсутствуют или некорректны: %s, %s. Проверьте поддержку версией сервера и разрешения на мониторинг."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "С момента предыдущей выборки произошёл сброс счётчика; перед настройкой соберите данные за другой репрезентативный интервал."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Недостаточная активность: %.0f %s; для этой рекомендации требуется не менее %d наблюдений."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Счётчики несогласованы или были сброшены независимо друг от друга. Перед настройкой соберите новую репрезентативную выборку."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "Интервальная выборка слишком мала или счётчики были сброшены; перед настройкой соберите данные за другой репрезентативный интервал."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "За интервал %s / %s: %.0f / %.0f (%s); порог для анализа: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Накопительно %s / %s: %.0f / %.0f (%s); порог для анализа: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Этот счётчик в MySQL может не учитывать временные файлы с отображением в память (mmap); низкое значение не исключает использование диска."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "Рекомендации по журналу повторов (redo log) отложены до накопления достаточного окна наблюдения и доступности Innodb_log_waits."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Накопительное значение Innodb_log_waits: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Исследуйте размер транзакций, нагрузку на буфер журнала и задержки хранилища. Перепроверьте частоту событий под нагрузкой перед изменением innodb_log_buffer_size; это историческое значение не свидетельствует о текущей блокировке."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Ожидания буфера журнала InnoDB"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "установленный файл composer.json Cacti"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "требование установщика Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "Совместимость PHP с установленным Cacti"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Используется PHP %s; установленный Cacti %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Не удалось определить требования Cacti к версии PHP. Проверьте установленный файл composer.json Cacti или документацию к выпуску; Doctor не предполагает совместимость по умолчанию."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s и < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Требуется %s (%s). Текущая версия PHP соответствует этому требованию."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Требуется %s (%s). Текущая версия PHP не соответствует этому требованию."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Обнаружена версия %s; для работы Doctor требуется Cacti 1.2.20 или новее."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Поддерживаемая версия Cacti"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Официальная поддержка безопасности PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Проверяется ветка выпуска PHP, а не актуальность конкретного патч-релиза или наличие бэкпортов исправлений от поставщика ОС. Совместимость с Cacti проверяется отдельно."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Используется PHP %s; статус официальной поддержки безопасности неизвестен либо это предварительный выпуск. Проверьте https://www.php.net/supported-versions.php и обновите данные поддержки Doctor."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Используется PHP %s; ветка PHP %s получает официальные исправления безопасности до %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Используется PHP %s; ветка PHP %s больше не получает официальных исправлений безопасности; поддержка завершилась %s. Обновитесь до поддерживаемой ветки PHP, совместимой с вашей установкой Cacti, или уточните наличие поддержки безопасности у поставщика ОС."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Обязательные расширения текущего CLI PHP"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Обязательные расширения веб-PHP"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Отсутствуют: %s. Установите их через менеджер пакетов операционной системы."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Все расширения PHP, требуемые установщиком Cacti, загружены в данном контексте PHP."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "Doctor не запускает настроенные исполняемые файлы при работе с правами root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "Имя файла %s не соответствует ожидаемому для %s, поэтому Doctor не стал его запускать."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "Doctor запущен с правами root, поэтому проверки разрешений относятся к пользователю root, а не к учётной записи веб-сервера или опросчика, настроенные исполняемые файлы не запускаются, а операции исправления отклоняются. Запустите Doctor от имени пользователя опросчика Cacti."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Привилегии Doctor"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "Doctor запущен без привилегий root."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Обязательные расширения CLI PHP"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Настроенный исполняемый файл PHP CLI недоступен, поэтому проверить его расширения невозможно."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "Функция shell_exec() отключена, поэтому Doctor не может сравнить расширения CLI PHP с требованиями Cacti."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "Настроенный исполняемый файл PHP CLI не вернул корректный список расширений."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "Отсутствуют в CLI PHP: %s. Во многих системах конфигурации веб-PHP и CLI PHP разделены."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "В настроенном PHP CLI присутствуют все расширения, требуемые Cacti."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "поддержка GD TrueType"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Рекомендуемые возможности PHP"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Недоступно: %s. Cacti может работать без этих возможностей, но связанная функциональность может быть ограничена."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "Дополнительные возможности gettext, SNMP и GD TrueType доступны."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "memory_limit равен %s (рекомендуется %dM или больше)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "max_execution_time составляет %d сек. (рекомендуется 60 или больше)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "date.timezone не задан"

#: doctor_functions.php
msgid "unset"
msgstr "не задано"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Текущие значения: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "Конфигурация среды выполнения PHP"

#: doctor_functions.php
msgid "Database connection"
msgstr "Подключение к базе данных"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
msgstr "Ошибка выполнения запроса: %s"

#: doctor_functions.php
msgid "A read-only query completed successfully."
msgstr "Запрос только для чтения выполнен успешно."

#: doctor_functions.php
msgid "The database returned an unexpected result."
msgstr "База данных вернула неожиданный результат."

#: doctor_functions.php
#, php-format
msgid "Doctor could not determine the database server version from %s."
msgstr "Doctor не удалось определить версию сервера базы данных из %s."

#: doctor_functions.php
msgid "Supported database server"
msgstr "Поддерживаемый сервер базы данных"

#: doctor_functions.php
#, php-format
