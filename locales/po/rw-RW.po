msgstr "Tanga umuburo nyuma y'iyi mibare y'intera zo gukusanya nta ivugururwa rya dosiye (1 kugeza kuri 100)."

#: setup.php
msgid "Additional disk-write delay for external caching (0 to 86400). Boost adds its own allowance."
msgstr "Ubukererwe bwiyongera bwo kwandika kuri disiki ku bubiko bw'agateganyo bwo hanze (0 kugeza kuri 86400). Boost yongeraho igihe cyayo cyihariwe."

#: setup.php
msgid "Deferred RRD Write Allowance (seconds)"
msgstr "Igihe cyemewe cyo gutinza kwandika RRD (amasegonda)"

