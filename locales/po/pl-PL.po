#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Dostępne naprawy: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Nieznany format %s. Użyj text, json, nagios lub prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Nie udało się ukończyć maskowania danych, więc plik %s nie został zapisany."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "Zapisano %s. Sprawdź zawartość przed udostępnieniem; wartości po nazwach password, secret, token i community są zamaskowane."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Nieznana naprawa"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Odmowa wykonania naprawy bez flagi --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Wybierz obsługiwany objaw oraz format wyjściowy text lub JSON."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Zaakceptowane ostrzeżenie"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Dostępność urządzenia"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Nie udało się ocenić uprawnień urządzenia."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "Skonfigurowane środowisko PHP CLI nie może uruchamiać testów Doctor."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Testy Doctor nie powiodły się lub przekroczyły limit czasu. Sprawdź dziennik Doctor."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Wykresy przestały się aktualizować"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Odpytywanie działa wolno"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Brakuje urządzeń lub są one niedostępne"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Brak alertów Doctor"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Sprawdź harmonogram pollera oraz dziennik odpowiedniego pollera, a następnie zweryfikuj nowy ukończony cykl."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "Zbieranie danych mogło zostać zatrzymane."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Zebrane wartości mogą nie być zapisywane na dysk."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Sprawdź kolejkę wyjściową oraz historię opróżniania Boost; zweryfikuj, czy kolejka się opróżnia i czy znaczniki czasu RRD posuwają się naprzód."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Sprawdź pojemność pamięci masowej, uprawnienia katalogów środowiska wykonawczego oraz ostatnią aktualizację RRD; uwzględnij odroczone zapisy."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "Magazyn RRD wymaga zbadania."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Zbieranie danych może przekraczać przydzielony budżet czasu."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Porównaj czas trwania cyklu z interwałem odpytywania i sprawdź limity czasu urządzeń przed zwiększeniem współbieżności."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Porównaj liczniki bazy danych podczas wolnego cyklu i sprawdź plany zapytań przed zmianą limitów serwera."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Obciążenie bazy danych może przyczyniać się do spowolnienia odpytywania."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Wymagania wstępne zbierania danych lub osiągalność mogą zawodzić."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Zweryfikuj uprawnienia, osiągalność, dane uwierzytelniające oraz przypisany poller odpowiedniego urządzenia za pomocą diagnostyki Cacti."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Zaplanowane sprawdzenia lub dostarczanie poczty wymagają uwagi."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Zweryfikuj ustawienia harmonogramu i odbiorców, sprawdź zachowane próby dostarczenia oraz wyślij testową wiadomość e-mail z Cacti."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Możliwe przyczyny wymagają weryfikacji; pasujące sprawdzenia nie przesądzają o przyczynie źródłowej."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Dostępne obserwacje nie wskazują żadnej przyczyny. Uruchom nową diagnostykę i zbadaj objaw bezpośrednio."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Co najmniej 24 godziny od uruchomienia serwera i wykonania FLUSH STATUS. Liczniki są kumulatywne i mogą mieć różną historię resetowania; potwierdź trendy podczas reprezentatywnego obciążenia przed dostrajaniem."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "Porady dotyczące dostrajania na podstawie wartości kumulatywnych zostały odroczone: uzyskaj prawidłowy czas pracy i co najmniej 24 godziny od uruchomienia oraz FLUSH STATUS. Brakujące metryki lub niespójna próbka nie pozwalają ocenić kondycji bazy danych."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Okno obserwacji bazy danych"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Metryki połączeń są niedostępne lub nieprawidłowe. Sprawdź dostęp do SHOW GLOBAL STATUS i SHOW GLOBAL VARIABLES; nie traktuj brakujących metryk jako oznaki bezczynności serwera."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Bieżące połączenia: %.0f / %.0f (%s); zarejestrowany szczyt: %.0f (%s bieżącego limitu)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Przejrzyj pulowanie połączeń i współbieżność pollera. Sprawdź zapas pamięci hosta bazy danych przed zwiększeniem max_connections; historyczny szczyt może odzwierciedlać starszy limit."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Pojemność połączeń"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Odczyty z puli buforów InnoDB"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Przejrzyj plany zapytań i zbiór roboczy. Rozważ zmianę innodb_buffer_pool_size dopiero po zmierzeniu dostępnej pamięci na hoście bazy danych; sam kumulatywny współczynnik chybień nie dowodzi presji pamięciowej."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Tabele tymczasowe na dysku"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Przejrzyj plany zapytań, sortowanie, grupowanie i typy danych tabel tymczasowych przed zmianą limitów pamięci. Niektóre tabele muszą korzystać z dysku; limity pamięci i sposób ich rozliczania różnią się między wersjami MySQL i MariaDB."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Tworzenie wątków połączeń"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Przejrzyj ponowne użycie połączeń i thread_cache_size. Sprawdź tryb obsługi wątków serwera przed dostrajaniem; implementacje puli wątków nie zachowują się jak serwery z jednym wątkiem na połączenie."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Przejrzyj rejestrowanie wolnych zapytań, long_query_time i plany zapytań przed zmianą buforów serwera. Ten licznik zależy od skonfigurowanego progu wolnych zapytań i nie identyfikuje pojedynczych instrukcji."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Wolne instrukcje"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Porady kumulatywne odroczone do czasu osiągnięcia wystarczającego okna obserwacji."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "Porada dotycząca pamięci podręcznej wątków nie jest oceniana: opcja thread_handling jest niedostępna lub nie ma wartości one-thread-per-connection. Zamiast tego przejrzyj aktywną implementację puli wątków."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Wymagane liczniki są brakujące lub nieprawidłowe: %s, %s. Sprawdź obsługę wersji serwera i uprawnienia monitorowania."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "Licznik został zresetowany od poprzedniej próbki; zbierz kolejny reprezentatywny interwał przed dostrajaniem."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Niewystarczająca aktywność: %.0f %s; minimalna liczba obserwacji dla tej porady to %d."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Liczniki są niespójne lub zostały zresetowane niezależnie. Zbierz nową reprezentatywną próbkę przed dostrajaniem."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "Próbka interwału jest zbyt mała lub liczniki zostały zresetowane; zbierz kolejny reprezentatywny interwał przed dostrajaniem."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Interwał %s / %s: %.0f / %.0f (%s); próg wymagający zbadania: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Kumulatywnie %s / %s: %.0f / %.0f (%s); próg wymagający zbadania: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Ten licznik może pomijać pliki tymczasowe mapowane w pamięci w MySQL; niski współczynnik nie wyklucza użycia dysku."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "Porada dotycząca dziennika redo odroczona do czasu osiągnięcia wystarczającego okna obserwacji i dostępności Innodb_log_waits."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Kumulatywna wartość Innodb_log_waits: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Zbadaj rozmiary transakcji, obciążenie bufora dziennika i opóźnienia pamięci masowej. Sprawdź ponownie wskaźnik pod obciążeniem przed rozważeniem zmiany innodb_log_buffer_size; ta historyczna wartość nie dowodzi bieżącego zastoju."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Oczekiwania bufora dziennika InnoDB"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "zainstalowany plik composer.json Cacti"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "Wymaganie instalatora Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "Zgodność PHP z zainstalowanym Cacti"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Uruchomiono PHP %s; zainstalowano Cacti %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Nie można ustalić wymagań Cacti dotyczących wersji PHP. Sprawdź zainstalowany plik composer.json Cacti lub dokumentację wydania; Doctor nie zakłada zgodności."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s i < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Wymaga %s (%s). Uruchomiona wersja PHP spełnia to wymaganie."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Wymaga %s (%s). Uruchomiona wersja PHP nie spełnia tego wymagania."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Wykryto %s; Doctor wymaga Cacti 1.2.20 lub nowszego."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Obsługiwana wersja Cacti"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Wsparcie bezpieczeństwa upstream PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Sprawdza to gałąź wydania PHP, a nie to, czy ta wersja poprawkowa jest aktualna lub czy dostawca systemu operacyjnego przenosi poprawki wstecz. Zgodność z Cacti jest sprawdzana osobno."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Uruchomiono PHP %s; status wsparcia bezpieczeństwa upstream jest nieznany lub jest to wersja przedpremierowa. Sprawdź https://www.php.net/supported-versions.php i zaktualizuj dane wsparcia Doctor."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Uruchomiono PHP %s; wersja PHP %s otrzymuje poprawki bezpieczeństwa upstream do %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Uruchomiono PHP %s; wersja PHP %s nie otrzymuje już poprawek bezpieczeństwa upstream; wsparcie zakończyło się %s. Zaktualizuj do obsługiwanej gałęzi PHP zgodnej z instalacją Cacti lub potwierdź utrzymanie bezpieczeństwa u dostawcy systemu operacyjnego."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Wymagane bieżące rozszerzenia CLI PHP"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Wymagane rozszerzenia webowe PHP"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Brakujące: %s. Zainstaluj je za pomocą menedżera pakietów systemu operacyjnego."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Wszystkie rozszerzenia PHP wymagane przez instalator Cacti są załadowane w tym kontekście PHP."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "Doctor nie uruchamia skonfigurowanych plików binarnych podczas działania jako root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "Nazwa pliku %s jest nieoczekiwana dla %s, więc Doctor go nie uruchomił."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "Doctor działa jako root, więc sprawdzenia uprawnień dotyczą użytkownika root zamiast konta serwera WWW lub pollera, skonfigurowane pliki binarne nie są uruchamiane, a naprawy są odrzucane. Uruchom Doctor jako użytkownik pollera Cacti."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Uprawnienia Doctor"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "Doctor działa bez uprawnień root."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Wymagane rozszerzenia CLI PHP"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Skonfigurowany plik wykonywalny PHP CLI jest niedostępny, więc nie można sprawdzić jego rozszerzeń."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "Funkcja shell_exec() jest wyłączona, więc Doctor nie może porównać rozszerzeń PHP CLI z wymaganiami Cacti."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "Skonfigurowany plik wykonywalny PHP CLI nie zwrócił prawidłowej listy rozszerzeń."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "Brakuje w CLI PHP: %s. Konfiguracje webowe i CLI PHP są w wielu systemach oddzielne."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "Skonfigurowane PHP CLI ma wszystkie rozszerzenia wymagane przez Cacti."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "Obsługa GD TrueType"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Zalecane funkcje PHP"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Niedostępne: %s. Cacti może działać bez tych funkcji, ale powiązana funkcjonalność może być ograniczona."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "Opcjonalne funkcje gettext, SNMP i GD TrueType są dostępne."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "memory_limit wynosi %s (zalecane %dM lub więcej)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "max_execution_time wynosi %d s (zalecane 60 lub więcej)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "date.timezone nie jest ustawione"

#: doctor_functions.php
msgid "unset"
msgstr "nieustawione"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Bieżące wartości: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "Konfiguracja środowiska uruchomieniowego PHP"

#: doctor_functions.php
msgid "Database connection"
msgstr "Połączenie z bazą danych"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
msgstr "Zapytanie nie powiodło się: %s"

#: doctor_functions.php
msgid "A read-only query completed successfully."
msgstr "Zapytanie tylko do odczytu zakończyło się pomyślnie."

#: doctor_functions.php
msgid "The database returned an unexpected result."
msgstr "Baza danych zwróciła nieoczekiwany wynik."

#: doctor_functions.php
#, php-format
msgid "Doctor could not determine the database server version from %s."
msgstr "Doctor nie mógł określić wersji serwera bazy danych na podstawie %s."

#: doctor_functions.php
msgid "Supported database server"
msgstr "Obsługiwany serwer bazy danych"

#: doctor_functions.php
#, php-format
msgid "%s %s detected; this Cacti branch recommends %s %s or newer."
msgstr "Wykryto %s %s; ta gałąź Cacti zaleca %s %s lub nowszy."

#: doctor_functions.php
#, php-format
msgid "Database character set is %s and collation is %s. Cacti requires utf8mb4."
msgstr "Zestaw znaków bazy danych to %s, a sortowanie (collation) to %s. Cacti wymaga utf8mb4."

#: doctor_functions.php
msgid "unknown"
msgstr "nieznany"

#: doctor_functions.php
msgid "Database character set"
msgstr "Zestaw znaków bazy danych"

#: doctor_functions.php
msgid "Database timezone support"
msgstr "Obsługa stref czasowych bazy danych"

#: doctor_functions.php
msgid "The Cacti database account cannot read mysql.time_zone_name. Grant SELECT access and populate the database timezone tables."
msgstr "Konto bazy danych Cacti nie może odczytać tabeli mysql.time_zone_name. Nadaj uprawnienie SELECT i wypełnij tabele stref czasowych bazy danych."

#: doctor_functions.php
#, php-format
msgid "The database timezone table is accessible and contains %d entries."
msgstr "Tabela stref czasowych bazy danych jest dostępna; liczba wpisów: %d."

#: doctor_functions.php
msgid "The database timezone table is accessible but empty. Populate the system timezone tables."
msgstr "Tabela stref czasowych bazy danych jest dostępna, ale pusta. Wypełnij systemowe tabele stref czasowych."

#: doctor_functions.php
msgid "Core tables used by Cacti are present."
msgstr "Podstawowe tabele używane przez Cacti są obecne."

#: doctor_functions.php
#, php-format
