msgstr "%s: %s -> %s (ostatnia zmiana %s)"

#: doctor_scheduling.php
#, php-format
msgid "%d further status changes are not listed because the alert queue reached its storage limit."
msgstr "Kolejne zmiany stanu (%d) nie zostały wymienione, ponieważ kolejka alertów osiągnęła limit pojemności."

#: doctor_scheduling.php
msgid "Open Utilities > Doctor for current measurements, recommended actions, and verification steps."
msgstr "Otwórz Narzędzia > Doctor, aby zobaczyć bieżące pomiary, zalecane działania i kroki weryfikacji."

