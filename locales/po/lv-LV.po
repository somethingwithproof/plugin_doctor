#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Pieejamie labojumi: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Nezināms formāts %s. Izmantojiet text, json, nagios vai prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Sensitīvo datu maskēšana neizdevās, tāpēc %s netika ierakstīts."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "Ierakstīts %s. Pārskatiet to pirms kopīgošanas; vērtības aiz paroles, noslēpuma, marķiera un kopienas nosaukumiem ir maskētas."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Nezināms labojums"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Labošana tiek atteikta bez --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Izvēlieties atbalstītu simptomu un teksta vai JSON izvadi."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Pieņemts brīdinājums"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Ierīču pieejamība"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Ierīču atļaujas nevarēja novērtēt."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "Konfigurētais PHP CLI nevar izpildīt Doctor pārbaudes."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Doctor pārbaudes neizdevās vai pārsniedza laika ierobežojumu. Pārskatiet Doctor žurnālu."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Grafiki pārstāja atjaunināties"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Aptauja ir lēna"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Ierīces trūkst vai nav pieejamas"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Trūkst Doctor paziņojumu"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Pārbaudiet aptaujātāja plānotāju un skartā aptaujātāja žurnālu, pēc tam pārliecinieties par jaunu pabeigtu ciklu."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "Datu vākšana, iespējams, ir apstājusies."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Savāktās vērtības, iespējams, nenonāk līdz diskam."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Pārbaudiet izvades rindu un Boost ierakstīšanas vēsturi; pārliecinieties, ka rinda iztukšojas un RRD laika zīmogi virzās uz priekšu."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Pārbaudiet krātuves ietilpību, izpildes direktoriju atļaujas un pēdējo RRD atjauninājumu; ņemiet vērā atlikto ierakstīšanu."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "RRD krātuve jāizmeklē."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Datu vākšanas darbs, iespējams, pārsniedz tam atvēlēto laiku."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Pirms palielināt paralēlismu, salīdziniet cikla ilgumu ar aptaujas intervālu un pārbaudiet ierīču noildzes."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Pirms mainīt servera ierobežojumus, salīdziniet datubāzes skaitītājus lēna cikla laikā un pārbaudiet vaicājumu plānus."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Datubāzes noslodze, iespējams, veicina lēnu aptauju."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Datu vākšanas priekšnosacījumi vai sasniedzamība, iespējams, nestrādā."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Izmantojot Cacti diagnostiku, pārbaudiet skartās ierīces atļaujas, sasniedzamību, akreditācijas datus un piešķirto aptaujātāju."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Ieplānotajām pārbaudēm vai pasta piegādei nepieciešama uzmanība."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Pārbaudiet plānošanas un adresātu iestatījumus, pārskatiet saglabātos piegādes mēģinājumus un nosūtiet Cacti testa e-pastu."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Iespējamie cēloņi jāpārbauda; atbilstošas pārbaudes nenosaka pamatcēloni."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Pieejamie novērojumi nenosaka cēloni. Palaidiet svaigu diagnostiku un izmeklējiet simptomu tieši."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Ir pagājušas vismaz 24 stundas kopš servera palaišanas un FLUSH STATUS. Skaitītāji ir kumulatīvi un var būt atiestatīti dažādos laikos; pirms pielāgošanas apstipriniet tendences tipiskas slodzes apstākļos."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "Kumulatīvie pielāgošanas ieteikumi ir atlikti: nepieciešams derīgs darbības laiks un vismaz 24 stundas kopš palaišanas un FLUSH STATUS. Trūkstoši rādītāji vai nekonsekvents paraugs nevar noteikt datubāzes stāvokli."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Datubāzes novērošanas logs"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Savienojumu rādītāji nav pieejami vai nav derīgi. Pārbaudiet piekļuvi SHOW GLOBAL STATUS un SHOW GLOBAL VARIABLES; neuzskatiet trūkstošus rādītājus par dīkstāvē esošu serveri."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Pašreizējie savienojumi: %.0f / %.0f (%s); reģistrētais maksimums: %.0f (%s no pašreizējā limita)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Pārskatiet savienojumu pūlu un aptaujātāja paralēlismu. Pirms palielināt max_connections, pārbaudiet datubāzes resursdatora atmiņas rezervi; vēsturiskais maksimums var atspoguļot vecāku limitu."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Savienojumu ietilpība"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "InnoDB buferpūla lasījumi"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Pārskatiet vaicājumu plānus un darba kopu. Apsveriet innodb_buffer_pool_size tikai pēc pieejamās atmiņas izmērīšanas datubāzes resursdatorā; kumulatīvā netrāpījumu attiecība vien nepierāda atmiņas trūkumu."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Pagaidu tabulas uz diska"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Pirms mainīt atmiņas ierobežojumus, pārskatiet vaicājumu plānus, kārtošanu, grupēšanu un pagaidu tabulu datu tipus. Dažām tabulām jāizmanto disks; atmiņas ierobežojumi un uzskaite atšķiras starp MySQL un MariaDB versijām."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Savienojumu pavedienu izveide"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Pārskatiet savienojumu atkārtotu izmantošanu un thread_cache_size. Pirms pielāgošanas pārbaudiet servera pavedienu apstrādes režīmu; pavedienu pūla implementācijas nedarbojas tāpat kā one-thread-per-connection serveri."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Pirms mainīt servera buferus, pārskatiet lēno vaicājumu reģistrēšanu, long_query_time un vaicājumu plānus. Šis skaitītājs ir atkarīgs no konfigurētā lēno vaicājumu sliekšņa un neidentificē atsevišķus priekšrakstus."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Lēni vaicājumi"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Kumulatīvie ieteikumi ir atlikti, līdz novērošanas logs būs pietiekams."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "Pavedienu kešatmiņas ieteikums netiek novērtēts: thread_handling nav pieejams vai nav one-thread-per-connection. Tā vietā pārskatiet aktīvo pavedienu pūla implementāciju."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Trūkst vai nav derīgi nepieciešamie skaitītāji: %s, %s. Pārbaudiet servera versijas atbalstu un uzraudzības atļaujas."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "Kopš iepriekšējā parauga skaitītājs tika atiestatīts; pirms pielāgošanas savāciet citu reprezentatīvu intervālu."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Nepietiekama aktivitāte: %.0f %s; šim ieteikumam nepieciešami vismaz %d novērojumi."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Skaitītāji ir nekonsekventi vai tika atiestatīti neatkarīgi. Pirms pielāgošanas savāciet jaunu reprezentatīvu paraugu."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "Intervāla paraugs ir pārāk mazs vai skaitītāji tika atiestatīti; pirms pielāgošanas savāciet citu reprezentatīvu intervālu."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Intervāls %s / %s: %.0f / %.0f (%s); izmeklēšanas slieksnis: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Kumulatīvais %s / %s: %.0f / %.0f (%s); izmeklēšanas slieksnis: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Šis skaitītājs MySQL var neiekļaut atmiņā kartētus pagaidu failus; zema attiecība neizslēdz diska izmantošanu."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "Atkārtošanas žurnāla ieteikums ir atlikts, līdz novērošanas logs būs pietiekams un Innodb_log_waits būs pieejams."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Kumulatīvais Innodb_log_waits: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Izmeklējiet transakciju izmērus, žurnāla bufera noslodzi un krātuves latentumu. Pirms apsverat innodb_log_buffer_size, vēlreiz pārbaudiet ātrumu slodzes apstākļos; šis vēsturiskais skaits nav pierādījums pašreizējai aizkavei."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "InnoDB žurnāla bufera gaidīšanas"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "instalētā Cacti composer.json"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "Cacti %s instalētāja prasība"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "PHP saderība ar instalēto Cacti"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Darbojas PHP %s; instalēts Cacti %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Nevarēja noteikt Cacti PHP prasību. Pārbaudiet instalētā Cacti composer.json vai laidiena dokumentāciju; Doctor nepieņem saderību automātiski."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s un < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Nepieciešams %s (%s). Darbojošais PHP atbilst šai prasībai."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Nepieciešams %s (%s). Darbojošais PHP neatbilst šai prasībai."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Konstatēts %s; Doctor nepieciešams Cacti 1.2.20 vai jaunāka versija."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Atbalstīta Cacti versija"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "PHP augšstraumes drošības atbalsts"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Tas pārbauda PHP laidiena zaru, nevis to, vai šis ielāpa laidiens ir aktuāls vai jūsu operētājsistēmas piegādātājs pārnes labojumus. Saderība ar Cacti tiek pārbaudīta atsevišķi."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Darbojas PHP %s; augšstraumes drošības atbalsta statuss nav zināms vai tas ir priekšlaidums. Pārbaudiet https://www.php.net/supported-versions.php un atjauniniet Doctor atbalsta datus."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Darbojas PHP %s; PHP %s saņem augšstraumes drošības labojumus līdz %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Darbojas PHP %s; PHP %s vairs nesaņem augšstraumes drošības labojumus; atbalsts beidzās %s. Jauniniet uz atbalstītu PHP zaru, kas ir saderīgs ar jūsu Cacti instalāciju, vai apstipriniet drošības uzturēšanu pie sava operētājsistēmas piegādātāja."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Nepieciešamie pašreizējā CLI PHP paplašinājumi"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Nepieciešamie tīmekļa PHP paplašinājumi"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Trūkst: %s. Instalējiet tos ar operētājsistēmas pakotņu pārvaldnieku."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Šajā PHP kontekstā ir ielādēti visi Cacti instalētājam nepieciešamie PHP paplašinājumi."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "Doctor neizpilda konfigurētos izpildāmos failus, darbojoties kā root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "Faila nosaukums %s nav gaidīts priekš %s, tāpēc Doctor to neizpildīja."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "Doctor darbojas kā root, tāpēc atļauju pārbaudes attiecas uz root, nevis uz tīmekļa servera vai aptaujātāja kontu, konfigurētie izpildāmie faili netiek palaisti un labojumi tiek atteikti. Palaidiet Doctor kā Cacti aptaujātāja lietotājs."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Doctor privilēģijas"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "Doctor darbojas bez root privilēģijām."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Nepieciešamie CLI PHP paplašinājumi"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Konfigurētais PHP CLI izpildāmais fails nav pieejams, tāpēc tā paplašinājumus nevar pārbaudīt."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "shell_exec() ir atspējots, tāpēc Doctor nevar salīdzināt CLI PHP paplašinājumus ar Cacti prasībām."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "Konfigurētais PHP CLI izpildāmais fails neatgrieza derīgu paplašinājumu sarakstu."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "CLI PHP trūkst: %s. Daudzās sistēmās tīmekļa un CLI PHP konfigurācijas ir atsevišķas."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "Konfigurētajam PHP CLI ir visi Cacti nepieciešamie paplašinājumi."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "GD TrueType atbalsts"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Ieteicamās PHP iespējas"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Nav pieejams: %s. Cacti var darboties bez šīm iespējām, taču saistītā funkcionalitāte var būt ierobežota."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "Neobligātās gettext, SNMP un GD TrueType iespējas ir pieejamas."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "memory_limit ir %s (ieteicams %dM vai vairāk)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "max_execution_time ir %d sekundes (ieteicams 60 vai vairāk)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "date.timezone nav iestatīts"

#: doctor_functions.php
msgid "unset"
msgstr "nav iestatīts"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Pašreizējās vērtības: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "PHP izpildlaika konfigurācija"

#: doctor_functions.php
msgid "Database connection"
msgstr "Datubāzes savienojums"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
msgstr "Vaicājums neizdevās: %s"

#: doctor_functions.php
msgid "A read-only query completed successfully."
msgstr "Tikai lasāms vaicājums tika veiksmīgi pabeigts."

#: doctor_functions.php
msgid "The database returned an unexpected result."
msgstr "Datubāze atgrieza neparedzētu rezultātu."

#: doctor_functions.php
#, php-format
msgid "Doctor could not determine the database server version from %s."
msgstr "Doctor nevarēja noteikt datubāzes servera versiju no %s."

#: doctor_functions.php
msgid "Supported database server"
msgstr "Atbalstīts datubāzes serveris"

#: doctor_functions.php
#, php-format
msgid "%s %s detected; this Cacti branch recommends %s %s or newer."
msgstr "Konstatēts %s %s; šis Cacti zars iesaka %s %s vai jaunāku versiju."

#: doctor_functions.php
#, php-format
msgid "Database character set is %s and collation is %s. Cacti requires utf8mb4."
msgstr "Datubāzes rakstzīmju kopa ir %s un kārtošanas secība ir %s. Cacti nepieciešams utf8mb4."

#: doctor_functions.php
msgid "unknown"
msgstr "nezināms"

#: doctor_functions.php
msgid "Database character set"
msgstr "Datubāzes rakstzīmju kopa"

#: doctor_functions.php
msgid "Database timezone support"
msgstr "Datubāzes laika joslu atbalsts"

#: doctor_functions.php
msgid "The Cacti database account cannot read mysql.time_zone_name. Grant SELECT access and populate the database timezone tables."
msgstr "Cacti datubāzes konts nevar lasīt mysql.time_zone_name. Piešķiriet SELECT piekļuvi un aizpildiet datubāzes laika joslu tabulas."

#: doctor_functions.php
#, php-format
msgid "The database timezone table is accessible and contains %d entries."
msgstr "Datubāzes laika joslu tabula ir pieejama un satur %d ierakstus."

#: doctor_functions.php
msgid "The database timezone table is accessible but empty. Populate the system timezone tables."
