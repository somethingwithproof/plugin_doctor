msgid "Doctor alert transitions are invalid; no email was sent."
msgstr "Iinguqu zezilumkiso ze-Doctor azisebenzi; akukho i-imeyile ithunyelweyo."

#: doctor_scheduling.php
msgid "Alert delivery"
msgstr "Ukuthunyelwa kwezilumkiso"

#: doctor_scheduling.php
#, php-format
msgid "%d check transitions await delivery; attempts: %d of 3."
msgstr "Iinguqu zovavanyo eziyi-%d zilinde ukuthunyelwa; iinzame: %d kwezi-3."

#: doctor_scheduling.php
msgid "Automatic retries exhausted. Correct Cacti mail settings, then run Doctor with --scheduled --retry-alerts as the poller user."
msgstr "Iinzame ezizenzekelayo ziphelile. Lungisa iisetingi ze-imeyile ze-Cacti, uze usebenzise i-Doctor nge --scheduled --retry-alerts njengomsebenzisi we-poller."

#: doctor_scheduling.php
#, php-format
msgid "Next eligible retry: %s UTC, after a primary poller cycle."
msgstr "Uzamo olulandelayo olufanelekileyo: %s UTC, emva komjikelo we-poller eyintloko."

#: doctor_scheduling.php
msgid "No alert recipients are currently configured; pending transitions are retained."
msgstr "Akukho bamkeli bezilumkiso abaqwalaselweyo ngoku; iinguqu ezilindileyo zigciniwe."

#: doctor_scheduling.php
msgid "No retained alert is awaiting delivery. Mail-server acceptance does not prove inbox delivery."
msgstr "Akukho silumkiso sigciniweyo esilinde ukuthunyelwa. Ukwamkelwa yiseva ye-imeyile akuqinisekisi ukufika kwi-inbox."

#: doctor_scheduling.php
msgid "Doctor retained status changes (UTC). Repeated changes for one check are coalesced; an out-and-back transition is retained."
msgstr "Iinguqu zemo ezigciniweyo ze-Doctor (UTC). Iinguqu eziphindaphindiweyo zovavanyo olunye ziyadityaniswa; inguqu yokuphuma nokubuya iyagcinwa."

#: doctor_scheduling.php
#, php-format
