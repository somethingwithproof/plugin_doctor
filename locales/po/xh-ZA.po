#: doctor_rrd.php
msgid "RRD update freshness"
msgstr "Ukuhlaziyeka kohlaziyo lwe-RRD"

#: doctor_rrd.php
msgid "The deferred-write interval is unknown; configure it before judging file age."
msgstr "Isithuba sokubhala okulibazisekileyo asaziwa; siqwalasele phambi kokuvavanya ixesha ukususela kuhlaziyo lokugqibela lwefayile."

#: doctor_rrd.php
#, php-format
msgid "Checked %d files; %d stale files across %d devices; %d unavailable or future-dated files."
msgstr "Kukhangelwe iifayile eziyi-%d; iifayile eziphelelwe lixesha eziyi-%d kwizixhobo eziyi-%d; iifayile ezingafumanekiyo okanye ezinomhla wexesha elizayo eziyi-%d."

#: doctor_rrd.php
msgid "File age includes the collection interval and configured deferred-write allowance; verify the poller and flush process before changing data."
msgstr "Ixesha ukususela kuhlaziyo lokugqibela lwefayile liquka isithuba sokuqokelela kunye nesibonelelo sokubhala okulibazisekileyo esiqwalaselweyo; qinisekisa i-poller kunye nenkqubo yokukhupha phambi kokutshintsha idatha."

#: doctor_scheduling.php
msgid "Scheduled checks are disabled. Enable them in Settings > Doctor to retain samples and alert on changes."
msgstr "Uvavanyo olucwangcisiweyo lukhubaziwe. Luvumele kwi-Iisetingi > Doctor ukugcina iisampulu kunye nokulumkisa ngeenguqu."

#: doctor_scheduling.php
msgid "Scheduled report freshness"
msgstr "Ukuhlaziyeka kwengxelo ecwangcisiweyo"

#: doctor_scheduling.php
#, php-format
msgid "%s UTC"
msgstr "%s UTC"

