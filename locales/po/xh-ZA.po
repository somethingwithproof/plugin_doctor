#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Ukulungiswa okufumanekayo: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Ifomathi engaziwayo %s. Sebenzisa i-text, json, nagios, okanye prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Ukucinywa kweenkcukacha eziyimfihlo akukwazanga kugqitywa, ngoko ke %s ayibhalwanga."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "Kubhalwe %s. Yijonge phambi kokuba wabelane ngayo; amaxabiso emva kwamagama e-password, secret, token, kunye ne-community afihliwe."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Ukulungiswa okungaziwayo"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Iyala ukulungisa ngaphandle kwe --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Khetha uphawu oluxhaswayo kunye nesiphumo se-text okanye se-JSON."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Isilumkiso esamkelekileyo"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Ukufumaneka kwesixhobo"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Iimvume zesixhobo azikwazanga kuvavanywa."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "I-PHP CLI eqwalaselweyo ayinako ukuqhuba iitshekhi ze-Doctor."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Iitshekhi ze-Doctor zisilele okanye zigqithe kumda wazo wexesha. Jonga ilogi ye-Doctor."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Iigrafu ziyekile ukuhlaziywa"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Ukuphola kuyacotha"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Izixhobo azikho okanye azifumaneki"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Izilumkiso ze-Doctor ziyashota"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Khangela umcwangcisi we-poller kunye nelogi ye-poller echaphazelekayo, uze uqinisekise umjikelo omtsha ogqityiweyo."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "Ukuqokelelwa kweenkcukacha kunokuba kumile."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Amaxabiso aqokelelweyo anokungafiki kwidiski."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Hlola umgca wemveliso kunye nembali yokukhutshwa kwe-Boost; qinisekisa ukuba umgca uyaphela kwaye amaxesha e-RRD aya phambili."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Khangela umthamo wokugcina, iimvume zesikhombisi sexesha lokusebenza kunye nohlaziyo lokugqibela lwe-RRD; qwalasela ukubhalwa okulibazisekileyo."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "Ukugcinwa kwe-RRD kufuna uphando."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Umsebenzi wokuqokelela unokuba ugqitha kwixesha lawo elimiselweyo."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Thelekisa ubude bomjikelo kunye nekhefu le-polling uze uhlole ukuphelelwa lixesha kwesixhobo ngaphambi kokwandisa ukusebenza ngaxeshanye."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Thelekisa izibali zesiseko sedatha ngexesha lomjikelo ocothayo uze uhlole izicwangciso zezicelo phambi kokutshintsha imida yeseva."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Uxinzelelo lwesiseko sedatha lunokuba negalelo ekucotheni kwe-polling."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Iimfuneko zokuqokelela okanye ukufikeleleka kunokuba kuyasilela."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Qinisekisa iimvume zesixhobo esichaphazelekayo, ukufikeleleka, iziqinisekiso zokungena kunye ne-poller eyabelweyo usebenzisa uxilongo lwe-Cacti."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Ukuhlolwa okucwangcisiweyo okanye ukuhanjiswa kweposi kufuna ingqwalasela."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Qinisekisa iisetingi zokucwangcisa kunye nezomamkeli, hlola iinzame zokuhambisa ezigciniweyo, uze uthumele i-imeyile yovavanyo ye-Cacti."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Unobangela onokubakho ufuna ukuqinisekiswa; ukuhlolwa okuhambelanayo akuqinisekisi unobangela osisiseko."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Akukho nobangela uqinisekisiweyo ngokuqwalaselwa okukhoyo. Qhuba uxilongo olutsha uze uphande uphawu ngokuthe ngqo."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Ubuncinane iiyure ezingama-24 ukusukela ekuqalisweni kweseva kunye ne-FLUSH STATUS. Izibali ziqokelelana kwaye zinokuba neembali ezahlukeneyo zokuseta kwakhona; qinisekisa iindlela zokuhamba ngexesha lomthwalo womsebenzi omelayo phambi kokulungisa."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "Ingcebiso yolungiso oluqokelelanayo ilibazisiwe: fumana ixesha lokusebenza elisemthethweni kunye nobuncinane iiyure ezingama-24 ukusukela ekuqalisweni kunye ne-FLUSH STATUS. Imilinganiselo eshotayo okanye isampulu engahambelaniyo ayinakumisela impilo yesiseko sedatha."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Ifestile yokuqwalasela isiseko sedatha"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Imilinganiselo yoqhagamshelo ayifumaneki okanye ayisebenzi. Khangela ufikelelo kwi-SHOW GLOBAL STATUS nakwi-SHOW GLOBAL VARIABLES; musa ukuthatha imilinganiselo eshotayo njengeseva engasebenziyo."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Uqhagamshelo lwangoku: %.0f / %.0f (%s); incopho erekhodiweyo: %.0f (%s yomda wangoku)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Phonononga ukuqokelelwa koqhagamshelo kunye nokusebenza ngaxeshanye kwe-poller. Khangela indawo eseleyo yememori yenginginya yesiseko sedatha phambi kokunyusa i-max_connections; incopho yembali inokubonisa umda omdala."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Umthamo woqhagamshelo"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Ukufundwa kwe-InnoDB buffer pool"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Phonononga izicwangciso zezicelo kunye neseti esebenzayo. Qwalasela i-innodb_buffer_pool_size kuphela emva kokulinganisa imemori efumanekayo kwinginginya yesiseko sedatha; umlinganiselo wokuphoswa oqokelelanayo wedwa awubonisi uxinzelelo lwememori."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Iitheyibhile zexeshana ezikwidiski"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Phonononga izicwangciso zezicelo, ukuhlela, ukuhlanganisa, kunye neentlobo zedatha zeteyibhile yexeshana phambi kokutshintsha imida yememori. Ezinye iitheyibhile kufuneka zisebenzise idiski; imida yememori kunye nokubalwa kwayo kuyahluka phakathi kweenguqulelo ze-MySQL kunye ne-MariaDB."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Ukudalwa kwemisonto yoqhagamshelo"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Phonononga ukusetyenziswa kwakhona koqhagamshelo kunye ne-thread_cache_size. Khangela imo yokuphatha imisonto yeseva phambi kokulungisa; ukwenziwa kwe-thread-pool akuziphathi njengeeseva ezisebenzisa umsonto omnye ngoqhagamshelo ngalunye."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Phonononga ukurekhodwa kwezicelo ezicothayo, i-long_query_time, kunye nezicwangciso zezicelo phambi kokutshintsha iibhafa zeseva. Esi sibali sixhomekeke kumda wesicelo esicothayo oqwalaselweyo kwaye asichongi iingxelo ezizimeleyo."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Iingxelo ezicothayo"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Ingcebiso eqokelelanayo ilibazisiwe de ifestile yokuqwalasela ibe yaneleyo."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "Ingcebiso ye-thread-cache ayihlolwanga: i-thread_handling ayifumaneki okanye ayingomsonto omnye ngoqhagamshelo ngalunye. Phonononga ukwenziwa kwe-thread-pool esebenzayo endaweni yoko."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Izibali ezifunekayo ziyashota okanye azisebenzi: %s, %s. Khangela inkxaso yenguqulelo yeseva kunye neemvume zokubeka iliso."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "Isibali sasetwa kwakhona ukusukela kwisampulu yangaphambili; qokelela elinye ikhefu elimelayo phambi kokulungisa."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Umsebenzi awonelanga: %.0f %s; ubuncinane kufuneka ukuqwalaselwa okungu-%d kule ngcebiso."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Izibali azihambelani okanye zasetwa kwakhona ngokuzimeleyo. Qokelela isampulu entsha emelayo phambi kokulungisa."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "Isampulu yekhefu incinci kakhulu okanye izibali zisetwe kwakhona; qokelela elinye ikhefu elimelayo phambi kokulungisa."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Ikhefu %s / %s: %.0f / %.0f (%s); umda wophando: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Uqokelelano %s / %s: %.0f / %.0f (%s); umda wophando: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Esi sibali sinokushiya ngaphandle iifayile zexeshana ezibalwe kwimemori kwi-MySQL; umlinganiselo ophantsi awukhupheli ngaphandle ukusetyenziswa kwediski."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "Ingcebiso ye-redo-log ilibazisiwe de ifestile yokuqwalasela yanele kwaye i-Innodb_log_waits ifumaneke."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "I-Innodb_log_waits eqokelelanayo: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Phanda ubungakanani beentengiselwano, uxinzelelo lwe-log-buffer, kunye nokulibaziseka kokugcinwa. Khangela kwakhona isantya phantsi komthwalo phambi kokuqwalasela i-innodb_log_buffer_size; eli nani lembali alibubungqina bokuma kwangoku."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Ukulinda kwe-InnoDB log-buffer"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "i-composer.json ye-Cacti efakiweyo"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "Imfuneko yesifaki se-Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "Ukuhambelana kwe-PHP kunye ne-Cacti efakiweyo"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "I-PHP esebenzayo yi-%s; i-Cacti efakiweyo yi-%s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Ayikwazanga ukumisela imfuneko ye-PHP ye-Cacti. Khangela i-composer.json ye-Cacti efakiweyo okanye amaxwebhu okukhutshwa; i-Doctor ayicingeli ukuhambelana."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s kunye < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Ifuna i-%s (%s). I-PHP esebenzayo iyahlangabezana naloo mfuneko."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Ifuna i-%s (%s). I-PHP esebenzayo ayihlangabezani naloo mfuneko."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Kufunyenwe i-%s; i-Doctor ifuna i-Cacti 1.2.20 okanye entsha."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Inguqulelo ye-Cacti exhaswayo"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Inkxaso yokhuseleko engundoqo ye-PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Oku kuhlolwa kusebenza kwibrenshi yokukhutshwa kwe-PHP, hayi ukuba olu khupho lwe-patch luhlaziywe na okanye umthengisi wakho we-OS ubuyisela izilungiso na. Ukuhambelana kwe-Cacti kuhlolwa ngokwahlukeneyo."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "I-PHP esebenzayo yi-%s; ubume benkxaso yokhuseleko engundoqo abwaziwa okanye oku lukhupho lwangaphambi kwexesha. Khangela i-https://www.php.net/supported-versions.php uze uhlaziye idatha yenkxaso ye-Doctor."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "I-PHP esebenzayo yi-%s; i-PHP %s ifumana izilungiso zokhuseleko ezingundoqo kude kube yi-%s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "I-PHP esebenzayo yi-%s; i-PHP %s ayisafumani zilungiso zokhuseleko zingundoqo; inkxaso iphele nge-%s. Nyusela kwibrenshi ye-PHP exhaswayo ehambelana nofakelo lwakho lwe-Cacti, okanye uqinisekise ukugcinwa kokhuseleko kumthengisi wakho we-OS."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Izandiso ze-CLI PHP zangoku ezifunekayo"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Izandiso ze-web PHP ezifunekayo"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Ziyashota: %s. Zifake ngomlawuli wephakheji wenkqubo yokusebenza."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Zonke izandiso ze-PHP ezifunwa sisifaki se-Cacti zilayishiwe kule meko ye-PHP."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "I-Doctor ayiqhubi iibhayinari eziqwalaselweyo ngelixa isebenza njenge-root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "Igama lefayile elingu-%s alilindelekanga kwi-%s, ngoko ke i-Doctor ayiliqhubanga."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "I-Doctor isebenza njenge-root, ngoko ke ukuhlolwa kweemvume kuchaza i-root endaweni yeseva yewebhu okanye iakhawunti ye-poller, iibhayinari eziqwalaselweyo aziqhutshwa, kwaye ulungiso luyaliwa. Qhuba i-Doctor njengomsebenzisi we-poller ye-Cacti."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Amalungelo e-Doctor"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "I-Doctor isebenza ngaphandle kwamalungelo e-root."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Izandiso ze-CLI PHP ezifunekayo"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Isixhobo esiqhutshwayo se-PHP CLI esiqwalaselweyo asifumaneki, ngoko ke izandiso zaso azinakuhlolwa."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "I-shell_exec() ikhubaziwe, ngoko ke i-Doctor ayinakuthelekisa izandiso ze-CLI PHP neemfuneko ze-Cacti."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "Isixhobo esiqhutshwayo se-PHP CLI esiqwalaselweyo asibuyisanga uluhlu lwezandiso olusebenzayo."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "Ziyashota kwi-CLI PHP: %s. Uqwalaselo lwewebhu kunye ne-CLI PHP lwahlukile kwiinkqubo ezininzi."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "I-PHP CLI eqwalaselweyo inazo zonke izandiso ezifunwa yi-Cacti."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "Inkxaso ye-GD TrueType"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Iimpawu ze-PHP ezicetyiswayo"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Azifumaneki: %s. I-Cacti ingasebenza ngaphandle kwezi mpawu, kodwa ukusebenza okunxulumeneyo kunokuthintelwa."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "Iimpawu ezikhethwayo ze-gettext, SNMP, kunye ne-GD TrueType ziyafumaneka."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "i-memory_limit ngu-%s (kucetyiswa i-%dM okanye ngaphezulu)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "i-max_execution_time yimizuzwana engu-%d (kucetyiswa ama-60 okanye ngaphezulu)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "i-date.timezone ayisetwanga"

#: doctor_functions.php
msgid "unset"
msgstr "ayisetwanga"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Amaxabiso angoku: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "Uqwalaselo lwexesha lokusebenza lwe-PHP"

#: doctor_functions.php
msgid "Database connection"
msgstr "Uqhagamshelo lwesiseko sedatha"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
msgstr "Isicelo sisilele: %s"

#: doctor_functions.php
msgid "A read-only query completed successfully."
msgstr "Isicelo sokufunda kuphela sigqitywe ngempumelelo."

#: doctor_functions.php
msgid "The database returned an unexpected result."
msgstr "Isiseko sedatha sibuyise isiphumo esingalindelekanga."

#: doctor_functions.php
#, php-format
msgid "Doctor could not determine the database server version from %s."
msgstr "I-Doctor ayikwazanga ukumisela inguqulelo yeseva yesiseko sedatha kwi-%s."

#: doctor_functions.php
msgid "Supported database server"
msgstr "Iseva yesiseko sedatha exhaswayo"

#: doctor_functions.php
#, php-format
msgid "%s %s detected; this Cacti branch recommends %s %s or newer."
msgstr "Kufunyenwe i-%s %s; le brenshi ye-Cacti icebisa i-%s %s okanye entsha."

#: doctor_functions.php
#, php-format
msgid "Database character set is %s and collation is %s. Cacti requires utf8mb4."
msgstr "Iseti yoonobumba yesiseko sedatha ngu-%s kwaye i-collation ngu-%s. I-Cacti ifuna i-utf8mb4."

#: doctor_functions.php
msgid "unknown"
msgstr "akwaziwa"

#: doctor_functions.php
msgid "Database character set"
msgstr "Iseti yoonobumba yesiseko sedatha"

#: doctor_functions.php
msgid "Database timezone support"
