msgid "Clock Drift Warning (seconds)"
msgstr "تحذير انحراف الساعة (ثوانٍ)"

#: setup.php
msgid "Warn when the database and PHP clocks differ by more than this."
msgstr "التحذير عندما يزيد الفرق بين ساعتي قاعدة البيانات وPHP عن هذه القيمة."

#: setup.php
msgid "Clock Drift Failure (seconds)"
msgstr "فشل انحراف الساعة (ثوانٍ)"

#: setup.php
msgid "Fail when the database and PHP clocks differ by more than this."
msgstr "اعتبار الفحص فاشلًا عندما يزيد الفرق بين ساعتي قاعدة البيانات وPHP عن هذه القيمة."

