msgstr "ہر روز"

#: setup.php
msgid "Alert Email Addresses"
msgstr "الرٹ ای میل پتے"

#: setup.php
msgid "Comma-separated addresses to email when a check starts or stops failing. Leave empty to only log changes to the Cacti log."
msgstr "جب کوئی جانچ ناکام ہونا شروع یا بند ہو تو ای میل بھیجنے کے لیے کوما سے الگ کیے گئے پتے۔ تبدیلیوں کو صرف Cacti لاگ میں درج کرنے کے لیے خالی چھوڑ دیں۔"

#: setup.php
msgid "Alert on Warnings"
msgstr "انتباہات پر الرٹ کریں"

#: setup.php
msgid "Also alert when a check moves into or out of a warning."
msgstr "جب کوئی چیک انتباہ کی حالت میں داخل ہو یا اس سے باہر نکلے تب بھی الرٹ بھیجیں۔"

#: setup.php
msgid "Thresholds"
msgstr "حدود"

#: setup.php
msgid "Poller Run Time Warning (percent)"
msgstr "پولر کے چلنے کے وقت کا انتباہ (فیصد)"

#: setup.php
msgid "Warn when the last main-poller run used this share of the polling interval. Runs that take the whole interval always fail."
msgstr "جب آخری مین پولر رن نے پولنگ وقفے کا یہ حصہ استعمال کیا ہو تو انتباہ دیں۔ جو رن پورا وقفہ لے لیں وہ ہمیشہ ناکام ہوتے ہیں۔"

#: setup.php
msgid "RRA Disk Free Warning (percent)"
msgstr "RRA ڈسک کی خالی جگہ کا انتباہ (فیصد)"

#: setup.php
msgid "Warn when free space on the RRA file system drops below this percentage."
msgstr "جب RRA فائل سسٹم پر خالی جگہ اس فیصد سے کم ہو جائے تو انتباہ دیں۔"

#: setup.php
msgid "Fail when free space on the RRA file system drops below this percentage."
msgstr "جب RRA فائل سسٹم پر خالی جگہ اس فیصد سے کم ہو جائے تو ناکامی ظاہر کریں۔"

#: setup.php
msgid "RRA Disk Free Failure (percent)"
msgstr "RRA ڈسک کی خالی جگہ کی ناکامی (فیصد)"

#: setup.php
msgid "Clock Drift Warning (seconds)"
msgstr "کلاک ڈرفٹ کا انتباہ (سیکنڈ)"

#: setup.php
msgid "Warn when the database and PHP clocks differ by more than this."
msgstr "جب ڈیٹابیس اور PHP کی گھڑیوں میں اس سے زیادہ فرق ہو تو انتباہ دیں۔"

#: setup.php
msgid "Clock Drift Failure (seconds)"
msgstr "کلاک ڈرفٹ کی ناکامی (سیکنڈ)"

#: setup.php
msgid "Fail when the database and PHP clocks differ by more than this."
msgstr "جب ڈیٹابیس اور PHP کی گھڑیوں میں اس سے زیادہ فرق ہو تو ناکامی ظاہر کریں۔"

#: setup.php
msgid "RRD Stale Intervals"
msgstr "RRD کے پرانے وقفے"

#: setup.php
msgid "Warn after this many collection intervals without a file update (1 to 100)."
msgstr "فائل اپڈیٹ ہوئے بغیر اتنے کلیکشن وقفوں کے بعد انتباہ دیں (1 سے 100)۔"

#: setup.php
msgid "Additional disk-write delay for external caching (0 to 86400). Boost adds its own allowance."
msgstr "بیرونی کیشنگ کے لیے ڈسک رائٹ میں اضافی تاخیر (0 سے 86400)۔ Boost اپنی گنجائش خود شامل کرتا ہے۔"

#: setup.php
msgid "Deferred RRD Write Allowance (seconds)"
msgstr "مؤخر RRD رائٹ کی گنجائش (سیکنڈ)"

#: setup.php
msgid "Cacti Log Size Warning (MB)"
msgstr "Cacti لاگ کے حجم کا انتباہ (MB)"

#: setup.php
msgid "Warn when the Cacti log grows beyond this size, which usually means log rotation is not running."
msgstr "جب Cacti لاگ اس حجم سے بڑھ جائے تو انتباہ دیں، جس کا عام طور پر مطلب ہے کہ لاگ روٹیشن نہیں چل رہی۔"
