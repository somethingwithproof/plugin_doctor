#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "دستیاب مرمتیں: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "نامعلوم فارمیٹ %s۔ text، json، nagios، یا prometheus استعمال کریں۔"

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "حساس معلومات کی تخفیف مکمل نہیں ہو سکی، اس لیے %s نہیں لکھا گیا۔"

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "%s لکھا گیا۔ اشتراک کرنے سے پہلے اس کا جائزہ لیں؛ password، secret، token، اور community ناموں کے بعد کی قدریں چھپا دی گئی ہیں۔"

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "نامعلوم مرمت"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "--yes کے بغیر مرمت کرنے سے انکار کیا جا رہا ہے۔"

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "تائید شدہ علامت اور ٹیکسٹ یا JSON آؤٹ پٹ منتخب کریں۔"

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "قبول شدہ انتباہ"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "ڈیوائس کی دستیابی"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "ڈیوائس کی اجازتوں کا اندازہ نہیں لگایا جا سکا۔"

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "ترتیب دیا گیا PHP CLI، Doctor کی جانچیں نہیں چلا سکتا۔"

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Doctor کی جانچیں ناکام ہو گئیں یا اپنی وقت کی حد سے تجاوز کر گئیں۔ Doctor لاگ کا جائزہ لیں۔"

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "گراف اپ ڈیٹ ہونا بند ہو گئے"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "پولنگ سست ہے"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "ڈیوائسز غائب یا غیر دستیاب ہیں"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Doctor الرٹس موجود نہیں ہیں"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "پولر شیڈولر اور متاثرہ پولر لاگ کی جانچ کریں، پھر ایک نئے مکمل ہونے والے سائیکل کی تصدیق کریں۔"

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "ڈیٹا جمع کرنے کا عمل شاید رک گیا ہے۔"

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "جمع کردہ قدریں شاید ڈسک تک نہیں پہنچ رہیں۔"

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "آؤٹ پٹ قطار اور Boost فلش ہسٹری کا معائنہ کریں؛ تصدیق کریں کہ قطار خالی ہوتی ہے اور RRD ٹائم اسٹیمپ آگے بڑھتے ہیں۔"

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "اسٹوریج کی گنجائش، رن ٹائم ڈائریکٹری کی اجازتوں اور آخری RRD اپ ڈیٹ کی جانچ کریں؛ مؤخر شدہ رائیٹس کو مدنظر رکھیں۔"

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "RRD اسٹوریج کی تحقیق کی ضرورت ہے۔"

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "ڈیٹا جمع کرنے کا کام شاید اپنے مقررہ وقت سے تجاوز کر رہا ہے۔"

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "کنکرنسی بڑھانے سے پہلے سائیکل کے دورانیے کا پولنگ وقفے سے موازنہ کریں اور ڈیوائس کے ٹائم آؤٹس کا معائنہ کریں۔"

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "سرور کی حدود تبدیل کرنے سے پہلے سست سائیکل کے دوران ڈیٹابیس کاؤنٹرز کا موازنہ کریں اور کوئیری پلانز کا معائنہ کریں۔"

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "ڈیٹابیس کا دباؤ سست پولنگ کی وجہ بن سکتا ہے۔"

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "ڈیٹا جمع کرنے کی پیشگی شرائط یا رسائی شاید ناکام ہو رہی ہے۔"

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Cacti تشخیصی ٹولز استعمال کرتے ہوئے متاثرہ ڈیوائس کی اجازتوں، رسائی، اسناد اور تفویض کردہ پولر کی تصدیق کریں۔"

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "شیڈول کردہ جانچ پڑتال یا ای میل کی ترسیل پر توجہ دینے کی ضرورت ہے۔"

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "شیڈولنگ اور وصول کنندہ کی ترتیبات کی تصدیق کریں، محفوظ کردہ ترسیلی کوششوں کا معائنہ کریں، اور Cacti ٹیسٹ ای میل بھیجیں۔"

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "ممکنہ وجوہات کی تصدیق ضروری ہے؛ مماثل جانچ پڑتال بنیادی وجہ ثابت نہیں کرتی۔"

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "دستیاب مشاہدات سے کوئی وجہ ثابت نہیں ہوتی۔ تازہ تشخیص چلائیں اور علامت کی براہ راست تحقیق کریں۔"

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "سرور شروع ہونے اور FLUSH STATUS کے بعد کم از کم 24 گھنٹے۔ کاؤنٹرز مجموعی ہیں اور ان کی ری سیٹ تاریخ مختلف ہو سکتی ہے؛ ٹیوننگ سے پہلے ایک نمائندہ ورک لوڈ کے دوران رجحانات کی تصدیق کریں۔"

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "مجموعی ٹیوننگ کا مشورہ مؤخر کر دیا گیا ہے: درست اپ ٹائم اور سرور شروع ہونے و FLUSH STATUS کے بعد کم از کم 24 گھنٹے حاصل کریں۔ گمشدہ میٹرکس یا غیر مستقل نمونہ ڈیٹابیس کی صحت ثابت نہیں کر سکتا۔"

#: doctor_functions.php
msgid "Database observation window"
msgstr "ڈیٹابیس مشاہداتی دورانیہ"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "کنکشن میٹرکس دستیاب نہیں ہیں یا غلط ہیں۔ SHOW GLOBAL STATUS اور SHOW GLOBAL VARIABLES تک رسائی کی جانچ کریں؛ گمشدہ میٹرکس کو بیکار سرور نہ سمجھیں۔"

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "موجودہ کنکشنز: %.0f / %.0f (%s)؛ ریکارڈ شدہ عروج: %.0f (موجودہ حد کا %s)۔"

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "کنکشن پولنگ اور پولر کنکرنسی کا جائزہ لیں۔ max_connections بڑھانے سے پہلے ڈیٹابیس ہوسٹ کی دستیاب میموری کی جانچ کریں؛ تاریخی عروج پرانی حد کی عکاسی کر سکتا ہے۔"

#: doctor_functions.php
msgid "Connection capacity"
msgstr "کنکشن کی گنجائش"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "InnoDB بفر پول ریڈز"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "کوئیری پلانز اور ورکنگ سیٹ کا جائزہ لیں۔ ڈیٹابیس ہوسٹ پر دستیاب میموری کی پیمائش کے بعد ہی innodb_buffer_pool_size پر غور کریں؛ صرف مجموعی مِس ریشو میموری کے دباؤ کو ثابت نہیں کرتا۔"

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "ڈسک پر عارضی ٹیبلز"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "میموری کی حدود تبدیل کرنے سے پہلے کوئیری پلانز، ترتیب، گروپنگ، اور عارضی ٹیبل کی ڈیٹا اقسام کا جائزہ لیں۔ کچھ ٹیبلز کا ڈسک استعمال کرنا لازم ہوتا ہے؛ MySQL اور MariaDB ورژنز کے درمیان میموری کی حدود اور حساب کتاب مختلف ہوتے ہیں۔"

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "کنکشن تھریڈ کی تخلیق"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "کنکشن کے دوبارہ استعمال اور thread_cache_size کا جائزہ لیں۔ ٹیوننگ سے پہلے سرور کے تھریڈ ہینڈلنگ موڈ کی جانچ کریں؛ تھریڈ پول نفاذ فی کنکشن ایک تھریڈ والے سرورز کی طرح برتاؤ نہیں کرتے۔"

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "سرور بفرز تبدیل کرنے سے پہلے سلو کوئیری لاگنگ، long_query_time، اور کوئیری پلانز کا جائزہ لیں۔ یہ کاؤنٹر ترتیب شدہ سلو کوئیری حد پر منحصر ہے اور انفرادی اسٹیٹمنٹس کی نشاندہی نہیں کرتا۔"

#: doctor_functions.php
msgid "Slow statements"
msgstr "سست اسٹیٹمنٹس"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "مجموعی مشورہ اس وقت تک مؤخر ہے جب تک مشاہداتی دورانیہ کافی نہ ہو جائے۔"

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "تھریڈ کیشے کے مشورے کا جائزہ نہیں لیا گیا: thread_handling دستیاب نہیں ہے یا فی کنکشن ایک تھریڈ پر مبنی نہیں ہے۔ اس کے بجائے فعال تھریڈ پول نفاذ کا جائزہ لیں۔"

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "مطلوبہ کاؤنٹرز غائب یا غلط ہیں: %s، %s۔ سرور ورژن کی سپورٹ اور مانیٹرنگ کی اجازتوں کی جانچ کریں۔"

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "پچھلے نمونے کے بعد کوئی کاؤنٹر ری سیٹ ہوا ہے؛ ٹیوننگ سے پہلے ایک اور نمائندہ وقفہ جمع کریں۔"

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "ناکافی سرگرمی: %.0f %s؛ اس مشورے کے لیے کم از کم %d مشاہدات درکار ہیں۔"

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "کاؤنٹرز غیر مستقل ہیں یا آزادانہ طور پر ری سیٹ کیے گئے تھے۔ ٹیوننگ سے پہلے ایک نیا نمائندہ نمونہ جمع کریں۔"

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "وقفے کا نمونہ بہت چھوٹا ہے یا کاؤنٹرز ری سیٹ ہو گئے ہیں؛ ٹیوننگ سے پہلے ایک اور نمائندہ وقفہ جمع کریں۔"

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "وقفہ %s / %s: %.0f / %.0f (%s)؛ تحقیقاتی حد: %s۔"

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "مجموعی %s / %s: %.0f / %.0f (%s)؛ تحقیقاتی حد: %s۔"

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "یہ کاؤنٹر MySQL پر میموری میپڈ عارضی فائلوں کو چھوڑ سکتا ہے؛ کم تناسب ڈسک کے استعمال کو رد نہیں کرتا۔"

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "ریڈو لاگ کا مشورہ اس وقت تک مؤخر ہے جب تک مشاہداتی دورانیہ کافی نہ ہو جائے اور Innodb_log_waits دستیاب نہ ہو۔"

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "مجموعی Innodb_log_waits: %.0f۔"

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "ٹرانزیکشن کے سائز، لاگ بفر کے دباؤ، اور اسٹوریج لیٹنسی کی تحقیق کریں۔ innodb_log_buffer_size پر غور کرنے سے پہلے لوڈ کے تحت شرح کو دوبارہ جانچیں؛ یہ تاریخی تعداد موجودہ تعطل کا ثبوت نہیں ہے۔"

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "InnoDB لاگ بفر ویٹس"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "انسٹال شدہ Cacti composer.json"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "Cacti %s انسٹالر کی شرط"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "انسٹال شدہ Cacti کے ساتھ PHP کی مطابقت"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "چل رہا PHP %s؛ انسٹال شدہ Cacti %s۔"

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Cacti کی PHP شرط کا تعین نہیں ہو سکا۔ انسٹال شدہ Cacti composer.json یا ریلیز دستاویزات کی جانچ کریں؛ Doctor مطابقت فرض نہیں کرتا۔"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s اور < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "%s (%s) درکار ہے۔ چل رہا PHP اس شرط کو پورا کرتا ہے۔"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "%s (%s) درکار ہے۔ چل رہا PHP اس شرط کو پورا نہیں کرتا۔"

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "%s کا پتہ چلا؛ Doctor کے لیے Cacti 1.2.20 یا نیا ورژن درکار ہے۔"

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "تعاون یافتہ Cacti ورژن"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "PHP اپ اسٹریم سیکیورٹی سپورٹ"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "یہ PHP ریلیز برانچ کی جانچ کرتا ہے، نہ کہ یہ کہ آیا یہ پیچ ریلیز اپ ٹو ڈیٹ ہے یا آپ کا OS وینڈر فکسز کو بیک پورٹ کرتا ہے۔ Cacti کی مطابقت الگ سے جانچی جاتی ہے۔"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "چل رہا PHP %s؛ اپ اسٹریم سیکیورٹی سپورٹ کی حیثیت نامعلوم ہے یا یہ پری ریلیز ہے۔ https://www.php.net/supported-versions.php کی جانچ کریں اور Doctor کا سپورٹ ڈیٹا اپ ڈیٹ کریں۔"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "چل رہا PHP %s؛ PHP %s کو %s تک اپ اسٹریم سیکیورٹی فکسز موصول ہوتے ہیں۔"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
