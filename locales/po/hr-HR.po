msgstr "Automatski ponovni pokušaji su iscrpljeni. Ispravite Cacti postavke e-pošte, zatim pokrenite Doctor s opcijama --scheduled --retry-alerts kao korisnik pollera."

#: doctor_scheduling.php
#, php-format
msgid "Next eligible retry: %s UTC, after a primary poller cycle."
msgstr "Sljedeći mogući pokušaj: %s UTC, nakon ciklusa primarnog pollera."

#: doctor_scheduling.php
msgid "No alert recipients are currently configured; pending transitions are retained."
msgstr "Trenutačno nisu konfigurirani primatelji obavijesti; prijelazi na čekanju su zadržani."

#: doctor_scheduling.php
msgid "No retained alert is awaiting delivery. Mail-server acceptance does not prove inbox delivery."
msgstr "Nijedna zadržana obavijest ne čeka dostavu. Prihvaćanje od strane poslužitelja pošte ne dokazuje dostavu u dolazni sandučić."

#: doctor_scheduling.php
msgid "Doctor retained status changes (UTC). Repeated changes for one check are coalesced; an out-and-back transition is retained."
msgstr "Zadržane promjene statusa dodatka Doctor (UTC). Ponovljene promjene za jednu provjeru su spojene; povratni prijelaz se zadržava."

#: doctor_scheduling.php
#, php-format
msgid "%s: %s -> %s (latest change %s)"
msgstr "%s: %s -> %s (posljednja promjena %s)"

#: doctor_scheduling.php
#, php-format
msgid "%d further status changes are not listed because the alert queue reached its storage limit."
msgstr "%d dodatnih promjena statusa nije navedeno jer je red obavijesti dosegnuo ograničenje pohrane."

#: doctor_scheduling.php
msgid "Open Utilities > Doctor for current measurements, recommended actions, and verification steps."
msgstr "Otvorite Alati > Doctor za trenutačna mjerenja, preporučene radnje i korake provjere."

#: doctor_scheduling.php
#, php-format
msgid "Cacti Doctor: %d retained status changes"
msgstr "Cacti Doctor: %d zadržanih promjena statusa"

#: doctor_scheduling.php
msgid "Doctor schedule is already running or the database lock is unavailable."
msgstr "Raspored dodatka Doctor već se izvodi ili zaključavanje baze podataka nije dostupno."

#: doctor_web.php
msgid "The finding could not be acknowledged. Run Doctor again, then acknowledge the current result."
msgstr "Nalaz nije bilo moguće potvrditi. Ponovno pokrenite Doctor, a zatim potvrdite trenutačni rezultat."

#: doctor_web.php
msgid "The warning exception could not be saved. Use a fresh assessed warning, an owner, a reason and an expiry within 90 days."
msgstr "Iznimku upozorenja nije bilo moguće spremiti. Upotrijebite svježe ocijenjeno upozorenje, vlasnika, razlog i rok isteka unutar 90 dana."

#: doctor_web.php
msgid "Confirm repair"
msgstr "Potvrdi popravak"

#: doctor_web.php
msgid "Approval expires after five minutes and is invalidated by a changed filesystem. The acting account must be able to create directories or change owner permissions."
msgstr "Odobrenje istječe nakon pet minuta i postaje nevaljano ako se datotečni sustav promijeni. Račun koji provodi radnju mora moći stvarati direktorije ili mijenjati vlasničke ovlasti."

#: doctor_web.php
msgid "Repair prerequisites are not met. No changes will be made."
msgstr "Preduvjeti za popravak nisu ispunjeni. Nikakve promjene neće biti učinjene."

#: doctor_web.php
msgid "Cancel"
msgstr "Odustani"

