#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Beschikbare herstelacties: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Onbekende indeling %s. Gebruik text, json, nagios of prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Het maskeren kon niet worden voltooid, dus %s is niet geschreven."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "%s geschreven. Controleer het bestand voordat u het deelt; waarden achter password, secret, token en communitynamen zijn gemaskeerd."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Onbekende herstelactie"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Herstel wordt geweigerd zonder --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Selecteer een ondersteund symptoom en tekst- of JSON-uitvoer."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Geaccepteerde waarschuwing"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Beschikbaarheid van apparaten"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Apparaatmachtigingen konden niet worden geëvalueerd."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "De geconfigureerde PHP CLI kan Doctor-controles niet uitvoeren."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Doctor-controles zijn mislukt of hebben hun tijdslimiet overschreden. Raadpleeg het Doctor-logboek."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Grafieken worden niet meer bijgewerkt"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Polling is traag"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Apparaten ontbreken of zijn niet beschikbaar"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Doctor-waarschuwingen ontbreken"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Controleer de poller-planner en het betreffende poller-logboek en verifieer daarna een nieuwe voltooide cyclus."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "De verzameling is mogelijk gestopt."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Verzamelde waarden bereiken mogelijk de schijf niet."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Inspecteer de uitvoerwachtrij en de Boost-flushgeschiedenis; controleer of de wachtrij leegloopt en RRD-tijdstempels vooruitgaan."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Controleer de opslagcapaciteit, de machtigingen van de runtime-map en de laatste RRD-update; houd rekening met uitgestelde schrijfbewerkingen."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "De RRD-opslag vereist onderzoek."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Het verzamelwerk overschrijdt mogelijk het tijdsbudget."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Vergelijk de cyclusduur met het polling-interval en inspecteer apparaat-time-outs voordat u de gelijktijdigheid verhoogt."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Vergelijk databasetellers tijdens een trage cyclus en inspecteer queryplannen voordat u serverlimieten wijzigt."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Databasebelasting draagt mogelijk bij aan trage polling."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Verzamelingsvereisten of bereikbaarheid falen mogelijk."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Controleer de machtigingen, bereikbaarheid, inloggegevens en toegewezen poller van het betreffende apparaat met behulp van Cacti-diagnostiek."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Geplande controles of e-mailbezorging vereisen aandacht."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Controleer de plannings- en ontvangerinstellingen, inspecteer bewaarde bezorgpogingen en verstuur een Cacti-test-e-mail."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Mogelijke oorzaken vereisen verificatie; overeenkomende controles stellen geen hoofdoorzaak vast."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Er is geen oorzaak vastgesteld op basis van de beschikbare waarnemingen. Voer nieuwe diagnostiek uit en onderzoek het symptoom rechtstreeks."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Ten minste 24 uur sinds het opstarten van de server en FLUSH STATUS. Tellers zijn cumulatief en kunnen een verschillende resetgeschiedenis hebben; bevestig trends tijdens een representatieve werkbelasting voordat u afstemt."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "Cumulatief afstemmingsadvies is uitgesteld: verkrijg een geldige uptime en ten minste 24 uur sinds het opstarten en FLUSH STATUS. Ontbrekende metrische gegevens of een inconsistente steekproef kunnen de databasestatus niet vaststellen."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Database-observatievenster"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Verbindingsmetrieken zijn niet beschikbaar of ongeldig. Controleer de toegang tot SHOW GLOBAL STATUS en SHOW GLOBAL VARIABLES; beschouw ontbrekende metrieken niet als een inactieve server."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Huidige verbindingen: %.0f / %.0f (%s); geregistreerde piek: %.0f (%s van de huidige limiet)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Controleer connection pooling en poller-gelijktijdigheid. Controleer de vrije geheugenruimte van de databasehost voordat u max_connections verhoogt; de historische piek kan een oudere limiet weerspiegelen."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Verbindingscapaciteit"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "InnoDB-bufferpool-leesbewerkingen"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Inspecteer queryplannen en de werkset. Overweeg innodb_buffer_pool_size pas na het meten van het beschikbare geheugen op de databasehost; een cumulatieve miss-ratio alleen bewijst geen geheugendruk."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Tijdelijke tabellen op schijf"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Inspecteer queryplannen, sortering, groepering en gegevenstypen van tijdelijke tabellen voordat u geheugenlimieten wijzigt. Sommige tabellen moeten schijfruimte gebruiken; geheugenlimieten en de registratie ervan verschillen tussen MySQL- en MariaDB-versies."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Aanmaken van verbindingsthreads"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Controleer hergebruik van verbindingen en thread_cache_size. Controleer de thread-afhandelingsmodus van de server voordat u afstemt; thread-pool-implementaties gedragen zich niet zoals servers met één thread per verbinding."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Controleer slow-query-logboekregistratie, long_query_time en queryplannen voordat u serverbuffers wijzigt. Deze teller is afhankelijk van de geconfigureerde slow-query-drempelwaarde en identificeert geen afzonderlijke instructies."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Trage instructies"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Cumulatief advies uitgesteld totdat het observatievenster toereikend is."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "Thread-cache-advies is niet beoordeeld: thread_handling is niet beschikbaar of is niet one-thread-per-connection. Beoordeel in plaats daarvan de actieve thread-pool-implementatie."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Vereiste tellers ontbreken of zijn ongeldig: %s, %s. Controleer de ondersteuning voor de serverversie en de bewakingsmachtigingen."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "Een teller is gereset sinds de vorige steekproef; verzamel nog een representatief interval voordat u afstemt."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Onvoldoende activiteit: %.0f %s; er zijn ten minste %d waarnemingen nodig voor dit advies."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Tellers zijn inconsistent of zijn onafhankelijk gereset. Verzamel een nieuwe representatieve steekproef voordat u afstemt."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "De intervalsteekproef is te klein of tellers zijn gereset; verzamel nog een representatief interval voordat u afstemt."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Interval %s / %s: %.0f / %.0f (%s); onderzoeksdrempelwaarde: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Cumulatief %s / %s: %.0f / %.0f (%s); onderzoeksdrempelwaarde: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Deze teller kan memory-mapped tijdelijke bestanden in MySQL weglaten; een lage verhouding sluit schijfgebruik niet uit."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "Redo-log-advies uitgesteld totdat het observatievenster toereikend is en Innodb_log_waits beschikbaar is."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Cumulatieve Innodb_log_waits: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Onderzoek transactiegroottes, log-bufferdruk en opslaglatentie. Controleer de snelheid opnieuw onder belasting voordat u innodb_log_buffer_size overweegt; dit historische aantal is geen bewijs van een huidige blokkering."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "InnoDB-logbuffer-wachttijden"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "geïnstalleerde Cacti composer.json"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "Cacti %s-installatievereiste"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "PHP-compatibiliteit met geïnstalleerde Cacti"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Actieve PHP %s; geïnstalleerde Cacti %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Kon de PHP-vereiste van Cacti niet vaststellen. Controleer de geïnstalleerde Cacti composer.json of de releasedocumentatie; Doctor gaat niet uit van compatibiliteit."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s en < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Vereist %s (%s). De actieve PHP-versie voldoet aan die vereiste."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Vereist %s (%s). De actieve PHP-versie voldoet niet aan die vereiste."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "%s gedetecteerd; Doctor vereist Cacti 1.2.20 of nieuwer."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Ondersteunde Cacti-versie"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Upstream beveiligingsondersteuning voor PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Dit controleert de PHP-releasebranch, niet of deze patchrelease up-to-date is of dat uw besturingssysteemleverancier oplossingen backport. Cacti-compatibiliteit wordt afzonderlijk gecontroleerd."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Actieve PHP %s; de status van upstream beveiligingsondersteuning is onbekend of dit is een voorlopige uitgave. Controleer https://www.php.net/supported-versions.php en werk de ondersteuningsgegevens van Doctor bij."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Actieve PHP %s; PHP %s ontvangt upstream beveiligingsoplossingen tot en met %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Actieve PHP %s; PHP %s ontvangt geen upstream beveiligingsoplossingen meer; ondersteuning eindigde op %s. Upgrade naar een ondersteunde PHP-branch die compatibel is met uw Cacti-installatie, of bevestig beveiligingsonderhoud bij uw besturingssysteemleverancier."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Vereiste huidige CLI PHP-extensies"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Vereiste web-PHP-extensies"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Ontbrekend: %s. Installeer ze via de pakketbeheerder van het besturingssysteem."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Alle PHP-extensies die door het Cacti-installatieprogramma worden vereist, zijn geladen in deze PHP-context."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "Doctor voert geen geconfigureerde binaire bestanden uit wanneer het als root wordt uitgevoerd."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "De bestandsnaam %s wordt niet verwacht voor %s, dus Doctor heeft het niet uitgevoerd."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "Doctor wordt uitgevoerd als root, dus machtigingscontroles beschrijven root in plaats van de webserver of het poller-account, geconfigureerde binaire bestanden worden niet uitgevoerd en reparaties worden geweigerd. Voer Doctor uit als de Cacti-poller-gebruiker."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Doctor-machtigingen"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "Doctor wordt uitgevoerd zonder rootmachtigingen."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Vereiste CLI PHP-extensies"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Het geconfigureerde PHP CLI-uitvoerbare bestand is niet beschikbaar, dus de extensies ervan kunnen niet worden gecontroleerd."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "shell_exec() is uitgeschakeld, dus Doctor kan de CLI PHP-extensies niet vergelijken met de Cacti-vereisten."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "Het geconfigureerde PHP CLI-uitvoerbare bestand heeft geen geldige extensielijst geretourneerd."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "Ontbrekend in CLI PHP: %s. De web- en CLI PHP-configuraties zijn op veel systemen gescheiden."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "De geconfigureerde PHP CLI beschikt over elke extensie die door Cacti wordt vereist."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "GD TrueType-ondersteuning"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Aanbevolen PHP-functies"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Niet beschikbaar: %s. Cacti kan zonder deze functies draaien, maar gerelateerde functionaliteit kan beperkt zijn."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "De optionele functies gettext, SNMP en GD TrueType zijn beschikbaar."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "memory_limit is %s (%dM of meer wordt aanbevolen)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "max_execution_time is %d seconden (60 of meer wordt aanbevolen)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "date.timezone is niet ingesteld"

#: doctor_functions.php
msgid "unset"
msgstr "niet ingesteld"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Huidige waarden: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "PHP-runtimeconfiguratie"

#: doctor_functions.php
msgid "Database connection"
msgstr "Databaseverbinding"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
msgstr "Query mislukt: %s"

#: doctor_functions.php
msgid "A read-only query completed successfully."
msgstr "Een alleen-lezen query is succesvol voltooid."

#: doctor_functions.php
msgid "The database returned an unexpected result."
msgstr "De database heeft een onverwacht resultaat geretourneerd."

#: doctor_functions.php
#, php-format
msgid "Doctor could not determine the database server version from %s."
msgstr "Doctor kon de databaseserverversie niet bepalen uit %s."

#: doctor_functions.php
msgid "Supported database server"
msgstr "Ondersteunde databaseserver"

#: doctor_functions.php
#, php-format
msgid "%s %s detected; this Cacti branch recommends %s %s or newer."
msgstr "%s %s gedetecteerd; deze Cacti-branch beveelt %s %s of nieuwer aan."

#: doctor_functions.php
#, php-format
msgid "Database character set is %s and collation is %s. Cacti requires utf8mb4."
msgstr "De tekenset van de database is %s en de collatie is %s. Cacti vereist utf8mb4."

#: doctor_functions.php
msgid "unknown"
msgstr "onbekend"

#: doctor_functions.php
msgid "Database character set"
msgstr "Databasetekenset"

#: doctor_functions.php
msgid "Database timezone support"
msgstr "Tijdzone-ondersteuning van de database"

#: doctor_functions.php
msgid "The Cacti database account cannot read mysql.time_zone_name. Grant SELECT access and populate the database timezone tables."
msgstr "Het Cacti-databaseaccount kan mysql.time_zone_name niet lezen. Verleen SELECT-toegang en vul de databasetijdzone-tabellen."

#: doctor_functions.php
#, php-format
msgid "The database timezone table is accessible and contains %d entries."
msgstr "De databasetijdzone-tabel is toegankelijk en bevat %d vermeldingen."

#: doctor_functions.php
msgid "The database timezone table is accessible but empty. Populate the system timezone tables."
msgstr "De databasetijdzone-tabel is toegankelijk maar leeg. Vul de systeemtijdzone-tabellen."

#: doctor_functions.php
msgid "Core tables used by Cacti are present."
msgstr "Kerntabellen die door Cacti worden gebruikt, zijn aanwezig."

#: doctor_functions.php
#, php-format
msgid "Missing core tables: %s. Restore or upgrade the database before attempting other repairs."
msgstr "Ontbrekende kerntabellen: %s. Herstel of upgrade de database voordat u andere reparaties probeert."

#: doctor_functions.php
msgid "Core database tables"
msgstr "Databasekerntabellen"

#: doctor_functions.php
#, php-format
msgid "%s is missing (%s)"
msgstr "%s ontbreekt (%s)"

#: doctor_functions.php
#, php-format
msgid "%s is not writable (%s)"
msgstr "%s is niet beschrijfbaar (%s)"

#: doctor_functions.php
msgid "Runtime directories"
msgstr "Runtime-mappen"

#: doctor_functions.php
msgid "The cache, log, and RRA directories exist and are writable."
msgstr "De cache-, logboek- en RRA-mappen bestaan en zijn beschrijfbaar."

#: doctor_functions.php
msgid "Cacti configuration file"
msgstr "Cacti-configuratiebestand"

#: doctor_functions.php
msgid "include/config.php is missing or unreadable."
msgstr "include/config.php ontbreekt of is onleesbaar."

#: doctor_functions.php
msgid "include/config.php is readable. POSIX mode-bit checks do not apply on Windows."
msgstr "include/config.php is leesbaar. POSIX-modusbitcontroles zijn niet van toepassing op Windows."

#: doctor_functions.php
msgid "include/config.php is writable by other users. Remove world-write permission because this file contains database credentials."
msgstr "include/config.php is beschrijfbaar door andere gebruikers. Verwijder de algemene schrijfmachtiging omdat dit bestand database-inloggegevens bevat."

#: doctor_functions.php
msgid "include/config.php is group-writable. Confirm that every member of the owning group is trusted."
msgstr "include/config.php is beschrijfbaar voor de groep. Controleer of elk lid van de eigenaarsgroep wordt vertrouwd."

#: doctor_functions.php
msgid "include/config.php is readable by all local users and contains database credentials. Restrict it to the owner and the web server group."
msgstr "include/config.php is leesbaar voor alle lokale gebruikers en bevat database-inloggegevens. Beperk de toegang tot de eigenaar en de webservergroep."

#: doctor_functions.php
msgid "include/config.php is readable and is not world-readable, group-writable, or world-writable."
msgstr "include/config.php is leesbaar en is niet algemeen leesbaar, groepsbeschrijfbaar of algemeen beschrijfbaar."

#: doctor_functions.php
msgid "Cacti log file"
msgstr "Cacti-logboekbestand"

#: doctor_functions.php
msgid "The log file does not exist. Its parent directory is not writable."
msgstr "Het logboekbestand bestaat niet. De bovenliggende map is niet beschrijfbaar."

#: doctor_functions.php
msgid "The log file does not exist. Its parent directory is writable, so Cacti can create it."
