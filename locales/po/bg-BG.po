#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Налични поправки: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Непознат формат %s. Използвайте text, json, nagios или prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Редактирането на поверителни данни не можа да завърши, затова %s не беше записан."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "Записан е %s. Прегледайте го преди споделяне; стойностите след имена на пароли, тайни, токени и community низове са маскирани."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Непозната поправка"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Отказ за извършване на поправка без --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Изберете поддържан симптом и текстов или JSON изход."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Прието предупреждение"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Наличност на устройствата"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Правата за достъп до устройствата не можаха да бъдат оценени."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "Конфигурираният PHP CLI не може да изпълнява проверките на Doctor."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Проверките на Doctor завършиха неуспешно или надвишиха времевия си лимит. Прегледайте журнала на Doctor."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Графиките спряха да се обновяват"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Опитването е бавно"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Устройства липсват или са недостъпни"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Липсват известявания от Doctor"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Проверете планировчика на полера и журнала на засегнатия полер, след което потвърдете нов завършен цикъл."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "Събирането на данни може да е спряло."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Събраните стойности може да не достигат до диска."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Проверете изходната опашка и историята на записване на Boost; уверете се, че опашката се изпразва и времевите отметки на RRD напредват."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Проверете свободния капацитет на хранилището, правата на работните директории и последното обновяване на RRD; вземете предвид отложените записи."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "Съхранението на RRD изисква проверка."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Събирането на данни може да надвишава времевия си бюджет."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Сравнете продължителността на цикъла с интервала на запитване и проверете изтеклите времена за отговор на устройствата, преди да увеличавате паралелността."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Сравнете броячите на базата данни по време на бавен цикъл и прегледайте плановете на заявките, преди да променяте сървърните ограничения."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Натоварването на базата данни може да допринася за бавното запитване."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Предпоставките за събиране или мрежовата достъпност може да са нарушени."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Проверете правата, достъпността, данните за удостоверяване и назначения полер за засегнатото устройство чрез диагностиката на Cacti."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Планираните проверки или доставката на електронна поща изискват внимание."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Проверете настройките за планиране и получателите, прегледайте запазените опити за доставка и изпратете тестово писмо от Cacti."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Възможните причини изискват проверка; съвпадащите проверки не установяват първопричина."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Наличните наблюдения не установяват причина. Стартирайте нова диагностика и проучете симптома директно."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Поне 24 часа от стартирането на сървъра и FLUSH STATUS. Броячите са кумулативни и може да са нулирани по различно време; потвърдете тенденциите при представително натоварване преди настройка."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "Кумулативните препоръки за настройка са отложени: осигурете валидно време на работа и поне 24 часа от стартирането и FLUSH STATUS. Липсващи метрики или несъгласувана извадка не могат да определят състоянието на базата данни."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Прозорец за наблюдение на базата данни"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Метриките за връзките са недостъпни или невалидни. Проверете достъпа до SHOW GLOBAL STATUS и SHOW GLOBAL VARIABLES; не приемайте липсващите метрики за неактивен сървър."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Текущи връзки: %.0f / %.0f (%s); отчетен пик: %.0f (%s от текущия лимит)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Прегледайте пула от връзки и паралелността на полера. Проверете наличната памет на сървъра с базата данни, преди да увеличавате max_connections; историческият пик може да отразява по-стар лимит."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Капацитет на връзките"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Четения от буферния пул на InnoDB"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Прегледайте плановете на заявките и работния набор от данни. Обмислете промяна на innodb_buffer_pool_size едва след измерване на свободната памет на хоста на базата данни; кумулативният дял на пропуските сам по себе си не доказва недостиг на памет."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Временни таблици на диска"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Прегледайте плановете на заявките, сортирането, групирането и типовете данни на временните таблици, преди да променяте лимитите за памет. Някои таблици задължително използват диск; ограниченията за памет и отчитането се различават между версиите на MySQL и MariaDB."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Създаване на нишки за връзки"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Прегледайте повторното използване на връзки и thread_cache_size. Проверете режима за обработка на нишки на сървъра преди настройка; реализациите с пул от нишки не се държат като сървъри в режим one-thread-per-connection."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Прегледайте журналирането на бавни заявки, long_query_time и плановете на заявките, преди да променяте сървърните буфери. Този брояч зависи от конфигурирания праг за бавни заявки и не посочва отделните заявки."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Бавни заявки"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Кумулативните препоръки са отложени, докато прозорецът за наблюдение стане достатъчен."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "Препоръката за кеша на нишките не се оценява: thread_handling е недостъпен или не е one-thread-per-connection. Вместо това прегледайте активната реализация на пула от нишки."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Необходими броячи липсват или са невалидни: %s, %s. Проверете поддръжката във версията на сървъра и правата за наблюдение."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "Брояч е бил нулиран след предишната извадка; съберете нов представителен интервал преди настройка."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Недостатъчна активност: %.0f %s; за тази препоръка са необходими поне %d наблюдения."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Броячите са несъгласувани или са били нулирани независимо един от друг. Съберете нова представителна извадка преди настройка."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "Интервалната извадка е твърде малка или броячите са нулирани; съберете нов представителен интервал преди настройка."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Интервално %s / %s: %.0f / %.0f (%s); праг за проучване: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Кумулативно %s / %s: %.0f / %.0f (%s); праг за проучване: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Този брояч може да пропуска временни файлове, изобразени в паметта при MySQL; ниското съотношение не изключва използването на диск."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "Препоръката за redo журнала е отложена, докато прозорецът за наблюдение стане достатъчен и Innodb_log_waits е наличен."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Кумулативна стойност на Innodb_log_waits: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Проучете размера на трансакциите, натоварването на буфера на журнала и латентността на хранилището. Проверете отново честотата под натоварване, преди да обмисляте innodb_log_buffer_size; този исторически брой не доказва текущо забавяне."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Изчаквания на буфера на журнала на InnoDB"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "инсталирания composer.json на Cacti"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "изискване на инсталатора на Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "Съвместимост на PHP с инсталирания Cacti"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Работещ PHP %s; инсталиран Cacti %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Не можа да се определи изискването за PHP на Cacti. Проверете инсталирания composer.json на Cacti или документацията на изданието; Doctor не приема съвместимост по подразбиране."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s и < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Изисква %s (%s). Работещият PHP отговаря на това изискване."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Изисква %s (%s). Работещият PHP не отговаря на това изискване."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Открита е версия %s; Doctor изисква Cacti 1.2.20 или по-нова."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Поддържана версия на Cacti"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Официална поддръжка за сигурност на PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Това проверява клона на изданието на PHP, а не дали текущата корекционна версия е актуална или дали доставчикът на операционната система пренася поправки назад. Съвместимостта с Cacti се проверява отделно."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Работещ PHP %s; статусът на официалната поддръжка за сигурност е неизвестен или това е предварителна версия. Проверете https://www.php.net/supported-versions.php и обновете данните за поддръжка на Doctor."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Работещ PHP %s; PHP %s получава официални поправки за сигурност до %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Работещ PHP %s; PHP %s вече не получава официални поправки за сигурност; поддръжката приключи на %s. Надстройте до поддържан клон на PHP, съвместим с вашата инсталация на Cacti, или потвърдете поддръжката за сигурност с доставчика на операционната ви система."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Необходими разширения за текущия CLI PHP"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Необходими разширения за уеб PHP"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Липсват: %s. Инсталирайте ги чрез пакетния мениджър на операционната система."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Всички PHP разширения, изисквани от инсталатора на Cacti, са заредени в този PHP контекст."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "Doctor не изпълнява конфигурирани изпълними файлове, докато работи като root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "Името на файла %s не е очакваното за %s, затова Doctor не го изпълни."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "Doctor работи като root, поради което проверките за права описват root вместо акаунта на уеб сървъра или полера, конфигурираните изпълними файлове не се стартират и поправките се отказват. Стартирайте Doctor като потребителя на полера на Cacti."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Привилегии на Doctor"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "Doctor работи без root привилегии."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Необходими разширения за CLI PHP"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Конфигурираният изпълним файл за PHP CLI не е наличен, затова разширенията му не могат да бъдат проверени."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "shell_exec() е деактивирана, затова Doctor не може да сравни разширенията на CLI PHP с изискванията на Cacti."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "Конфигурираният изпълним файл за PHP CLI не върна валиден списък с разширения."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "Липсват в CLI PHP: %s. В много системи конфигурациите за уеб PHP и CLI PHP са отделни."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "Конфигурираният PHP CLI разполага с всички разширения, изисквани от Cacti."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "Поддръжка на GD TrueType"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Препоръчителни функции на PHP"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Недостъпни: %s. Cacti може да работи без тези функции, но свързаната функционалност може да е ограничена."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "Незадължителните функции gettext, SNMP и GD TrueType са налични."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "memory_limit е %s (препоръчва се %dM или повече)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "max_execution_time е %d секунди (препоръчва се 60 или повече)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "date.timezone не е зададена"

#: doctor_functions.php
msgid "unset"
msgstr "не е зададено"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Текущи стойности: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "Конфигурация на PHP средата за изпълнение"

#: doctor_functions.php
msgid "Database connection"
msgstr "Връзка с базата данни"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
msgstr "Заявката е неуспешна: %s"

#: doctor_functions.php
msgid "A read-only query completed successfully."
msgstr "Заявка само за четене завърши успешно."

#: doctor_functions.php
msgid "The database returned an unexpected result."
msgstr "Базата данни върна неочакван резултат."

#: doctor_functions.php
#, php-format
msgid "Doctor could not determine the database server version from %s."
msgstr "Doctor не можа да определи версията на сървъра на базата данни от %s."

#: doctor_functions.php
msgid "Supported database server"
