#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "تعمیرهای موجود: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "قالب ناشناخته %s. از text، json، nagios یا prometheus استفاده کنید."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "پوشش‌دهی اطلاعات حساس کامل نشد، بنابراین %s نوشته نشد."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "%s نوشته شد. پیش از اشتراک‌گذاری آن را بازبینی کنید؛ مقادیر پس از نام‌های password، secret، token و community پوشانده شده‌اند."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "تعمیر ناشناخته"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "خودداری از تعمیر بدون --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "یک نشانه پشتیبانی‌شده و خروجی متنی یا JSON انتخاب کنید."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "هشدار پذیرفته‌شده"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "دسترس‌پذیری دستگاه"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "ارزیابی دسترسی‌های دستگاه انجام نشد."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "PHP CLI پیکربندی‌شده نمی‌تواند بررسی‌های Doctor را اجرا کند."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "بررسی‌های Doctor با خطا مواجه شدند یا از مهلت زمانی خود فراتر رفتند. گزارش Doctor را بررسی کنید."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "به‌روزرسانی نمودارها متوقف شده است"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "نمونه‌برداری کند است"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "دستگاه‌ها ناموجود یا غیرقابل دسترس هستند"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "هشدارهای Doctor وجود ندارند"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "زمان‌بند poller و گزارش poller متأثر را بررسی کنید، سپس تکمیل یک چرخه جدید را تأیید نمایید."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "ممکن است جمع‌آوری متوقف شده باشد."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "ممکن است مقادیر جمع‌آوری‌شده به دیسک نرسند."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "صف خروجی و تاریخچه تخلیه Boost را بررسی کنید؛ اطمینان حاصل نمایید که صف تخلیه می‌شود و برچسب‌های زمانی RRD پیش می‌روند."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "ظرفیت ذخیره‌سازی، دسترسی‌های دایرکتوری زمان اجرا و آخرین به‌روزرسانی RRD را بررسی کنید؛ نوشتن‌های به تعویق افتاده را نیز در نظر بگیرید."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "ذخیره‌سازی RRD نیاز به بررسی دارد."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "ممکن است عملیات جمع‌آوری از بودجه زمانی خود فراتر رفته باشد."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "پیش از افزایش هم‌زمانی، مدت چرخه را با بازه نظرسنجی مقایسه کرده و وقفه‌های زمانی دستگاه را بررسی کنید."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "پیش از تغییر محدودیت‌های سرور، شمارنده‌های پایگاه داده را در طول یک چرخه کند مقایسه کرده و طرح‌های پرس‌وجو را بررسی کنید."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "فشار پایگاه داده ممکن است در کندی نظرسنجی نقش داشته باشد."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "ممکن است پیش‌نیازهای جمع‌آوری یا دسترس‌پذیری با خطا مواجه شده باشند."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "با استفاده از ابزارهای عیب‌یابی Cacti، دسترسی‌ها، دسترس‌پذیری، اطلاعات احراز هویت و poller اختصاص‌یافته به دستگاه متأثر را بررسی کنید."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "بررسی‌های زمان‌بندی‌شده یا تحویل ایمیل نیاز به توجه دارند."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "تنظیمات زمان‌بندی و گیرندگان را بررسی کنید، تلاش‌های تحویل نگهداری‌شده را بازبینی نمایید و یک ایمیل آزمایشی Cacti ارسال کنید."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "علت‌های احتمالی نیاز به تأیید دارند؛ مطابقت بررسی‌ها علت ریشه‌ای را اثبات نمی‌کند."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "با مشاهدات موجود هیچ علتی اثبات نمی‌شود. عیب‌یابی جدید اجرا کنید و نشانه را مستقیماً بررسی نمایید."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "حداقل ۲۴ ساعت از راه‌اندازی سرور و FLUSH STATUS گذشته باشد. شمارنده‌ها تجمعی هستند و ممکن است تاریخچه بازنشانی متفاوتی داشته باشند؛ پیش از تنظیم، روندها را در یک بار کاری نمونه تأیید کنید."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "توصیه تنظیم تجمعی به تعویق افتاده است: زمان کارکرد معتبر و حداقل ۲۴ ساعت از راه‌اندازی و FLUSH STATUS به‌دست آورید. معیارهای ناموجود یا نمونه ناسازگار نمی‌توانند سلامت پایگاه داده را اثبات کنند."

#: doctor_functions.php
msgid "Database observation window"
msgstr "بازه مشاهده پایگاه داده"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "معیارهای اتصال در دسترس نیستند یا نامعتبرند. دسترسی به SHOW GLOBAL STATUS و SHOW GLOBAL VARIABLES را بررسی کنید؛ معیارهای ناموجود را به معنای سرور بیکار در نظر نگیرید."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "اتصال‌های فعلی: %.0f / %.0f (%s)؛ اوج ثبت‌شده: %.0f (%s از محدودیت فعلی)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "اشتراک‌گذاری اتصال و هم‌زمانی poller را بازبینی کنید. پیش از افزایش max_connections، فضای خالی حافظه میزبان پایگاه داده را بررسی نمایید؛ اوج تاریخی ممکن است نشان‌دهنده محدودیت قدیمی‌تری باشد."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "ظرفیت اتصال"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "خواندن‌های مخزن بافر InnoDB"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "طرح‌های پرس‌وجو و مجموعه کاری را بازبینی کنید. تنها پس از اندازه‌گیری حافظه در دسترس در میزبان پایگاه داده، تغییر innodb_buffer_pool_size را در نظر بگیرید؛ نسبت عدم اصابت تجمعی به‌تنهایی فشار حافظه را اثبات نمی‌کند."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "جدول‌های موقت روی دیسک"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "پیش از تغییر محدودیت‌های حافظه، طرح‌های پرس‌وجو، مرتب‌سازی، گروه‌بندی و نوع داده‌های جدول موقت را بازبینی کنید. برخی جدول‌ها ناچار به استفاده از دیسک هستند؛ محدودیت‌های حافظه و نحوه محاسبه بین نسخه‌های MySQL و MariaDB متفاوت است."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "ایجاد رشته‌های اتصال"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "استفاده مجدد از اتصال و thread_cache_size را بازبینی کنید. پیش از تنظیم، حالت مدیریت رشته سرور را بررسی نمایید؛ پیاده‌سازی‌های مخزن رشته رفتاری مانند سرورهای یک-رشته-به‌ازای-هر-اتصال ندارند."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "پیش از تغییر بافرهای سرور، ثبت گزارش پرس‌وجوی کند، long_query_time و طرح‌های پرس‌وجو را بازبینی کنید. این شمارنده به آستانه پیکربندی‌شده پرس‌وجوی کند بستگی دارد و دستورهای منفرد را شناسایی نمی‌کند."

#: doctor_functions.php
msgid "Slow statements"
msgstr "دستورهای کند"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "توصیه تجمعی تا زمانی که بازه مشاهده کافی شود به تعویق افتاده است."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "توصیه کش رشته ارزیابی نشده است: thread_handling در دسترس نیست یا یک-رشته-به‌ازای-هر-اتصال نیست. به‌جای آن، پیاده‌سازی فعال مخزن رشته را بازبینی کنید."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "شمارنده‌های الزامی وجود ندارند یا نامعتبرند: %s، %s. پشتیبانی نسخه سرور و دسترسی‌های پایش را بررسی کنید."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "از نمونه قبلی یک شمارنده بازنشانی شده است؛ پیش از تنظیم، یک بازه نمونه دیگر جمع‌آوری کنید."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "فعالیت ناکافی: %.0f %s؛ برای این توصیه حداقل %d مشاهده نیاز است."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "شمارنده‌ها ناسازگار هستند یا به‌طور مستقل بازنشانی شده‌اند. پیش از تنظیم، یک نمونه معرف جدید جمع‌آوری کنید."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "نمونه بازه بسیار کوچک است یا شمارنده‌ها بازنشانی شده‌اند؛ پیش از تنظیم، یک بازه معرف دیگر جمع‌آوری کنید."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "بازه %s / %s: %.0f / %.0f (%s)؛ آستانه بررسی: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "تجمعی %s / %s: %.0f / %.0f (%s)؛ آستانه بررسی: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "این شمارنده ممکن است فایل‌های موقت نگاشت‌شده در حافظه را در MySQL نادیده بگیرد؛ نسبت پایین استفاده از دیسک را رد نمی‌کند."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "توصیه redo-log تا زمانی که بازه مشاهده کافی شود و Innodb_log_waits در دسترس باشد به تعویق افتاده است."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "مقدار تجمعی Innodb_log_waits: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "اندازه تراکنش‌ها، فشار بافر گزارش و تأخیر ذخیره‌سازی را بررسی کنید. پیش از بررسی تغییر innodb_log_buffer_size، نرخ را زیر بار دوباره ارزیابی نمایید؛ این شمارش تاریخی مدرکی برای توقف فعلی نیست."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "انتظارهای بافر گزارش InnoDB"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "composer.json نصب‌شده Cacti"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "پیش‌نیاز نصب‌کننده Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "سازگاری PHP با Cacti نصب‌شده"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "PHP در حال اجرا %s؛ Cacti نصب‌شده %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "پیش‌نیاز PHP برای Cacti مشخص نشد. composer.json نصب‌شده Cacti یا مستندات انتشار را بررسی کنید؛ Doctor سازگاری را پیش‌فرض نمی‌گیرد."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s و < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "نیازمند %s (%s) است. PHP در حال اجرا این پیش‌نیاز را برآورده می‌کند."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "نیازمند %s (%s) است. PHP در حال اجرا این پیش‌نیاز را برآورده نمی‌کند."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "%s شناسایی شد؛ Doctor به Cacti 1.2.20 یا جدیدتر نیاز دارد."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "نسخه پشتیبانی‌شده Cacti"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "پشتیبانی امنیتی بالادستی PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "این مورد شاخه انتشار PHP را بررسی می‌کند، نه اینکه آیا این انتشار وصله به‌روز است یا خیر یا ارائه‌دهنده سیستم‌عامل شما اصلاحات را پس‌پورت می‌کند یا نه. سازگاری Cacti به‌طور جداگانه بررسی می‌شود."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "PHP در حال اجرا %s؛ وضعیت پشتیبانی امنیتی بالادستی نامشخص است یا این یک پیش‌انتشار است. https://www.php.net/supported-versions.php را بررسی کرده و داده‌های پشتیبانی Doctor را به‌روزرسانی کنید."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "PHP در حال اجرا %s؛ PHP %s اصلاحات امنیتی بالادستی را تا %s دریافت می‌کند."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "PHP در حال اجرا %s؛ PHP %s دیگر اصلاحات امنیتی بالادستی دریافت نمی‌کند؛ پشتیبانی در %s به پایان رسید. به یک شاخه پشتیبانی‌شده PHP سازگار با نصب Cacti خود ارتقا دهید یا نگهداری امنیتی را با ارائه‌دهنده سیستم‌عامل خود تأیید کنید."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "افزونه‌های الزامی فعلی CLI PHP"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "افزونه‌های الزامی وب PHP"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "موجود نیست: %s. آن‌ها را از طریق مدیر بسته سیستم‌عامل نصب کنید."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "تمام افزونه‌های PHP مورد نیاز نصب‌کننده Cacti در این زمینه PHP بارگذاری شده‌اند."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "Doctor هنگام اجرا با دسترسی root، باینری‌های پیکربندی‌شده را اجرا نمی‌کند."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "نام فایل %s برای %s مورد انتظار نیست، بنابراین Doctor آن را اجرا نکرد."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
