#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Reparações disponíveis: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Formato desconhecido %s. Utilize text, json, nagios ou prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Não foi possível concluir a ocultação de dados sensíveis, pelo que %s não foi escrito."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "Ficheiro %s escrito. Reveja-o antes de partilhar; os valores após nomes de palavra-passe, segredo, token e comunidade estão mascarados."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Reparação desconhecida"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Recusa de reparação sem --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Selecione um sintoma suportado e uma saída em texto ou JSON."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Aviso aceite"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Disponibilidade dos dispositivos"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Não foi possível avaliar as permissões de dispositivos."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "O PHP CLI configurado não consegue executar as verificações do Doctor."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "As verificações do Doctor falharam ou excederam o limite de tempo. Consulte o registo do Doctor."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Os gráficos deixaram de atualizar"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "O polling está lento"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Faltam dispositivos ou estão indisponíveis"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Faltam alertas do Doctor"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Verifique o agendador do poller e o registo do poller afetado e, em seguida, confirme um novo ciclo concluído."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "A recolha pode ter parado."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Os valores recolhidos podem não estar a chegar ao disco."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Inspecione a fila de saída e o histórico de descargas do Boost; verifique se a fila esvazia e se os carimbos de data/hora RRD avançam."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Verifique a capacidade de armazenamento, as permissões das diretorias de execução e a última atualização RRD; tenha em conta escritas diferidas."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "O armazenamento RRD necessita de investigação."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "O trabalho de recolha pode estar a exceder o tempo disponível."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Compare a duração do ciclo com o intervalo de polling e verifique os tempos limite dos dispositivos antes de aumentar a concorrência."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Compare os contadores da base de dados durante um ciclo lento e inspecione os planos de consulta antes de alterar os limites do servidor."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "A carga na base de dados pode estar a contribuir para a lentidão do polling."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Os pré-requisitos de recolha ou a acessibilidade podem estar a falhar."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Verifique as permissões, a acessibilidade, as credenciais e o poller atribuído do dispositivo afetado utilizando o diagnóstico do Cacti."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "As verificações agendadas ou a entrega de correio eletrónico requerem atenção."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Verifique as definições de agendamento e de destinatários, inspecione as tentativas de entrega retidas e envie um e-mail de teste do Cacti."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "As causas possíveis requerem verificação; verificações coincidentes não estabelecem uma causa raiz."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "As observações disponíveis não estabelecem qualquer causa. Execute um novo diagnóstico e investigue diretamente o sintoma."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Pelo menos 24 horas desde o arranque do servidor e FLUSH STATUS. Os contadores são cumulativos e podem ter históricos de reposição diferentes; confirme as tendências durante uma carga de trabalho representativa antes de afinar."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "O aconselhamento cumulativo de afinação está adiado: obtenha um tempo de atividade válido e pelo menos 24 horas desde o arranque e FLUSH STATUS. Métricas em falta ou uma amostra inconsistente não permitem avaliar o estado da base de dados."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Janela de observação da base de dados"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "As métricas de ligação estão indisponíveis ou são inválidas. Verifique o acesso a SHOW GLOBAL STATUS e SHOW GLOBAL VARIABLES; não interprete métricas em falta como um servidor inativo."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Ligações atuais: %.0f / %.0f (%s); pico registado: %.0f (%s do limite atual)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Reveja o agrupamento de ligações e a concorrência do poller. Verifique a margem de memória do servidor de base de dados antes de aumentar max_connections; o pico histórico pode refletir um limite anterior."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Capacidade de ligações"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Leituras do buffer pool do InnoDB"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Reveja os planos de consulta e o conjunto de trabalho. Considere innodb_buffer_pool_size apenas após medir a memória disponível no servidor de base de dados; uma taxa cumulativa de falhas de cache, por si só, não prova pressão de memória."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Tabelas temporárias em disco"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Reveja os planos de consulta, ordenação, agrupamento e tipos de dados de tabelas temporárias antes de alterar os limites de memória. Algumas tabelas têm de utilizar disco; os limites de memória e a contabilização diferem entre versões do MySQL e do MariaDB."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Criação de threads de ligação"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Reveja a reutilização de ligações e thread_cache_size. Verifique o modo de gestão de threads do servidor antes de afinar; implementações de pool de threads não se comportam como servidores one-thread-per-connection."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Reveja o registo de consultas lentas, long_query_time e os planos de consulta antes de alterar os buffers do servidor. Este contador depende do limiar configurado para consultas lentas e não identifica instruções individuais."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Instruções lentas"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Aconselhamento cumulativo adiado até que a janela de observação seja suficiente."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "O aconselhamento de cache de threads não é avaliado: thread_handling está indisponível ou não é one-thread-per-connection. Em vez disso, reveja a implementação ativa do pool de threads."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Os contadores obrigatórios estão em falta ou são inválidos: %s, %s. Verifique o suporte da versão do servidor e as permissões de monitorização."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "Um contador foi reposto desde a amostra anterior; recolha outro intervalo representativo antes de afinar."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Atividade insuficiente: %.0f %s; são necessárias pelo menos %d observações para esta recomendação."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Os contadores são inconsistentes ou foram repostos de forma independente. Recolha uma nova amostra representativa antes de afinar."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "A amostra do intervalo é demasiado pequena ou os contadores foram repostos; recolha outro intervalo representativo antes de afinar."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Intervalo %s / %s: %.0f / %.0f (%s); limiar de investigação: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Cumulativo %s / %s: %.0f / %.0f (%s); limiar de investigação: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Este contador pode omitir ficheiros temporários mapeados em memória no MySQL; uma taxa baixa não exclui a utilização de disco."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "O aconselhamento sobre o redo-log está adiado até que a janela de observação seja suficiente e Innodb_log_waits esteja disponível."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Innodb_log_waits cumulativo: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Investigue o tamanho das transações, a pressão no buffer de registo e a latência do armazenamento. Volte a verificar a taxa sob carga antes de considerar innodb_log_buffer_size; esta contagem histórica não constitui prova de um bloqueio atual."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Esperas no buffer de registo do InnoDB"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "composer.json do Cacti instalado"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "requisito do instalador do Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "Compatibilidade do PHP com o Cacti instalado"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Em execução: PHP %s; Cacti instalado: %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Não foi possível determinar o requisito de PHP do Cacti. Verifique o ficheiro composer.json do Cacti instalado ou a documentação da versão; o Doctor não presume compatibilidade."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s e < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Requer %s (%s). O PHP em execução cumpre este requisito."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Requer %s (%s). O PHP em execução não cumpre este requisito."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Detetado %s; o Doctor requer Cacti 1.2.20 ou superior."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Versão suportada do Cacti"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Suporte de segurança oficial do PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Isto verifica o ramo de lançamento do PHP, e não se esta versão de correção está atualizada ou se o fornecedor do sistema operativo faz backport de correções. A compatibilidade com o Cacti é verificada separadamente."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Em execução: PHP %s; o estado do suporte de segurança oficial é desconhecido ou trata-se de uma pré-versão. Consulte https://www.php.net/supported-versions.php e atualize os dados de suporte do Doctor."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Em execução: PHP %s; o PHP %s recebe correções de segurança oficiais até %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Em execução: PHP %s; o PHP %s já não recebe correções de segurança oficiais; o suporte terminou em %s. Atualize para um ramo PHP suportado e compatível com a sua instalação do Cacti, ou confirme a manutenção de segurança junto do fornecedor do sistema operativo."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Extensões obrigatórias do PHP CLI atual"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Extensões obrigatórias do PHP web"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Em falta: %s. Instale-as através do gestor de pacotes do sistema operativo."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Todas as extensões PHP exigidas pelo instalador do Cacti estão carregadas neste contexto PHP."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "O Doctor não executa binários configurados quando corre como root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "O nome de ficheiro %s não é o esperado para %s, pelo que o Doctor não o executou."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "O Doctor está a correr como root, pelo que as verificações de permissões refletem o utilizador root em vez da conta do servidor web ou do poller, os binários configurados não são executados e as reparações são recusadas. Execute o Doctor como o utilizador do poller do Cacti."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Privilégios do Doctor"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "O Doctor está a correr sem privilégios de root."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Extensões obrigatórias do PHP CLI"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "O executável PHP CLI configurado está indisponível, pelo que não é possível verificar as respetivas extensões."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "shell_exec() está desativada, pelo que o Doctor não consegue comparar as extensões do PHP CLI com os requisitos do Cacti."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "O executável PHP CLI configurado não devolveu uma lista válida de extensões."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "Em falta no PHP CLI: %s. Em muitos sistemas, as configurações do PHP web e do PHP CLI são separadas."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "O PHP CLI configurado dispõe de todas as extensões exigidas pelo Cacti."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "Suporte GD TrueType"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Funcionalidades PHP recomendadas"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Indisponível: %s. O Cacti pode funcionar sem estas funcionalidades, mas as funções relacionadas podem ficar limitadas."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "As funcionalidades opcionais gettext, SNMP e GD TrueType estão disponíveis."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "memory_limit está definido como %s (recomenda-se %dM ou mais)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "max_execution_time está definido como %d segundos (recomenda-se 60 ou mais)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "date.timezone não está definido"

#: doctor_functions.php
msgid "unset"
msgstr "não definido"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Valores atuais: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "Configuração de execução do PHP"

#: doctor_functions.php
msgid "Database connection"
msgstr "Ligação à base de dados"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
msgstr "A consulta falhou: %s"

#: doctor_functions.php
msgid "A read-only query completed successfully."
msgstr "Uma consulta só de leitura foi concluída com sucesso."

#: doctor_functions.php
msgid "The database returned an unexpected result."
msgstr "A base de dados devolveu um resultado inesperado."

#: doctor_functions.php
#, php-format
msgid "Doctor could not determine the database server version from %s."
msgstr "O Doctor não conseguiu determinar a versão do servidor de base de dados a partir de %s."

#: doctor_functions.php
msgid "Supported database server"
msgstr "Servidor de base de dados suportado"

#: doctor_functions.php
#, php-format
msgid "%s %s detected; this Cacti branch recommends %s %s or newer."
msgstr "Detetado %s %s; este ramo do Cacti recomenda %s %s ou superior."

#: doctor_functions.php
#, php-format
msgid "Database character set is %s and collation is %s. Cacti requires utf8mb4."
msgstr "O conjunto de carateres da base de dados é %s e o agrupamento é %s. O Cacti requer utf8mb4."

#: doctor_functions.php
msgid "unknown"
msgstr "desconhecido"

#: doctor_functions.php
msgid "Database character set"
msgstr "Conjunto de carateres da base de dados"

#: doctor_functions.php
msgid "Database timezone support"
msgstr "Suporte de fusos horários na base de dados"

#: doctor_functions.php
msgid "The Cacti database account cannot read mysql.time_zone_name. Grant SELECT access and populate the database timezone tables."
msgstr "A conta de base de dados do Cacti não consegue ler mysql.time_zone_name. Conceda acesso SELECT e preencha as tabelas de fusos horários da base de dados."

#: doctor_functions.php
#, php-format
msgid "The database timezone table is accessible and contains %d entries."
msgstr "A tabela de fusos horários da base de dados está acessível e contém %d entradas."

#: doctor_functions.php
msgid "The database timezone table is accessible but empty. Populate the system timezone tables."
msgstr "A tabela de fusos horários da base de dados está acessível, mas está vazia. Preencha as tabelas de fusos horários do sistema."

#: doctor_functions.php
msgid "Core tables used by Cacti are present."
msgstr "As tabelas principais utilizadas pelo Cacti estão presentes."

#: doctor_functions.php
#, php-format
msgid "Missing core tables: %s. Restore or upgrade the database before attempting other repairs."
msgstr "Tabelas principais em falta: %s. Restaure ou atualize a base de dados antes de tentar outras reparações."

#: doctor_functions.php
msgid "Core database tables"
msgstr "Tabelas principais da base de dados"

#: doctor_functions.php
#, php-format
msgid "%s is missing (%s)"
msgstr "%s está em falta (%s)"

#: doctor_functions.php
#, php-format
msgid "%s is not writable (%s)"
msgstr "%s não tem permissão de escrita (%s)"

#: doctor_functions.php
msgid "Runtime directories"
msgstr "Diretorias de execução"

#: doctor_functions.php
msgid "The cache, log, and RRA directories exist and are writable."
msgstr "As diretorias de cache, registo e RRA existem e têm permissão de escrita."

#: doctor_functions.php
msgid "Cacti configuration file"
msgstr "Ficheiro de configuração do Cacti"

#: doctor_functions.php
msgid "include/config.php is missing or unreadable."
msgstr "include/config.php está em falta ou não é legível."

#: doctor_functions.php
msgid "include/config.php is readable. POSIX mode-bit checks do not apply on Windows."
msgstr "include/config.php é legível. As verificações de bits de modo POSIX não se aplicam no Windows."

#: doctor_functions.php
msgid "include/config.php is writable by other users. Remove world-write permission because this file contains database credentials."
msgstr "include/config.php pode ser escrito por outros utilizadores. Remova a permissão de escrita global, uma vez que este ficheiro contém credenciais da base de dados."

#: doctor_functions.php
msgid "include/config.php is group-writable. Confirm that every member of the owning group is trusted."
msgstr "include/config.php permite escrita ao grupo. Confirme que todos os membros do grupo proprietário são de confiança."

#: doctor_functions.php
msgid "include/config.php is readable by all local users and contains database credentials. Restrict it to the owner and the web server group."
msgstr "include/config.php é legível por todos os utilizadores locais e contém credenciais da base de dados. Restrinja-o ao proprietário e ao grupo do servidor web."

#: doctor_functions.php
msgid "include/config.php is readable and is not world-readable, group-writable, or world-writable."
msgstr "include/config.php é legível e não permite leitura global, escrita ao grupo nem escrita global."

#: doctor_functions.php
msgid "Cacti log file"
msgstr "Ficheiro de registo do Cacti"

#: doctor_functions.php
msgid "The log file does not exist. Its parent directory is not writable."
msgstr "O ficheiro de registo não existe. A respetiva diretoria mãe não tem permissão de escrita."

#: doctor_functions.php
msgid "The log file does not exist. Its parent directory is writable, so Cacti can create it."
