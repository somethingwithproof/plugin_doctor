msgstr "Beri amaran selepas bilangan selang pengumpulan ini tanpa kemas kini fail (1 hingga 100)."

#: setup.php
msgid "Additional disk-write delay for external caching (0 to 86400). Boost adds its own allowance."
msgstr "Kelewatan tulis-cakera tambahan untuk pengcachean luaran (0 hingga 86400). Boost menambah kelonggarannya sendiri."

#: setup.php
msgid "Deferred RRD Write Allowance (seconds)"
msgstr "Kelonggaran Tulis RRD Tertangguh (saat)"

