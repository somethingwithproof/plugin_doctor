msgid "Poller Run Time Warning (percent)"
msgstr "Упозорење за време рада poller-а (проценти)"

#: setup.php
msgid "Warn when the last main-poller run used this share of the polling interval. Runs that take the whole interval always fail."
msgstr "Упозори када је последње покретање главног poller-а потрошило овај удео интервала прикупљања. Покретања која трају цео интервал увек пријављују грешку."

#: setup.php
msgid "RRA Disk Free Warning (percent)"
msgstr "Упозорење за слободан простор на RRA диску (проценти)"

#: setup.php
msgid "Warn when free space on the RRA file system drops below this percentage."
msgstr "Упозори када слободан простор на RRA систему датотека падне испод овог процента."

#: setup.php
msgid "Fail when free space on the RRA file system drops below this percentage."
msgstr "Пријави грешку када слободан простор на RRA систему датотека падне испод овог процента."

#: setup.php
msgid "RRA Disk Free Failure (percent)"
msgstr "Грешка за слободан простор на RRA диску (проценти)"

#: setup.php
msgid "Clock Drift Warning (seconds)"
msgstr "Упозорење за одступање сата (секунде)"

#: setup.php
msgid "Warn when the database and PHP clocks differ by more than this."
msgstr "Упозори када се сатови базе података и PHP-а разликују за више од ове вредности."

#: setup.php
msgid "Clock Drift Failure (seconds)"
msgstr "Грешка за одступање сата (секунде)"

#: setup.php
msgid "Fail when the database and PHP clocks differ by more than this."
msgstr "Пријави грешку када се сатови базе података и PHP-а разликују за више од ове вредности."

#: setup.php
msgid "RRD Stale Intervals"
msgstr "Интервали застарелости RRD датотека"

#: setup.php
msgid "Warn after this many collection intervals without a file update (1 to 100)."
msgstr "Упозори након оволико интервала прикупљања без ажурирања датотеке (1 до 100)."

#: setup.php
msgid "Additional disk-write delay for external caching (0 to 86400). Boost adds its own allowance."
msgstr "Додатно кашњење записа на диск за спољно кеширање (0 до 86400). Boost додаје сопствено дозвољено кашњење."

#: setup.php
msgid "Deferred RRD Write Allowance (seconds)"
msgstr "Дозвољено кашњење одложеног RRD уписа (секунде)"

#: setup.php
