#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Reparos disponíveis: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Formato desconhecido %s. Use text, json, nagios ou prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Não foi possível concluir a ocultação de dados sensíveis, portanto %s não foi gravado."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "%s gravado. Revise antes de compartilhar; os valores após password, secret, token e nomes de community estão mascarados."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Reparo desconhecido"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Recusando reparar sem --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Selecione um sintoma compatível e saída em texto ou JSON."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Aviso aceito"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Disponibilidade do dispositivo"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Não foi possível avaliar as permissões do dispositivo."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "O PHP CLI configurado não pode executar as verificações do Doctor."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "As verificações do Doctor falharam ou excederam o tempo limite. Revise o registro do Doctor."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Os gráficos pararam de atualizar"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "A coleta está lenta"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Dispositivos estão ausentes ou indisponíveis"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Os alertas do Doctor estão ausentes"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Verifique o agendador do poller e o log do poller afetado e, em seguida, confirme um novo ciclo concluído."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "A coleta pode ter parado."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Os valores coletados podem não estar chegando ao disco."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Inspecione a fila de saída e o histórico de despejo do Boost; verifique se a fila é esvaziada e se os timestamps RRD avançam."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Verifique a capacidade de armazenamento, as permissões do diretório de execução e a última atualização RRD; considere gravações adiadas."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "O armazenamento RRD precisa de investigação."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "O trabalho de coleta pode estar excedendo o tempo limite."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Compare a duração do ciclo com o intervalo de polling e inspecione os tempos limite dos dispositivos antes de aumentar a concorrência."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Compare os contadores do banco de dados durante um ciclo lento e inspecione os planos de consulta antes de alterar os limites do servidor."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "A pressão sobre o banco de dados pode estar contribuindo para o polling lento."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Os pré-requisitos de coleta ou a acessibilidade podem estar falhando."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Verifique as permissões, a acessibilidade, as credenciais e o poller atribuído do dispositivo afetado usando os diagnósticos do Cacti."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "As verificações agendadas ou a entrega de e-mails precisam de atenção."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Verifique as configurações de agendamento e de destinatários, inspecione as tentativas de entrega retidas e envie um e-mail de teste do Cacti."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "As causas possíveis requerem verificação; verificações correspondentes não estabelecem uma causa raiz."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Nenhuma causa foi estabelecida pelas observações disponíveis. Execute novos diagnósticos e investigue o sintoma diretamente."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Pelo menos 24 horas desde a inicialização do servidor e o FLUSH STATUS. Os contadores são cumulativos e podem ter históricos de redefinição diferentes; confirme as tendências durante uma carga de trabalho representativa antes de ajustar."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "A recomendação de ajuste cumulativo foi adiada: obtenha um tempo de atividade válido e pelo menos 24 horas desde a inicialização e o FLUSH STATUS. Métricas ausentes ou uma amostra inconsistente não podem estabelecer a integridade do banco de dados."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Janela de observação do banco de dados"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "As métricas de conexão estão indisponíveis ou são inválidas. Verifique o acesso a SHOW GLOBAL STATUS e SHOW GLOBAL VARIABLES; não trate métricas ausentes como um servidor ocioso."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Conexões atuais: %.0f / %.0f (%s); pico registrado: %.0f (%s do limite atual)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Revise o pool de conexões e a concorrência do poller. Verifique a margem de memória do host do banco de dados antes de aumentar max_connections; o pico histórico pode refletir um limite anterior."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Capacidade de conexões"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Leituras do buffer pool InnoDB"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Revise os planos de consulta e o conjunto de trabalho. Considere innodb_buffer_pool_size somente após medir a memória disponível no host do banco de dados; uma taxa cumulativa de falhas por si só não comprova pressão de memória."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Tabelas temporárias em disco"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Revise os planos de consulta, ordenação, agrupamento e tipos de dados de tabelas temporárias antes de alterar os limites de memória. Algumas tabelas precisam usar o disco; os limites de memória e a contabilização diferem entre as versões do MySQL e do MariaDB."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Criação de threads de conexão"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Revise a reutilização de conexões e thread_cache_size. Verifique o modo de gerenciamento de threads do servidor antes de ajustar; implementações de pool de threads não se comportam como servidores de uma thread por conexão."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Revise o registro de consultas lentas, long_query_time e os planos de consulta antes de alterar os buffers do servidor. Esse contador depende do limite de consulta lenta configurado e não identifica instruções individuais."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Instruções lentas"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Recomendação cumulativa adiada até que a janela de observação seja suficiente."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "A recomendação de cache de threads não é avaliada: thread_handling está indisponível ou não é uma thread por conexão. Em vez disso, revise a implementação ativa de pool de threads."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Contadores obrigatórios ausentes ou inválidos: %s, %s. Verifique o suporte à versão do servidor e as permissões de monitoramento."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "Um contador foi redefinido desde a amostra anterior; colete outro intervalo representativo antes de ajustar."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Atividade insuficiente: %.0f %s; são necessárias pelo menos %d observações para esta recomendação."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Os contadores estão inconsistentes ou foram redefinidos de forma independente. Colete uma nova amostra representativa antes de ajustar."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "A amostra do intervalo é muito pequena ou os contadores foram redefinidos; colete outro intervalo representativo antes de ajustar."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Intervalo %s / %s: %.0f / %.0f (%s); limite de investigação: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Acumulado %s / %s: %.0f / %.0f (%s); limite de investigação: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Esse contador pode omitir arquivos temporários mapeados em memória no MySQL; uma taxa baixa não descarta o uso de disco."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "Recomendação de redo-log adiada até que a janela de observação seja suficiente e Innodb_log_waits esteja disponível."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Innodb_log_waits acumulado: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Investigue os tamanhos de transação, a pressão do buffer de log e a latência de armazenamento. Verifique novamente a taxa sob carga antes de considerar innodb_log_buffer_size; essa contagem histórica não é evidência de um travamento atual."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Esperas do buffer de log InnoDB"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "composer.json do Cacti instalado"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "requisito do instalador do Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "Compatibilidade do PHP com o Cacti instalado"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "PHP em execução %s; Cacti instalado %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Não foi possível determinar o requisito de PHP do Cacti. Verifique o arquivo composer.json do Cacti instalado ou a documentação da versão; o Doctor não presume compatibilidade."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s e < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Requer %s (%s). O PHP em execução atende a esse requisito."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Requer %s (%s). O PHP em execução não atende a esse requisito."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Detectado %s; o Doctor requer o Cacti 1.2.20 ou mais recente."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Versão do Cacti suportada"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Suporte de segurança upstream do PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Isso verifica o ramo de lançamento do PHP, não se esta versão de patch está atualizada ou se o fornecedor do seu sistema operacional faz backport de correções. A compatibilidade com o Cacti é verificada separadamente."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "PHP em execução %s; o status de suporte de segurança upstream é desconhecido ou esta é uma versão preliminar. Verifique https://www.php.net/supported-versions.php e atualize os dados de suporte do Doctor."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "PHP em execução %s; o PHP %s recebe correções de segurança upstream até %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "PHP em execução %s; o PHP %s não recebe mais correções de segurança upstream; o suporte terminou em %s. Atualize para um ramo do PHP suportado e compatível com a sua instalação do Cacti, ou confirme a manutenção de segurança com o fornecedor do seu sistema operacional."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Extensões PHP da CLI atual obrigatórias"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Extensões PHP da web obrigatórias"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Ausentes: %s. Instale-as pelo gerenciador de pacotes do sistema operacional."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Todas as extensões PHP obrigatórias pelo instalador do Cacti estão carregadas neste contexto do PHP."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "O Doctor não executa binários configurados enquanto estiver em execução como root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "O nome de arquivo %s não é esperado para %s, portanto o Doctor não o executou."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "O Doctor está em execução como root; portanto, as verificações de permissão descrevem o root em vez do servidor web ou da conta do poller, os binários configurados não são executados e os reparos são recusados. Execute o Doctor como o usuário do poller do Cacti."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Privilégios do Doctor"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "O Doctor está em execução sem privilégios de root."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Extensões PHP da CLI obrigatórias"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "O executável PHP CLI configurado está indisponível, portanto suas extensões não podem ser verificadas."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "shell_exec() está desabilitado, portanto o Doctor não pode comparar as extensões PHP da CLI com os requisitos do Cacti."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "O executável PHP CLI configurado não retornou uma lista de extensões válida."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "Ausentes no PHP CLI: %s. As configurações do PHP web e CLI são separadas em muitos sistemas."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "O PHP CLI configurado possui todas as extensões exigidas pelo Cacti."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "Suporte a GD TrueType"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Recursos recomendados do PHP"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Indisponível: %s. O Cacti pode funcionar sem esses recursos, mas as funcionalidades relacionadas podem ser limitadas."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "Os recursos opcionais gettext, SNMP e GD TrueType estão disponíveis."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "memory_limit é %s (%dM ou mais é recomendado)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "max_execution_time é de %d segundos (60 ou mais é recomendado)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "date.timezone não está definido"

#: doctor_functions.php
msgid "unset"
msgstr "não definido"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Valores atuais: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "Configuração de tempo de execução do PHP"

#: doctor_functions.php
msgid "Database connection"
msgstr "Conexão com o banco de dados"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
msgstr "A consulta falhou: %s"

#: doctor_functions.php
msgid "A read-only query completed successfully."
msgstr "Uma consulta somente leitura foi concluída com sucesso."

#: doctor_functions.php
msgid "The database returned an unexpected result."
msgstr "O banco de dados retornou um resultado inesperado."

#: doctor_functions.php
#, php-format
msgid "Doctor could not determine the database server version from %s."
msgstr "O Doctor não conseguiu determinar a versão do servidor de banco de dados a partir de %s."

#: doctor_functions.php
msgid "Supported database server"
msgstr "Servidor de banco de dados suportado"

#: doctor_functions.php
#, php-format
msgid "%s %s detected; this Cacti branch recommends %s %s or newer."
msgstr "%s %s detectado; este ramo do Cacti recomenda %s %s ou mais recente."

#: doctor_functions.php
#, php-format
msgid "Database character set is %s and collation is %s. Cacti requires utf8mb4."
msgstr "O conjunto de caracteres do banco de dados é %s e a collation é %s. O Cacti requer utf8mb4."

#: doctor_functions.php
msgid "unknown"
msgstr "desconhecido"

#: doctor_functions.php
msgid "Database character set"
msgstr "Conjunto de caracteres do banco de dados"

#: doctor_functions.php
msgid "Database timezone support"
msgstr "Suporte a fuso horário do banco de dados"

#: doctor_functions.php
msgid "The Cacti database account cannot read mysql.time_zone_name. Grant SELECT access and populate the database timezone tables."
msgstr "A conta de banco de dados do Cacti não consegue ler mysql.time_zone_name. Conceda acesso SELECT e preencha as tabelas de fuso horário do banco de dados."

#: doctor_functions.php
#, php-format
msgid "The database timezone table is accessible and contains %d entries."
msgstr "A tabela de fuso horário do banco de dados está acessível e contém %d entradas."

#: doctor_functions.php
msgid "The database timezone table is accessible but empty. Populate the system timezone tables."
msgstr "A tabela de fuso horário do banco de dados está acessível, mas vazia. Preencha as tabelas de fuso horário do sistema."

#: doctor_functions.php
msgid "Core tables used by Cacti are present."
msgstr "As tabelas principais usadas pelo Cacti estão presentes."

#: doctor_functions.php
#, php-format
msgid "Missing core tables: %s. Restore or upgrade the database before attempting other repairs."
msgstr "Tabelas principais ausentes: %s. Restaure ou atualize o banco de dados antes de tentar outros reparos."

#: doctor_functions.php
msgid "Core database tables"
msgstr "Tabelas principais do banco de dados"

#: doctor_functions.php
#, php-format
msgid "%s is missing (%s)"
msgstr "%s está ausente (%s)"

#: doctor_functions.php
#, php-format
msgid "%s is not writable (%s)"
msgstr "%s não tem permissão de gravação (%s)"

#: doctor_functions.php
msgid "Runtime directories"
msgstr "Diretórios de execução"

#: doctor_functions.php
msgid "The cache, log, and RRA directories exist and are writable."
msgstr "Os diretórios de cache, log e RRA existem e têm permissão de gravação."

#: doctor_functions.php
msgid "Cacti configuration file"
msgstr "Arquivo de configuração do Cacti"

#: doctor_functions.php
msgid "include/config.php is missing or unreadable."
msgstr "include/config.php está ausente ou ilegível."

#: doctor_functions.php
msgid "include/config.php is readable. POSIX mode-bit checks do not apply on Windows."
msgstr "include/config.php está legível. As verificações de bits de modo POSIX não se aplicam no Windows."

#: doctor_functions.php
msgid "include/config.php is writable by other users. Remove world-write permission because this file contains database credentials."
msgstr "include/config.php pode ser gravado por outros usuários. Remova a permissão de gravação pública porque este arquivo contém credenciais do banco de dados."

#: doctor_functions.php
msgid "include/config.php is group-writable. Confirm that every member of the owning group is trusted."
msgstr "include/config.php pode ser gravado pelo grupo. Confirme que todos os membros do grupo proprietário são confiáveis."

#: doctor_functions.php
msgid "include/config.php is readable by all local users and contains database credentials. Restrict it to the owner and the web server group."
msgstr "include/config.php pode ser lido por todos os usuários locais e contém credenciais do banco de dados. Restrinja-o ao proprietário e ao grupo do servidor web."

#: doctor_functions.php
msgid "include/config.php is readable and is not world-readable, group-writable, or world-writable."
msgstr "include/config.php está legível e não permite leitura pública, gravação pelo grupo ou gravação pública."

#: doctor_functions.php
msgid "Cacti log file"
msgstr "Arquivo de log do Cacti"

#: doctor_functions.php
msgid "The log file does not exist. Its parent directory is not writable."
msgstr "O arquivo de log não existe. Seu diretório pai não tem permissão de gravação."

#: doctor_functions.php
msgid "The log file does not exist. Its parent directory is writable, so Cacti can create it."
msgstr "O arquivo de log não existe. Seu diretório pai tem permissão de gravação, portanto o Cacti pode criá-lo."

#: doctor_functions.php
msgid "The configured log path must be a readable and writable regular file."
msgstr "O caminho de log configurado deve ser um arquivo regular legível e gravável."

#: doctor_functions.php
