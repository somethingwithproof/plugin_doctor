#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Tillgängliga reparationer: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Okänt format %s. Använd text, json, nagios eller prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Maskeringen kunde inte slutföras, så %s skrevs inte."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "Skrev %s. Granska den innan du delar; värden efter password, secret, token och community-namn är maskerade."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Okänd reparation"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Vägrar reparera utan --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Välj ett symptom som stöds samt text- eller JSON-utdata."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Accepterad varning"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Enhetstillgänglighet"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Enhetsbehörigheter kunde inte utvärderas."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "Det konfigurerade PHP CLI kan inte köra Doctor-kontroller."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Doctor-kontroller misslyckades eller överskred sin tidsgräns. Granska Doctor-loggen."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Grafer slutade uppdateras"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Polling är långsam"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Enheter saknas eller är otillgängliga"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Doctor-larm saknas"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Kontrollera poller-schemaläggaren och den berörda poller-loggen, och verifiera sedan att en ny cykel slutförs."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "Insamlingen kan ha stannat."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Insamlade värden kanske inte når disken."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Granska utdatakön och tömningshistoriken för Boost; verifiera att kön töms och att RRD-tidsstämplar går framåt."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Kontrollera lagringskapacitet, behörigheter för körtidskataloger och den senaste RRD-uppdateringen; ta hänsyn till fördröjda skrivningar."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "RRD-lagringen behöver undersökas."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Insamlingsarbetet kan överskrida sin tidsbudget."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Jämför cykeltiden med pollingintervallet och granska enheternas tidsgränser innan du ökar samtidigheten."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Jämför databasräknare under en långsam cykel och granska frågeplaner innan du ändrar servergränser."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Databasbelastning kan bidra till långsam polling."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Förutsättningar för insamling eller nåbarhet kan brista."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Verifiera den berörda enhetens behörigheter, nåbarhet, inloggningsuppgifter och tilldelad poller med hjälp av Cacti-diagnostik."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Schemalagda kontroller eller e-postleverans kräver uppmärksamhet."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Verifiera schemaläggnings- och mottagarinställningar, granska sparade leveransförsök och skicka ett testmejl från Cacti."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Möjliga orsaker kräver verifiering; matchande kontroller fastställer inte någon grundorsak."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Ingen orsak kan fastställas utifrån tillgängliga observationer. Kör ny diagnostik och undersök symtomet direkt."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Minst 24 timmar sedan serverstart och FLUSH STATUS. Räknare är kumulativa och kan ha olika återställningshistorik; bekräfta trender under en representativ arbetsbelastning före justering."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "Kumulativa justeringsråd skjuts upp: hämta giltig drifttid och minst 24 timmar sedan start och FLUSH STATUS. Saknade mätvärden eller ett inkonsekvent stickprov kan inte fastställa databasens hälsa."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Observationsfönster för databas"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Anslutningsmätvärden är otillgängliga eller ogiltiga. Kontrollera åtkomsten till SHOW GLOBAL STATUS och SHOW GLOBAL VARIABLES; behandla inte saknade mätvärden som en overksam server."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Aktuella anslutningar: %.0f / %.0f (%s); registrerad topp: %.0f (%s av nuvarande gräns)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Se över anslutningspoolning och poller-samtidighet. Kontrollera minnesutrymmet på databasvärden innan du höjer max_connections; den historiska toppen kan återspegla en äldre gräns."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Anslutningskapacitet"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Läsningar i InnoDB-buffertpool"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Se över frågeplaner och arbetsmängden. Överväg innodb_buffer_pool_size först efter att ha mätt tillgängligt minne på databasvärden; en kumulativ misskvot ensam bevisar inte minnesbrist."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Temporära tabeller på disk"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Se över frågeplaner, sortering, gruppering och datatyper för temporära tabeller innan du ändrar minnesgränser. Vissa tabeller måste använda disk; minnesgränser och redovisning skiljer sig åt mellan MySQL- och MariaDB-versioner."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Skapande av anslutningstrådar"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Se över återanvändning av anslutningar och thread_cache_size. Kontrollera serverns läge för trådhantering före justering; trådpoolsimplementeringar beter sig inte som servrar med en tråd per anslutning."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Se över loggning av långsamma frågor, long_query_time och frågeplaner innan du ändrar serverbuffertar. Denna räknare beror på den konfigurerade tröskeln för långsamma frågor och identifierar inte enskilda satser."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Långsamma satser"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Kumulativa råd skjuts upp tills observationsfönstret är tillräckligt."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "Råd om trådcachen utvärderas inte: thread_handling är inte tillgänglig eller är inte one-thread-per-connection. Granska den aktiva trådpoolsimplementeringen istället."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Nödvändiga räknare saknas eller är ogiltiga: %s, %s. Kontrollera stöd för serverversionen och övervakningsbehörigheter."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "En räknare återställdes sedan föregående stickprov; samla in ett nytt representativt intervall före justering."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Otillräcklig aktivitet: %.0f %s; minst %d observationer krävs för denna rådgivning."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Räknarna är inkonsekventa eller återställdes oberoende av varandra. Samla in ett nytt representativt stickprov före justering."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "Intervallstickprovet är för litet eller så återställdes räknarna; samla in ett nytt representativt intervall före justering."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Intervall %s / %s: %.0f / %.0f (%s); utredningströskel: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Kumulativt %s / %s: %.0f / %.0f (%s); utredningströskel: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Denna räknare kan utelämna minnesmappade temporära filer i MySQL; en låg kvot utesluter inte diskanvändning."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "Råd om redo-logg skjuts upp tills observationsfönstret är tillräckligt och Innodb_log_waits är tillgänglig."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Kumulativ Innodb_log_waits: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Undersök transaktionsstorlekar, tryck på loggbufferten och lagringslatens. Kontrollera frekvensen igen under belastning innan du överväger innodb_log_buffer_size; detta historiska antal är inte bevis på ett pågående stopp."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Väntan på InnoDB-loggbuffert"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "installerad Cacti composer.json"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "Installationskrav för Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "PHP-kompatibilitet med installerad Cacti"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Kör PHP %s; installerad Cacti %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Kunde inte fastställa Cactis PHP-krav. Kontrollera installerad Cacti composer.json eller versionsdokumentationen; Doctor antar inte kompatibilitet."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s och < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Kräver %s (%s). PHP-versionen som körs uppfyller detta krav."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Kräver %s (%s). PHP-versionen som körs uppfyller inte detta krav."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Upptäckte %s; Doctor kräver Cacti 1.2.20 eller senare."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Cacti-version som stöds"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Uppströms säkerhetsstöd för PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Detta kontrollerar PHP-utgivningsgrenen, inte om denna patchversion är uppdaterad eller om din OS-leverantör bakåtporterar korrigeringar. Cacti-kompatibilitet kontrolleras separat."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Kör PHP %s; status för uppströms säkerhetsstöd är okänd eller så är detta en förhandsversion. Kontrollera https://www.php.net/supported-versions.php och uppdatera Doctors stöddata."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Kör PHP %s; PHP %s får uppströms säkerhetskorrigeringar till och med %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Kör PHP %s; PHP %s får inte längre uppströms säkerhetskorrigeringar; stödet upphörde %s. Uppgradera till en PHP-gren som stöds och är kompatibel med din Cacti-installation, eller bekräfta säkerhetsunderhåll med din OS-leverantör."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Nödvändiga aktuella CLI PHP-tillägg"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Nödvändiga webb-PHP-tillägg"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Saknas: %s. Installera dem via operativsystemets pakethanterare."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Alla PHP-tillägg som krävs av Cacti-installeraren är inlästa i denna PHP-kontext."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "Doctor kör inte konfigurerade binärfiler när det körs som root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "Filnamnet %s är inte förväntat för %s, så Doctor körde den inte."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "Doctor körs som root, så behörighetskontroller beskriver root snarare än webbserver- eller pollerkontot, konfigurerade binärfiler körs inte och reparationer nekas. Kör Doctor som Cacti-polleranvändaren."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Doctor-behörigheter"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "Doctor körs utan root-behörigheter."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Nödvändiga CLI PHP-tillägg"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Den konfigurerade körbara PHP CLI-filen är otillgänglig, så dess tillägg kan inte kontrolleras."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "shell_exec() är inaktiverad, så Doctor kan inte jämföra CLI PHP-tilläggen med Cactis krav."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "Den konfigurerade körbara PHP CLI-filen returnerade inte någon giltig tilläggslista."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "Saknas i CLI PHP: %s. Webb- och CLI-konfigurationerna för PHP är separata på många system."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "Den konfigurerade PHP CLI-miljön har alla tillägg som krävs av Cacti."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "GD TrueType-stöd"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Rekommenderade PHP-funktioner"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Otillgängliga: %s. Cacti kan köras utan dessa funktioner, men relaterad funktionalitet kan vara begränsad."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "De valfria funktionerna gettext, SNMP och GD TrueType är tillgängliga."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "memory_limit är %s (%dM eller mer rekommenderas)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "max_execution_time är %d sekunder (60 eller mer rekommenderas)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "date.timezone är inte angiven"

#: doctor_functions.php
msgid "unset"
msgstr "ej angiven"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Aktuella värden: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "PHP-körtidskonfiguration"

#: doctor_functions.php
msgid "Database connection"
msgstr "Databasanslutning"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
msgstr "Frågan misslyckades: %s"

#: doctor_functions.php
msgid "A read-only query completed successfully."
msgstr "En skrivskyddad fråga slutfördes utan fel."

#: doctor_functions.php
msgid "The database returned an unexpected result."
msgstr "Databasen returnerade ett oväntat resultat."

#: doctor_functions.php
#, php-format
msgid "Doctor could not determine the database server version from %s."
msgstr "Doctor kunde inte fastställa databasserverns version från %s."

#: doctor_functions.php
msgid "Supported database server"
msgstr "Databasserver som stöds"

#: doctor_functions.php
#, php-format
msgid "%s %s detected; this Cacti branch recommends %s %s or newer."
msgstr "%s %s upptäcktes; denna Cacti-gren rekommenderar %s %s eller senare."

#: doctor_functions.php
#, php-format
msgid "Database character set is %s and collation is %s. Cacti requires utf8mb4."
msgstr "Databasens teckenuppsättning är %s och kollationeringen är %s. Cacti kräver utf8mb4."

#: doctor_functions.php
msgid "unknown"
msgstr "okänd"

#: doctor_functions.php
msgid "Database character set"
msgstr "Databasens teckenuppsättning"

#: doctor_functions.php
msgid "Database timezone support"
msgstr "Tidszonsstöd i databasen"

#: doctor_functions.php
msgid "The Cacti database account cannot read mysql.time_zone_name. Grant SELECT access and populate the database timezone tables."
msgstr "Cactis databaskonto kan inte läsa mysql.time_zone_name. Bevilja SELECT-åtkomst och fyll databasens tidszonstabeller."

#: doctor_functions.php
#, php-format
msgid "The database timezone table is accessible and contains %d entries."
msgstr "Databasens tidszonstabell är åtkomlig och innehåller %d poster."

#: doctor_functions.php
msgid "The database timezone table is accessible but empty. Populate the system timezone tables."
msgstr "Databasens tidszonstabell är åtkomlig men tom. Fyll systemets tidszonstabeller."

#: doctor_functions.php
msgid "Core tables used by Cacti are present."
msgstr "Grundläggande tabeller som används av Cacti finns."

#: doctor_functions.php
#, php-format
msgid "Missing core tables: %s. Restore or upgrade the database before attempting other repairs."
msgstr "Saknade grundläggande tabeller: %s. Återställ eller uppgradera databasen innan du försöker göra andra reparationer."

#: doctor_functions.php
msgid "Core database tables"
msgstr "Grundläggande databastabeller"

#: doctor_functions.php
#, php-format
msgid "%s is missing (%s)"
msgstr "%s saknas (%s)"

#: doctor_functions.php
#, php-format
msgid "%s is not writable (%s)"
msgstr "%s är inte skrivbar (%s)"

#: doctor_functions.php
msgid "Runtime directories"
msgstr "Körtidskataloger"

#: doctor_functions.php
msgid "The cache, log, and RRA directories exist and are writable."
msgstr "Katalogerna för cache, logg och RRA finns och är skrivbara."

#: doctor_functions.php
msgid "Cacti configuration file"
msgstr "Konfigurationsfil för Cacti"

#: doctor_functions.php
msgid "include/config.php is missing or unreadable."
msgstr "include/config.php saknas eller är oläsbar."

#: doctor_functions.php
msgid "include/config.php is readable. POSIX mode-bit checks do not apply on Windows."
msgstr "include/config.php är läsbar. Kontroller av POSIX-lägesbitar gäller inte på Windows."

#: doctor_functions.php
msgid "include/config.php is writable by other users. Remove world-write permission because this file contains database credentials."
msgstr "include/config.php är skrivbar av andra användare. Ta bort skrivbehörighet för alla eftersom denna fil innehåller databasuppgifter."

#: doctor_functions.php
msgid "include/config.php is group-writable. Confirm that every member of the owning group is trusted."
msgstr "include/config.php är gruppskrivbar. Bekräfta att alla medlemmar i den ägande gruppen är betrodda."

#: doctor_functions.php
msgid "include/config.php is readable by all local users and contains database credentials. Restrict it to the owner and the web server group."
msgstr "include/config.php är läsbar av alla lokala användare och innehåller databasuppgifter. Begränsa den till ägaren och webbservergruppen."

#: doctor_functions.php
msgid "include/config.php is readable and is not world-readable, group-writable, or world-writable."
msgstr "include/config.php är läsbar och är inte läsbar för alla, gruppskrivbar eller skrivbar för alla."

#: doctor_functions.php
msgid "Cacti log file"
msgstr "Cacti-loggfil"

#: doctor_functions.php
msgid "The log file does not exist. Its parent directory is not writable."
msgstr "Loggfilen finns inte. Dess överordnade katalog är inte skrivbar."

#: doctor_functions.php
msgid "The log file does not exist. Its parent directory is writable, so Cacti can create it."
msgstr "Loggfilen finns inte. Dess överordnade katalog är skrivbar, så Cacti kan skapa den."

#: doctor_functions.php
msgid "The configured log path must be a readable and writable regular file."
msgstr "Den konfigurerade loggsökvägen måste vara en läs- och skrivbar vanlig fil."

#: doctor_functions.php
#, php-format
msgid "The log is readable and writable and is %s MiB."
msgstr "Loggen är läs- och skrivbar och är %s MiB."

#: doctor_functions.php
