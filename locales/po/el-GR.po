#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Διαθέσιμες επιδιορθώσεις: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Άγνωστη μορφή %s. Χρησιμοποιήστε text, json, nagios ή prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Η απόκρυψη ευαίσθητων δεδομένων δεν ολοκληρώθηκε, επομένως το %s δεν γράφτηκε."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "Γράφτηκε το %s. Ελέγξτε το πριν το κοινοποιήσετε· οι τιμές μετά από ονόματα κωδικών πρόσβασης, μυστικών, διακριτικών (token) και community αποκρύπτονται."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Άγνωστη επιδιόρθωση"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Άρνηση επιδιόρθωσης χωρίς --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Επιλέξτε ένα υποστηριζόμενο σύμπτωμα και έξοδο κειμένου ή JSON."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Αποδεκτή προειδοποίηση"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Διαθεσιμότητα συσκευών"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Δεν ήταν δυνατή η αξιολόγηση των δικαιωμάτων συσκευών."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "Το ρυθμισμένο PHP CLI δεν μπορεί να εκτελέσει τους ελέγχους του Doctor."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Οι έλεγχοι του Doctor απέτυχαν ή υπερέβησαν το χρονικό τους όριο. Ελέγξτε το αρχείο καταγραφής του Doctor."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Τα γραφήματα σταμάτησαν να ενημερώνονται"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Η συλλογή (polling) είναι αργή"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Συσκευές λείπουν ή δεν είναι διαθέσιμες"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Λείπουν ειδοποιήσεις του Doctor"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Ελέγξτε τον χρονοπρογραμματιστή του poller και το αρχείο καταγραφής του επηρεαζόμενου poller και στη συνέχεια επιβεβαιώστε έναν νέο ολοκληρωμένο κύκλο."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "Η συλλογή δεδομένων ενδέχεται να έχει σταματήσει."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Οι συλλεγμένες τιμές ενδέχεται να μην φτάνουν στον δίσκο."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Ελέγξτε την ουρά εξόδου και το ιστορικό εκκένωσης του Boost· βεβαιωθείτε ότι η ουρά αδειάζει και οι χρονικές σημάνσεις RRD προχωρούν."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Ελέγξτε τη χωρητικότητα αποθήκευσης, τα δικαιώματα των καταλόγων εκτέλεσης και την τελευταία ενημέρωση RRD· λάβετε υπόψη τις αναβαλλόμενες εγγραφές."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "Η αποθήκευση RRD χρειάζεται διερεύνηση."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Η εργασία συλλογής ενδέχεται να υπερβαίνει το διαθέσιμο χρονικό περιθώριο."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Συγκρίνετε τη διάρκεια κύκλου με το διάστημα συλλογής και ελέγξτε τα χρονικά όρια απόκρισης συσκευών πριν αυξήσετε τον παραλληλισμό."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Συγκρίνετε τους μετρητές της βάσης δεδομένων κατά τη διάρκεια ενός αργού κύκλου και ελέγξτε τα πλάνα εκτέλεσης ερωτημάτων πριν αλλάξετε τα όρια του διακομιστή."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Ο φόρτος της βάσης δεδομένων ενδέχεται να συμβάλλει στην αργή συλλογή."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Οι προϋποθέσεις συλλογής ή η προσβασιμότητα ενδέχεται να αποτυγχάνουν."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Επαληθεύστε τα δικαιώματα, την προσβασιμότητα, τα διαπιστευτήρια και τον αντιστοιχισμένο poller της επηρεαζόμενης συσκευής χρησιμοποιώντας τα διαγνωστικά του Cacti."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Οι προγραμματισμένοι έλεγχοι ή η παράδοση ηλεκτρονικού ταχυδρομείου χρειάζονται προσοχή."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Επαληθεύστε τις ρυθμίσεις χρονοπρογραμματισμού και παραληπτών, ελέγξτε τις διατηρημένες προσπάθειες παράδοσης και στείλτε ένα δοκιμαστικό email από το Cacti."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Οι πιθανές αιτίες απαιτούν επαλήθευση· οι αντίστοιχοι έλεγχοι δεν αποδεικνύουν τη βασική αιτία."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Δεν προκύπτει καμία αιτία από τις διαθέσιμες παρατηρήσεις. Εκτελέστε νέα διαγνωστικά και διερευνήστε το σύμπτωμα απευθείας."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Τουλάχιστον 24 ώρες από την εκκίνηση του διακομιστή και το FLUSH STATUS. Οι μετρητές είναι αθροιστικοί και ενδέχεται να έχουν διαφορετικό ιστορικό επαναφοράς· επιβεβαιώστε τις τάσεις σε αντιπροσωπευτικό φόρτο εργασίας πριν από τη βελτιστοποίηση."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "Οι αθροιστικές συμβουλές βελτιστοποίησης αναβάλλονται: εξασφαλίστε έγκυρο χρόνο λειτουργίας και τουλάχιστον 24 ώρες από την εκκίνηση και το FLUSH STATUS. Ελλιπείς μετρήσεις ή ασυνεπές δείγμα δεν μπορούν να τεκμηριώσουν την υγεία της βάσης δεδομένων."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Παράθυρο παρατήρησης βάσης δεδομένων"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Οι μετρήσεις συνδέσεων δεν είναι διαθέσιμες ή δεν είναι έγκυρες. Ελέγξτε την πρόσβαση στα SHOW GLOBAL STATUS και SHOW GLOBAL VARIABLES· μην αντιμετωπίζετε τις ελλιπείς μετρήσεις ως αδρανή διακομιστή."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Τρέχουσες συνδέσεις: %.0f / %.0f (%s)· καταγεγραμμένη αιχμή: %.0f (%s του τρέχοντος ορίου)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Ελέγξτε τη συγκέντρωση συνδέσεων (connection pooling) και τον παραλληλισμό του poller. Ελέγξτε το διαθέσιμο περιθώριο μνήμης του διακομιστή βάσης δεδομένων πριν αυξήσετε το max_connections· η ιστορική αιχμή ενδέχεται να αντικατοπτρίζει παλαιότερο όριο."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Χωρητικότητα συνδέσεων"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Αναγνώσεις buffer pool του InnoDB"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Ελέγξτε τα πλάνα εκτέλεσης ερωτημάτων και το σύνολο εργασίας. Εξετάστε το innodb_buffer_pool_size μόνο αφού μετρήσετε τη διαθέσιμη μνήμη στον διακομιστή βάσης δεδομένων· ένα αθροιστικό ποσοστό αστοχιών από μόνο του δεν αποδεικνύει πίεση μνήμης."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Προσωρινοί πίνακες στον δίσκο"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Ελέγξτε τα πλάνα εκτέλεσης ερωτημάτων, την ταξινόμηση, την ομαδοποίηση και τους τύπους δεδομένων των προσωρινών πινάκων πριν αλλάξετε τα όρια μνήμης. Ορισμένοι πίνακες πρέπει να χρησιμοποιούν δίσκο· τα όρια μνήμης και η καταμέτρηση διαφέρουν μεταξύ εκδόσεων MySQL και MariaDB."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Δημιουργία νημάτων σύνδεσης"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Ελέγξτε την επαναχρησιμοποίηση συνδέσεων και το thread_cache_size. Ελέγξτε τη λειτουργία διαχείρισης νημάτων του διακομιστή πριν από τη βελτιστοποίηση· οι υλοποιήσεις thread-pool δεν συμπεριφέρονται όπως οι διακομιστές one-thread-per-connection."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Ελέγξτε την καταγραφή αργών ερωτημάτων, το long_query_time και τα πλάνα εκτέλεσης ερωτημάτων πριν αλλάξετε τα buffers του διακομιστή. Αυτός ο μετρητής εξαρτάται από το ρυθμισμένο όριο αργών ερωτημάτων και δεν προσδιορίζει μεμονωμένες εντολές."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Αργές εντολές"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "Οι αθροιστικές συμβουλές αναβάλλονται μέχρι το παράθυρο παρατήρησης να είναι επαρκές."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "Η συμβουλή για το thread-cache δεν αξιολογείται: το thread_handling δεν είναι διαθέσιμο ή δεν είναι one-thread-per-connection. Ελέγξτε αντ' αυτού την ενεργή υλοποίηση thread-pool."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Απαιτούμενοι μετρητές λείπουν ή δεν είναι έγκυροι: %s, %s. Ελέγξτε την υποστήριξη της έκδοσης διακομιστή και τα δικαιώματα παρακολούθησης."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "Ένας μετρητής επαναφέρθηκε από το προηγούμενο δείγμα· συλλέξτε ένα άλλο αντιπροσωπευτικό διάστημα πριν από τη βελτιστοποίηση."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Ανεπαρκής δραστηριότητα: %.0f %s· απαιτούνται τουλάχιστον %d παρατηρήσεις για αυτή τη σύσταση."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Οι μετρητές είναι ασυνεπείς ή επαναφέρθηκαν ανεξάρτητα. Συλλέξτε ένα νέο αντιπροσωπευτικό δείγμα πριν από τη βελτιστοποίηση."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "Το δείγμα διαστήματος είναι πολύ μικρό ή οι μετρητές επαναφέρθηκαν· συλλέξτε ένα άλλο αντιπροσωπευτικό διάστημα πριν από τη βελτιστοποίηση."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Διάστημα %s / %s: %.0f / %.0f (%s)· όριο διερεύνησης: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Αθροιστικά %s / %s: %.0f / %.0f (%s)· όριο διερεύνησης: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Αυτός ο μετρητής μπορεί να παραλείπει προσωρινά αρχεία με αντιστοίχιση μνήμης στη MySQL· ένα χαμηλό ποσοστό δεν αποκλείει τη χρήση δίσκου."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "Η συμβουλή για το redo-log αναβάλλεται μέχρι το παράθυρο παρατήρησης να είναι επαρκές και το Innodb_log_waits να είναι διαθέσιμο."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Αθροιστικό Innodb_log_waits: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Διερευνήστε τα μεγέθη συναλλαγών, την πίεση στο log buffer και την καθυστέρηση αποθήκευσης. Επανελέγξτε τον ρυθμό υπό φόρτο πριν εξετάσετε το innodb_log_buffer_size· αυτός ο ιστορικός αριθμός δεν αποτελεί απόδειξη τρέχουσας καθυστέρησης."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Αναμονές log-buffer του InnoDB"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "εγκατεστημένο composer.json του Cacti"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "απαίτηση προγράμματος εγκατάστασης Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "Συμβατότητα PHP με το εγκατεστημένο Cacti"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Εκτελείται PHP %s· εγκατεστημένο Cacti %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Δεν ήταν δυνατός ο προσδιορισμός της απαίτησης PHP του Cacti. Ελέγξτε το εγκατεστημένο composer.json του Cacti ή την τεκμηρίωση έκδοσης· το Doctor δεν υποθέτει συμβατότητα."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s και < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Απαιτεί %s (%s). Η εκτελούμενη PHP πληροί αυτή την απαίτηση."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Απαιτεί %s (%s). Η εκτελούμενη PHP δεν πληροί αυτή την απαίτηση."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Εντοπίστηκε %s· το Doctor απαιτεί Cacti 1.2.20 ή νεότερο."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Υποστηριζόμενη έκδοση Cacti"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Επίσημη υποστήριξη ασφαλείας PHP"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Αυτό ελέγχει τον κλάδο έκδοσης της PHP, όχι αν η συγκεκριμένη διορθωτική έκδοση είναι ενημερωμένη ή αν ο προμηθευτής του λειτουργικού σας συστήματος ενσωματώνει αναδρομικές διορθώσεις. Η συμβατότητα με το Cacti ελέγχεται ξεχωριστά."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Εκτελείται PHP %s· η κατάσταση επίσημης υποστήριξης ασφαλείας είναι άγνωστη ή πρόκειται για προέκδοση. Ελέγξτε τη διεύθυνση https://www.php.net/supported-versions.php και ενημερώστε τα δεδομένα υποστήριξης του Doctor."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Εκτελείται PHP %s· η PHP %s λαμβάνει επίσημες διορθώσεις ασφαλείας έως %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Εκτελείται PHP %s· η PHP %s δεν λαμβάνει πλέον επίσημες διορθώσεις ασφαλείας· η υποστήριξη έληξε στις %s. Αναβαθμίστε σε έναν υποστηριζόμενο κλάδο PHP συμβατό με την εγκατάσταση Cacti σας ή επιβεβαιώστε τη συντήρηση ασφαλείας με τον προμηθευτή του λειτουργικού σας συστήματος."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Απαιτούμενες επεκτάσεις της τρέχουσας CLI PHP"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Απαιτούμενες επεκτάσεις της web PHP"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Λείπουν: %s. Εγκαταστήστε τις μέσω του διαχειριστή πακέτων του λειτουργικού συστήματος."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "Όλες οι επεκτάσεις PHP που απαιτούνται από το πρόγραμμα εγκατάστασης του Cacti είναι φορτωμένες σε αυτό το περιβάλλον PHP."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "Το Doctor δεν εκτελεί ρυθμισμένα εκτελέσιμα αρχεία όταν εκτελείται ως root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "Το όνομα αρχείου %s δεν είναι το αναμενόμενο για %s, επομένως το Doctor δεν το εκτέλεσε."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "Το Doctor εκτελείται ως root, επομένως οι έλεγχοι δικαιωμάτων περιγράφουν τον root αντί για τον λογαριασμό του διακομιστή ιστού ή του poller, τα ρυθμισμένα εκτελέσιμα δεν εκτελούνται και οι επιδιορθώσεις απορρίπτονται. Εκτελέστε το Doctor ως ο χρήστης του poller του Cacti."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Δικαιώματα Doctor"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "Το Doctor εκτελείται χωρίς δικαιώματα root."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Απαιτούμενες επεκτάσεις CLI PHP"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Το ρυθμισμένο εκτελέσιμο PHP CLI δεν είναι διαθέσιμο, επομένως δεν μπορούν να ελεγχθούν οι επεκτάσεις του."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
