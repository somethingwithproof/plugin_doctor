#: cli/doctor.php
#, php-format
msgid "Available repairs: %s"
msgstr "Ndozi dịnụ: %s"

#: cli/doctor.php
#, php-format
msgid "Unknown format %s. Use text, json, nagios, or prometheus."
msgstr "Ụdị a na-amaghị %s. Jiri text, json, nagios, ma ọ bụ prometheus."

#: cli/doctor.php
#, php-format
msgid "Redaction could not complete, so %s was not written."
msgstr "Nhicha nzuzo enweghị ike ịgwụ, ya mere edeghị %s."

#: cli/doctor.php
#, php-format
msgid "Wrote %s. Review it before sharing; values after password, secret, token, and community names are masked."
msgstr "Edere %s. Nyochaa ya tupu ị kesaa ya; e kpuchiri ọnụọgụgụ ndị na-esote password, secret, token, na community names."

#: cli/doctor.php doctor_functions.php
msgid "Unknown repair"
msgstr "Ndozi a na-amaghị"

#: cli/doctor.php
msgid "Refusing to repair without --yes."
msgstr "Ajụrụ ime ndozi na-enweghị --yes."

#: cli/doctor.php
msgid "Select a supported symptom and text or JSON output."
msgstr "Họrọ mgbaàmà a na-akwado na mpụta text ma ọ bụ JSON."

#: cli/doctor.php doctor_web.php
msgid "Accepted warning"
msgstr "Anabatara ịdọ aka ná ntị"

#: doctor_access.php doctor_functions.php
msgid "Device availability"
msgstr "Ọnọdụ nnweta ngwaọrụ"

#: doctor_access.php
msgid "Device permissions could not be evaluated."
msgstr "Enweghị ike ịnwale ikike ngwaọrụ."

#: doctor_access.php
msgid "The configured PHP CLI cannot run Doctor checks."
msgstr "PHP CLI a haziri enweghị ike ịgba nyocha Doctor."

#: doctor_access.php
msgid "Doctor checks failed or exceeded their time limit. Review the Doctor log."
msgstr "Nyocha Doctor dara ma ọ bụ gafee oke oge ha. Nyochaa ndekọ Doctor."

#: doctor_diagnosis.php
msgid "Graphs stopped updating"
msgstr "Eserese kwụsịrị imelite"

#: doctor_diagnosis.php
msgid "Polling is slow"
msgstr "Nchịkọta data dị nwayọọ"

#: doctor_diagnosis.php
msgid "Devices are missing or unavailable"
msgstr "Ngwaọrụ na-efu ma ọ bụ anaghị enweta ha"

#: doctor_diagnosis.php
msgid "Doctor alerts are missing"
msgstr "Ọkwa Doctor adịghị"

#: doctor_diagnosis.php
msgid "Check the poller scheduler and the affected poller log, then verify a new completed cycle."
msgstr "Lelee onye nhazi oge poller na ndekọ poller metụtara, wee kwado usoro ọhụrụ e mechara."

#: doctor_diagnosis.php
msgid "Collection may have stopped."
msgstr "Nchịkọta nwere ike ịkwụsịla."

#: doctor_diagnosis.php
msgid "Collected values may not be reaching disk."
msgstr "Ụkpụrụ ndị anakọtara nwere ike ọ gaghị erute na diskị."

#: doctor_diagnosis.php
msgid "Inspect the output queue and Boost flush history; verify that the queue drains and RRD timestamps advance."
msgstr "Nyochaa kwụụ mmepụta na akụkọ ihe mere eme nkpochapụ Boost; kwado na kwụụ ahụ na-agwụ ma akara oge RRD na-aga n'ihu."

#: doctor_diagnosis.php
msgid "Check storage capacity, runtime-directory permissions and the last RRD update; account for deferred writes."
msgstr "Lelee ikike ebe nchekwa, ikike folda oge ịrụ ọrụ na mmelite RRD ikpeazụ; tụlee ide ihe ndị e yigharịrị."

#: doctor_diagnosis.php
msgid "RRD storage needs investigation."
msgstr "Ebe nchekwa RRD chọrọ nnyocha."

#: doctor_diagnosis.php
msgid "Collection work may be exceeding its time budget."
msgstr "Ọrụ nchịkọta nwere ike ịgabiga oke oge e wepụtara maka ya."

#: doctor_diagnosis.php
msgid "Compare cycle duration with the polling interval and inspect device timeouts before increasing concurrency."
msgstr "Tụnyere ogologo oge usoro na oge etiti polling ma nyochaa oge nkwụsị ngwaọrụ tupu ịbawanye ọrụ n'otu oge."

#: doctor_diagnosis.php
msgid "Compare database counters during a slow cycle and inspect query plans before changing server limits."
msgstr "Tụnyere kaụnta nchekwa data n'oge usoro dị nwayọọ ma nyochaa atụmatụ ajụjụ tupu ịgbanwee oke sava."

#: doctor_diagnosis.php
msgid "Database pressure may be contributing to slow polling."
msgstr "Nrụgide nchekwa data nwere ike na-enye aka na polling dị nwayọọ."

#: doctor_diagnosis.php
msgid "Collection prerequisites or reachability may be failing."
msgstr "Ihe ndị dị mkpa maka nchịkọta ma ọ bụ iru ngwaọrụ nwere ike na-ada."

#: doctor_diagnosis.php
msgid "Verify the affected device permissions, reachability, credentials and assigned poller using Cacti diagnostics."
msgstr "Kwado ikike ngwaọrụ metụtara, iru ya, nzere na poller e kenyere ya site na iji nyocha nsogbu Cacti."

#: doctor_diagnosis.php
msgid "Scheduled checks or mail delivery need attention."
msgstr "Nnyocha ndị e zubere n'oge ma ọ bụ nnyefe ozi-e chọrọ nlebara anya."

#: doctor_diagnosis.php
msgid "Verify scheduling and recipient settings, inspect retained delivery attempts, and send a Cacti test email."
msgstr "Kwado ntọala nhazi oge na ndị nnata, nyochaa mgbalị nnyefe ndị e debere, ma zipu ozi-e nnwale Cacti."

#: doctor_diagnosis.php
msgid "Possible causes require verification; matching checks do not establish a root cause."
msgstr "Ihe ndị nwere ike ịkpata ya chọrọ nkwenye; nnyocha ndị dakọtara anaghị egosipụta isi ihe kpatara ya."

#: doctor_diagnosis.php
msgid "No cause is established by the available observations. Run fresh diagnostics and investigate the symptom directly."
msgstr "Ọ dịghị ihe kpatara ya gosipụtara site na nleba anya dịnụ. Mee nyocha nsogbu ọhụrụ ma nyochaa mgbaàmà ahụ ozugbo."

#: doctor_functions.php
msgid "At least 24 hours since server startup and FLUSH STATUS. Counters are cumulative and may have different reset histories; confirm trends during a representative workload before tuning."
msgstr "Opekempe awa 24 kemgbe mmalite sava na FLUSH STATUS. Kaụnta na-agbakọta ọnụ ma nwee ike ịnwe akụkọ ihe mere eme ntọgharị dị iche iche; kwado usoro n'oge ibu ọrụ nnọchiteanya tupu ịhazigharị."

#: doctor_functions.php
msgid "Cumulative tuning advice is deferred: obtain valid uptime and at least 24 hours since startup and FLUSH STATUS. Missing metrics or an inconsistent sample cannot establish database health."
msgstr "E yigharịrị ndụmọdụ nhazigharị mkpokọta: nweta oge ịrụ ọrụ ziri ezi na opekempe awa 24 kemgbe mmalite na FLUSH STATUS. Nleba anya na-efu efu ma ọ bụ ihe nlele na-ekwekọghị ekwekọ enweghị ike igosipụta ahụike nchekwa data."

#: doctor_functions.php
msgid "Database observation window"
msgstr "Oge nleba anya nchekwa data"

#: doctor_functions.php
msgid "Connection metrics are unavailable or invalid. Check access to SHOW GLOBAL STATUS and SHOW GLOBAL VARIABLES; do not treat missing metrics as an idle server."
msgstr "Nleba anya njikọ adịghị ma ọ bụ adịghị mma. Lelee ohere ịnweta SHOW GLOBAL STATUS na SHOW GLOBAL VARIABLES; ewerekwala nleba anya na-efu efu dị ka sava na-anọghị n'ọrụ."

#: doctor_functions.php
#, php-format
msgid "Current connections: %.0f / %.0f (%s); recorded peak: %.0f (%s of the current limit)."
msgstr "Njikọ dị ugbu a: %.0f / %.0f (%s); ọnụọgụ kachasị elu e dekọrọ: %.0f (%s nke oke dị ugbu a)."

#: doctor_functions.php
msgid "Review connection pooling and poller concurrency. Check database-host memory headroom before raising max_connections; the historical peak may reflect an older limit."
msgstr "Nyochaa njikọta njikọ na ọrụ poller n'otu oge. Lelee ohere memọrị dị na sava nchekwa data tupu ịbawanye max_connections; ọnụọgụ kachasị elu nke akụkọ ihe mere eme nwere ike igosipụta oke ochie."

#: doctor_functions.php
msgid "Connection capacity"
msgstr "Ikike njikọ"

#: doctor_functions.php
msgid "InnoDB buffer pool reads"
msgstr "Ọgụgụ ọdọ bọfa InnoDB"

#: doctor_functions.php
msgid "Review query plans and the working set. Consider innodb_buffer_pool_size only after measuring memory available on the database host; a cumulative miss ratio alone does not prove memory pressure."
msgstr "Nyochaa atụmatụ ajụjụ na usoro data na-arụ ọrụ. Tụlee innodb_buffer_pool_size naanị mgbe ị tụsịrị memọrị dị na sava nchekwa data; oke mfu mkpokọta naanị anaghị egosi nrụgide memọrị."

#: doctor_functions.php
msgid "On-disk temporary tables"
msgstr "Tebụl nwa oge dị na diskị"

#: doctor_functions.php
msgid "Review query plans, sorting, grouping, and temporary-table data types before changing memory limits. Some tables must use disk; memory limits and accounting differ between MySQL and MariaDB versions."
msgstr "Nyochaa atụmatụ ajụjụ, nhazi, nchịkọta, na ụdị data tebụl nwa oge tupu ịgbanwee oke memọrị. Ụfọdụ tebụl ga-ejirịrị diskị; oke memọrị na ngụkọ dị iche n'etiti ụdị MySQL na MariaDB."

#: doctor_functions.php
msgid "Connection thread creation"
msgstr "Mmepụta tredị njikọ"

#: doctor_functions.php
msgid "Review connection reuse and thread_cache_size. Check the server thread-handling mode before tuning; thread-pool implementations do not behave like one-thread-per-connection servers."
msgstr "Nyochaa ijigharị njikọ na thread_cache_size. Lelee ọnọdụ njikwa tredị sava tupu ịhazigharị; mmejuputa ọdọ tredị anaghị eme ka sava nwere otu tredị maka otu njikọ."

#: doctor_functions.php
msgid "Review slow-query logging, long_query_time, and query plans before changing server buffers. This counter depends on the configured slow-query threshold and does not identify individual statements."
msgstr "Nyochaa ndekọ ajụjụ dị nwayọọ, long_query_time, na atụmatụ ajụjụ tupu ịgbanwee bọfa sava. Kaụnta a dabere na oke ajụjụ dị nwayọọ ahaziri ma ọ naghị amata nkwupụta dị iche iche."

#: doctor_functions.php
msgid "Slow statements"
msgstr "Nkwupụta dị nwayọọ"

#: doctor_functions.php
msgid "Cumulative advice deferred until the observation window is sufficient."
msgstr "E yigharịrị ndụmọdụ mkpokọta ruo mgbe oge nleba anya zuru oke."

#: doctor_functions.php
msgid "Thread-cache advice is not assessed: thread_handling is unavailable or is not one-thread-per-connection. Review the active thread-pool implementation instead."
msgstr "A tụleghị ndụmọdụ kashị tredị: thread_handling adịghị ma ọ bụ abụghị otu tredị maka otu njikọ. Nyochaa mmejuputa ọdọ tredị na-arụ ọrụ kama."

#: doctor_functions.php
#, php-format
msgid "Required counters are missing or invalid: %s, %s. Check server-version support and monitoring permissions."
msgstr "Kaụnta ndị dị mkpa efuola ma ọ bụ adịghị mma: %s, %s. Lelee nkwado ụdị sava na ikike nlekota."

#: doctor_functions.php
msgid "A counter reset since the prior sample; collect another representative interval before tuning."
msgstr "Otu kaụnta tọgharịrị kemgbe ihe nlele gara aga; chịkọta oge etiti nnọchiteanya ọzọ tupu ịhazigharị."

#: doctor_functions.php
#, php-format
msgid "Insufficient activity: %.0f %s; at least %d observations are needed for this advisory."
msgstr "Ọrụ ezughị oke: %.0f %s; opekempe nleba anya %d dị mkpa maka ndụmọdụ a."

#: doctor_functions.php
msgid "Counters are inconsistent or were reset independently. Collect a new representative sample before tuning."
msgstr "Kaụnta ekwekọghị ekwekọ ma ọ bụ e tọgharịrị ha iche iche. Chịkọta ihe nlele nnọchiteanya ọhụrụ tupu ịhazigharị."

#: doctor_functions.php
msgid "The interval sample is too small or counters reset; collect another representative interval before tuning."
msgstr "Ihe nlele oge etiti dị ntakịrị ma ọ bụ kaụnta tọgharịrị; chịkọta oge etiti nnọchiteanya ọzọ tupu ịhazigharị."

#: doctor_functions.php
#, php-format
msgid "Interval %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Oge etiti %s / %s: %.0f / %.0f (%s); oke nnyocha: %s."

#: doctor_functions.php
#, php-format
msgid "Cumulative %s / %s: %.0f / %.0f (%s); investigation threshold: %s."
msgstr "Mkpokọta %s / %s: %.0f / %.0f (%s); oke nnyocha: %s."

#: doctor_functions.php
msgid "This counter can omit memory-mapped temporary files on MySQL; a low ratio does not rule out disk use."
msgstr "Kaụnta a nwere ike ịhapụ faịlụ nwa oge e kenyere memọrị na MySQL; oke dị ala anaghị ewepụ ojiji diskị."

#: doctor_functions.php
msgid "Redo-log advice deferred until the observation window is sufficient and Innodb_log_waits is available."
msgstr "E yigharịrị ndụmọdụ ndekọ redo ruo mgbe oge nleba anya zuru oke ma Innodb_log_waits dị."

#: doctor_functions.php
#, php-format
msgid "Cumulative Innodb_log_waits: %.0f."
msgstr "Mkpokọta Innodb_log_waits: %.0f."

#: doctor_functions.php
msgid "Investigate transaction sizes, log-buffer pressure, and storage latency. Recheck the rate under load before considering innodb_log_buffer_size; this historical count is not evidence of a current stall."
msgstr "Nyochaa nha azụmahịa, nrụgide bọfa ndekọ, na egbu oge ebe nchekwa. Lelee ọnụego ahụ ọzọ n'okpuru ibu ọrụ tupu ịtụlee innodb_log_buffer_size; ọnụọgụ akụkọ ihe mere eme a abụghị ihe akaebe nke nkwụsị dị ugbu a."

#: doctor_functions.php
msgid "InnoDB log-buffer waits"
msgstr "Nche bọfa ndekọ InnoDB"

#: doctor_functions.php
msgid "installed Cacti composer.json"
msgstr "composer.json Cacti e tinyere"

#: doctor_functions.php
#, php-format
msgid "Cacti %s installer requirement"
msgstr "Ihe achọrọ nke onye nrụnye Cacti %s"

#: doctor_functions.php
msgid "PHP compatibility with installed Cacti"
msgstr "Ndakọrịta PHP na Cacti e tinyere"

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; installed Cacti %s."
msgstr "Na-agba PHP %s; Cacti e tinyere %s."

#: doctor_functions.php
msgid "Could not establish Cacti's PHP requirement. Check the installed Cacti composer.json or release documentation; Doctor does not assume compatibility."
msgstr "Enweghị ike ịchọpụta ihe achọrọ PHP nke Cacti. Lelee composer.json Cacti e tinyere ma ọ bụ akwụkwọ ntọhapụ; Doctor anaghị eche na ha dakọtara."

#: doctor_functions.php
#, php-format
msgid "PHP >= %s and < %s"
msgstr "PHP >= %s na < %s"

#: doctor_functions.php
#, php-format
msgid "PHP >= %s"
msgstr "PHP >= %s"

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP meets that requirement."
msgstr "Chọrọ %s (%s). PHP na-agba ugbu a mezuru ihe achọrọ ahụ."

#: doctor_functions.php
#, php-format
msgid "Requires %s (%s). Running PHP does not meet that requirement."
msgstr "Chọrọ %s (%s). PHP na-agba ugbu a emezughị ihe achọrọ ahụ."

#: doctor_functions.php
#, php-format
msgid "Detected %s; Doctor requires Cacti 1.2.20 or newer."
msgstr "Achọpụtara %s; Doctor chọrọ Cacti 1.2.20 ma ọ bụ nke dị ọhụrụ karịa."

#: doctor_functions.php
msgid "Supported Cacti version"
msgstr "Ụdị Cacti akwadoro"

#: doctor_functions.php
msgid "PHP upstream security support"
msgstr "Nkwado nchekwa PHP sitere na isi mmalite"

#: doctor_functions.php
msgid "This checks the PHP release branch, not whether this patch release is up to date or whether your OS vendor backports fixes. Cacti compatibility is checked separately."
msgstr "Nke a na-elele alaka ntọhapụ PHP, ọ bụghị ma ntọhapụ mmezi a dị ọhụrụ ma ọ bụ ma onye na-ere OS gị na-eweghachi mmezi ochie. A na-elele ndakọrịta Cacti iche."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; upstream security-support status is unknown or this is a prerelease. Check https://www.php.net/supported-versions.php and update Doctor's support data."
msgstr "Na-agba PHP %s; amaghị ọnọdụ nkwado nchekwa sitere na isi mmalite ma ọ bụ nke a bụ ntọhapụ tupu oge. Lelee https://www.php.net/supported-versions.php ma melite data nkwado Doctor."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s receives upstream security fixes through %s."
msgstr "Na-agba PHP %s; PHP %s na-enweta mmezi nchekwa sitere na isi mmalite ruo %s."

#: doctor_functions.php
#, php-format
msgid "Running PHP %s; PHP %s no longer receives upstream security fixes; support ended %s. Upgrade to a supported PHP branch compatible with your Cacti installation, or confirm security maintenance with your OS vendor."
msgstr "Na-agba PHP %s; PHP %s anaghịzi enweta mmezi nchekwa sitere na isi mmalite; nkwado kwụsịrị na %s. Kwalite gaa na alaka PHP akwadoro nke dakọtara na nrụnye Cacti gị, ma ọ bụ kwado nlekọta nchekwa na onye na-ere OS gị."

#: doctor_functions.php
msgid "Required current CLI PHP extensions"
msgstr "Mgbakwunye CLI PHP dị ugbu a achọrọ"

#: doctor_functions.php
msgid "Required web PHP extensions"
msgstr "Mgbakwunye webụ PHP achọrọ"

#: doctor_functions.php
#, php-format
msgid "Missing: %s. Install them through the operating system package manager."
msgstr "Ndị na-efu: %s. Tinye ha site na njikwa ngwugwu sistemụ arụmọrụ."

#: doctor_functions.php
msgid "All PHP extensions required by the Cacti installer are loaded in this PHP context."
msgstr "E tinyere mgbakwunye PHP niile onye nrụnye Cacti chọrọ na gburugburu PHP a."

#: doctor_functions.php
msgid "Doctor does not execute configured binaries while running as root."
msgstr "Doctor anaghị agba faịlụ mmezu ahaziri mgbe ọ na-agba dị ka root."

#: doctor_functions.php
#, php-format
msgid "The file name %s is not expected for %s, so Doctor did not execute it."
msgstr "Aha faịlụ %s abụghị nke a tụrụ anya ya maka %s, ya mere Doctor agbaghị ya."

#: doctor_functions.php
msgid "Doctor is running as root, so permission checks describe root rather than the web server or poller account, configured binaries are not executed, and repairs are refused. Run Doctor as the Cacti poller user."
msgstr "Doctor na-agba dị ka root, ya mere nnyocha ikike na-akọwa root kama sava webụ ma ọ bụ akaụntụ poller, anaghị agba faịlụ mmezu ahaziri, ma a jụrụ ndozi. Gbaa Doctor dị ka onye ọrụ poller Cacti."

#: doctor_functions.php
msgid "Doctor privileges"
msgstr "Ikike Doctor"

#: doctor_functions.php
msgid "Doctor is running without root privileges."
msgstr "Doctor na-agba n'enweghị ikike root."

#: doctor_functions.php
msgid "Required CLI PHP extensions"
msgstr "Mgbakwunye CLI PHP achọrọ"

#: doctor_functions.php
msgid "The configured PHP CLI executable is unavailable, so its extensions cannot be checked."
msgstr "Faịlụ mmezu PHP CLI ahaziri adịghị, ya mere enweghị ike ịlele mgbakwunye ya."

#: doctor_functions.php
msgid "shell_exec() is disabled, so Doctor cannot compare the CLI PHP extensions with Cacti requirements."
msgstr "Agbanyụrụ shell_exec(), ya mere Doctor enweghị ike ịtụnyere mgbakwunye CLI PHP na ihe Cacti chọrọ."

#: doctor_functions.php
msgid "The configured PHP CLI executable did not return a valid extension list."
msgstr "Faịlụ mmezu PHP CLI ahaziri eweghachighị ndepụta mgbakwunye ziri ezi."

#: doctor_functions.php
#, php-format
msgid "Missing from CLI PHP: %s. The web and CLI PHP configurations are separate on many systems."
msgstr "Ndị na-efu na CLI PHP: %s. Ntọala webụ na CLI PHP dị iche iche n'ọtụtụ sistemụ."

#: doctor_functions.php
msgid "The configured PHP CLI has every extension required by Cacti."
msgstr "PHP CLI ahaziri nwere mgbakwunye ọ bụla Cacti chọrọ."

#: doctor_functions.php
msgid "GD TrueType support"
msgstr "Nkwado GD TrueType"

#: doctor_functions.php
msgid "Recommended PHP features"
msgstr "Atụmatụ PHP akwadoro"

#: doctor_functions.php
#, php-format
msgid "Unavailable: %s. Cacti can run without these features, but related functionality may be limited."
msgstr "Ndị adịghị: %s. Cacti nwere ike ịgba n'enweghị atụmatụ ndị a, mana ọrụ ndị metụtara ha nwere ike ịdị oke."

#: doctor_functions.php
msgid "The optional gettext, SNMP, and GD TrueType features are available."
msgstr "Atụmatụ nhọrọ gettext, SNMP, na GD TrueType dị."

#: doctor_functions.php
#, php-format
msgid "memory_limit is %s (%dM or more is recommended)"
msgstr "memory_limit bụ %s (akwadoro %dM ma ọ bụ karịa)"

#: doctor_functions.php
#, php-format
msgid "max_execution_time is %d seconds (60 or more is recommended)"
msgstr "max_execution_time bụ sekọnd %d (akwadoro 60 ma ọ bụ karịa)"

#: doctor_functions.php
msgid "date.timezone is not set"
msgstr "etọghị date.timezone"

#: doctor_functions.php
msgid "unset"
msgstr "atọghị ya"

#: doctor_functions.php
#, php-format
msgid "%s. Current values: %s"
msgstr "%s. Ụkpụrụ dị ugbu a: %s"

#: doctor_functions.php
msgid "PHP runtime configuration"
msgstr "Ntọala oge ịrụ ọrụ PHP"

#: doctor_functions.php
msgid "Database connection"
msgstr "Njikọ nchekwa data"

#: doctor_functions.php
#, php-format
msgid "Query failed: %s"
