            <file>doctor_diagnosis.php</file>
            <file>doctor_functions.php</file>
            <file>doctor_plugins.php</file>
            <file>doctor_rrd.php</file>
            <file>doctor_scheduling.php</file>
            <file>doctor_workflows.php</file>
        </include>
    </source>
</phpunit>
